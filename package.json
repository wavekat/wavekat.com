{
  "name": "wavekat-com",
  "type": "module",
  "version": "0.0.44",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-brand.js",
    "sync:docs": "node scripts/sync-docs.js",
    "sync:screenshots": "node scripts/sync-screenshots.js",
    "check:screenshots": "node scripts/sync-screenshots.js --check",
    "check:links": "node scripts/check-links.js",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && SYNC_DOCS=1 npm run sync:docs && astro build && node scripts/flatten-404s.js",
    "preview": "astro preview",
    "cf:build": "npm run build",
    "cf:deploy": "wrangler pages deploy ./dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@lucide/astro": "^1.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.8",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "image-size": "^2.0.2",
    "wrangler": "^4.47.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
