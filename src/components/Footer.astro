---
import { execSync } from 'child_process';
import { Mail, ArrowUpRight } from '@lucide/astro';
import { version } from '../../package.json';
import { resolveLocale, localesForPath, localizedPath, t } from '../lib/i18n';

const { code: lang } = resolveLocale(Astro.url.pathname);
const ui = t(lang);
const localeHref = (path: string) =>
  localesForPath(path).includes(lang) ? localizedPath(path, lang) : path;

// Three columns: the WaveKat Voice desktop app, the hosted tools, then
// everything sitewide. Tools links straight to the live app rather than to a
// marketing page — someone reaching for it in the footer wants the tool, not a
// description of it — and is a separate group because it's a different product
// from the Voice desktop app.
const groups = [
  {
    heading: 'WaveKat Voice', // brand name — never translated
    links: [
      { href: localeHref('/voice/'), label: ui.subOverview },
      { href: localeHref('/voice/alternatives/'), label: ui.subAlternatives },
      { href: localeHref('/voice/download/'), label: ui.subDownload },
      { href: localeHref('/voice/changelog/'), label: ui.subChangelog },
    ],
  },
  {
    heading: ui.footerTools,
    links: [
      {
        href: 'https://platform.wavekat.com/voice/prompts',
        label: ui.footerPrompts,
        external: true,
      },
    ],
  },
  {
    heading: ui.footerMore,
    links: [
      { href: localeHref('/blog/'), label: ui.navBlog },
      { href: localeHref('/about/'), label: ui.footerAbout },
      // Reachable from every page in every locale, translated or not: a privacy
      // policy nobody can find isn't one. Locales without their own translation
      // yet fall through to the English page via localeHref.
      { href: localeHref('/privacy/'), label: ui.footerPrivacy },
      // English-only, deliberately: the wallpaper page itself isn't translated,
      // so it's offered where the reader is already reading English rather than
      // pointing a localized footer at an English destination. That also keeps
      // it from costing a ninth translation of a label for a brand extra.
      ...(lang === 'en' ? [{ href: '/brand/wallpaper/', label: 'Wallpaper' }] : []),
    ],
  },
];

let siteVersion: string;
try {
  siteVersion = execSync('git describe --tags --abbrev=0', { encoding: 'utf8' }).trim();
} catch {
  siteVersion = `v${version}`;
}
---

<footer
  class="mt-20 border-t border-gray-100 bg-gray-50/60 dark:border-white/10 dark:bg-wk-surface/40"
  data-footer
>
  <div class="mx-auto max-w-6xl px-6 pt-12">
  <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col gap-4">
      <a href={localizedPath('/', lang)} class="block w-fit">
        <img src="/logos/wavekat-tight-light.svg" alt="wavekat" width="97" height="28" class="h-7 dark:hidden" />
        <img src="/logos/wavekat-tight-dark.svg" alt="wavekat" width="97" height="28" class="h-7 hidden dark:block" />
      </a>
      <div class="flex items-center gap-1 text-gray-400 dark:text-gray-500">
        <a
          href="https://github.com/wavekat"
          target="_blank"
          rel="noopener noreferrer"
          title="GitHub"
          class="rounded-full p-2 transition-colors hover:bg-gray-900/5 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          <span class="sr-only">GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/company/wavekat/"
          target="_blank"
          rel="noopener noreferrer"
          title="LinkedIn"
          class="rounded-full p-2 transition-colors hover:bg-gray-900/5 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          <span class="sr-only">LinkedIn</span>
        </a>
        <a
          href="mailto:eason@wavekat.com"
          title={ui.footerEmail}
          class="rounded-full p-2 transition-colors hover:bg-gray-900/5 hover:text-gray-700 dark:hover:bg-white/5 dark:hover:text-gray-300"
        >
          <Mail class="w-5 h-5" />
          <span class="sr-only">{ui.footerEmail}</span>
        </a>
      </div>
    </div>
    <!-- Auto-width groups hugging the right edge, not stretched grid tracks —
         equal columns spread a one-item group miles from its neighbours. -->
    <nav class="flex flex-wrap gap-x-12 gap-y-8 sm:justify-end sm:text-right">
      {groups.map((group) => (
        <div class="flex flex-col gap-2.5">
          <span
            class="font-mono text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-600"
            >{group.heading}</span
          >
          {group.links.map((link) =>
            link.external ? (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white sm:justify-end"
              >
                {link.label}
                <ArrowUpRight class="h-3.5 w-3.5 shrink-0 opacity-60" aria-hidden="true" />
              </a>
            ) : (
              <a
                href={link.href}
                class="text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white"
              >
                {link.label}
              </a>
            )
          )}
        </div>
      ))}
    </nav>
  </div>
  <div class="mt-10 flex items-center justify-between border-t border-gray-100 py-5 text-xs text-gray-400 dark:border-white/10 dark:text-gray-600">
    <span>© {new Date().getFullYear()} WaveKat</span>
    <a
      href="https://github.com/wavekat/wavekat.com"
      target="_blank"
      rel="noopener noreferrer"
      title={ui.footerSource}
      class="font-mono transition-colors hover:text-gray-600 dark:hover:text-gray-400"
    >
      {siteVersion}
    </a>
  </div>
  </div>
  <!-- Giant watermark wordmark peeking from the bottom edge — pure brand, no
       copy. It's the only thing the pointer affects: moving through the footer
       lights the letterforms in a soft circle around the cursor. -->
  <div class="relative mx-auto h-16 max-w-6xl overflow-hidden px-6 sm:h-24 md:h-32" data-wm aria-hidden="true">
    <img src="/logos/wavekat-tight-light.svg" alt="" class="absolute top-2 left-6 right-6 w-[calc(100%-3rem)] opacity-[0.06] dark:hidden" loading="lazy" />
    <img src="/logos/wavekat-tight-dark.svg" alt="" class="absolute top-2 left-6 right-6 hidden w-[calc(100%-3rem)] opacity-[0.05] dark:block" loading="lazy" />
    <span class="wm-lit" aria-hidden="true"><span class="wm-glyph"></span></span>
  </div>
</footer>

<style>
  /* The watermark's lit state, revealed in a soft circle around the pointer —
     a spotlight, not a hover swap. Nested masks: this layer is masked by the
     cursor circle, the glyph inside it by the wordmark.

     The radius is larger than the watermark strip is tall, so the pointer
     reaches it from the rows just above — you don't have to hover the wordmark
     itself for it to respond. */
  .wm-lit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 350ms ease;
    -webkit-mask-image: radial-gradient(
      256px circle at var(--wx, 50%) var(--wy, 50%),
      #000 9%,
      transparent 80%
    );
    mask-image: radial-gradient(
      256px circle at var(--wx, 50%) var(--wy, 50%),
      #000 9%,
      transparent 80%
    );
  }

  :global(.is-lit) .wm-lit {
    opacity: 1;
  }

  /* Positioned to match the <img> above it exactly. aspect-ratio stands in for
     the image's intrinsic height so the mask crops identically. Flat colour —
     no drop-shadow, no glow; the only thing that reads is the letterform
     itself, brightened where the cursor is. */
  .wm-glyph {
    position: absolute;
    top: 0.5rem;
    left: 1.5rem;
    width: calc(100% - 3rem);
    aspect-ratio: 184 / 53;
    background: #ff6d00;
    opacity: 0.42;
    -webkit-mask-image: url('/logos/wavekat-tight-light.svg');
    mask-image: url('/logos/wavekat-tight-light.svg');
    -webkit-mask-size: 100% auto;
    mask-size: 100% auto;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  :global(.dark) .wm-glyph {
    opacity: 0.5;
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  const wm = footer?.querySelector<HTMLElement>('[data-wm]');
  // Touch and stylus don't hover — a pointermove there would light the footer
  // once and leave it lit with no way to dismiss it.
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (footer && fine) {
    let x = 0;
    let y = 0;
    let raf = 0;

    function apply() {
      raf = 0;
      if (!wm) return;
      // The pointer has to be in the watermark's own coordinates, not the
      // footer's, or the spotlight lands offset from the cursor. The pointer is
      // usually above the strip entirely, giving a negative --wy — which is
      // exactly right: the circle's lower edge reaches down into it.
      const wr = wm.getBoundingClientRect();
      wm.style.setProperty('--wx', `${x - wr.left}px`);
      wm.style.setProperty('--wy', `${y - wr.top}px`);
    }

    footer.addEventListener(
      'pointermove',
      (e) => {
        x = e.clientX;
        y = e.clientY;
        if (!raf) raf = requestAnimationFrame(apply);
      },
      { passive: true },
    );
    footer.addEventListener('pointerenter', () => footer.classList.add('is-lit'), { passive: true });
    footer.addEventListener('pointerleave', () => footer.classList.remove('is-lit'), {
      passive: true,
    });
  }
</script>
