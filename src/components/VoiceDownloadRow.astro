---
// One row of the "other platforms" menu in VoiceDownload. Split out so the
// rows that sit in the panel directly and the rows tucked one level down
// (the direct Windows installers) are one piece of markup, not two copies
// that drift.
//
// The wrapper toggles with platform promotion; the row's own hidden state
// stays about whether that file exists. Two independent reasons to hide,
// on one element, is the bug the wrapper avoids — see VoiceDownload.
import type { UIStrings } from '../lib/i18n';

interface Props {
  entry: {
    group: { key: string; icon: any; windows: boolean };
    row: {
      key: string;
      archKey: string;
      conversion: string;
      label: string;
      arch: string;
      href: string | null;
      dl: { size: string } | null;
    };
    Tag: 'a' | 'button';
    avail: boolean;
  };
  /** Whether this row is the server-rendered primary and so starts hidden in the menu. */
  hidden: boolean;
  ui: UIStrings;
}
const { entry: e, hidden, ui } = Astro.props;

const rowCls =
  'w-full cursor-pointer items-center gap-2.5 rounded border-0 bg-transparent px-3 py-2 text-left transition-colors hover:bg-gray-100 dark:hover:bg-white/5';

// `shrink-0 whitespace-nowrap` — the label beside it wraps in several
// languages, and a two-line pill looks broken.
const tagCls =
  'shrink-0 rounded-full bg-gray-100 px-1.5 py-0.5 text-[10px] font-semibold whitespace-nowrap uppercase tracking-wide text-gray-500 dark:bg-white/10 dark:text-gray-400';
---

<div
  data-dl-alt={e.group.key}
  data-dl-alt-arch={e.row.archKey}
  data-dl-show="flex"
  class:list={['flex-col', hidden ? 'hidden' : 'flex']}
>
  <e.Tag
    type={e.row.href ? undefined : 'button'}
    href={e.row.href ?? undefined}
    data-conversion={e.row.conversion}
    data-dl-platform={e.row.href ? undefined : e.row.key}
    data-dl-row={e.row.href ? undefined : e.row.key}
    data-dl-show="inline-flex"
    class:list={[rowCls, e.avail ? 'inline-flex' : 'hidden']}
  >
    <e.group.icon class="h-4 w-4 shrink-0" style="color: #ff6d00" />
    <span class="flex min-w-0 flex-col">
      <span class="flex items-center gap-1.5 text-sm font-bold text-gray-900 dark:text-white">
        {e.row.label}
        {e.group.windows && <span class={tagCls}>{ui.dlEarly}</span>}
      </span>
      {/* The size is ours to state only for a file we publish. The store
          rows show their requirement line alone — the store prints the
          download size on the listing. */}
      {/* Free to wrap on a phone, where the panel is as wide as the screen
          and several of these lines aren't. The size keeps its separator
          and its unit together when it does — a line ending "· 102" with
          "MB" alone under it reads as a broken layout. */}
      <span class="text-[11px] font-normal text-gray-500 sm:whitespace-nowrap dark:text-gray-400">
        {e.row.arch}{e.row.dl && <span class="whitespace-nowrap"> · <span data-dl-size={e.row.key}>{e.row.dl.size}</span></span>}
      </span>
    </span>
  </e.Tag>
</div>
