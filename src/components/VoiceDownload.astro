---
// Smart download control for WaveKat Voice.
//
// Shows ONE primary control for the visitor's platform, with the OTHER
// platforms' recommended controls behind an "other platforms" disclosure.
// The site is statically built (no server to sniff the OS), so this is
// progressive enhancement: the server renders Mac as the default primary,
// and a tiny inline script promotes Linux or Windows when it detects one.
//
// The menu offers exactly one recommended control per system and nothing
// else. Every installer we hand out ourselves alongside a store — the .dmg,
// the two .exe files — lives on the download page instead, in the open,
// three columns wide (`VoiceDownloadAll.astro`), and the menu's last line
// is a link to it. A menu is for choosing quickly; a page is for choosing
// carefully, and stacking a second disclosure inside this one to hold the
// difference was neither.
//
// That split needs no rule of its own: it is the arch mechanism read one
// way round. A row whose `archKey` is promotable (`default`, or `arm64`
// once the browser confirms the chip) is a candidate for the button, and
// therefore a menu row; a `direct*` row is promoted by nothing, so it is a
// page row. `isPromotable` in voice-download-groups.ts is the whole test.
//
// Which leaves Linux as the one platform that still has to work the
// architecture out for itself — x64 is what everyone starts on, and a
// machine that confirms it is ARM64 is upgraded to the native build. Mac
// publishes a single arm64 build, and Windows hands the question to the
// Microsoft Store, whose one listing carries both packages. Confirming the
// chip takes `navigator.userAgentData`, so it happens a beat after the
// platform swap rather than with it. See docs/05.
//
// With JS off, the <noscript> block still lists every build we publish.
import { Apple, Package, AppWindow, ChevronDown, ArrowRight } from '@lucide/astro';
import ConversionTracking from './ConversionTracking.astro';
import VoiceDownloadRow from './VoiceDownloadRow.astro';
import {
  getDownload,
  DOWNLOAD_BASE,
  RELEASES_URL,
  MAC_APP_STORE_CAMPAIGN_URL,
  MS_STORE_CAMPAIGN_URL,
} from '../lib/voice-download';
import StoreBadge from './StoreBadge.astro';
import { buildGroups, isPromotable, rowAvailable } from '../lib/voice-download-groups';
import type { PlatformGroupKey } from '../lib/voice-download-groups';
import { badgeStoreFor } from '../lib/badges';
import { localizedPath, resolveLocale, t } from '../lib/i18n';

interface Props {
  /** 'hero' = elevated pill (default), 'cta' = flatter button for cards. */
  variant?: 'hero' | 'cta';
}
const { variant = 'hero' } = Astro.props;

const { code: lang } = resolveLocale(Astro.url.pathname);
const ui = t(lang);

// Where the full list lives. On the download page itself the grid is
// already below the fold, so the link would point at the page you are
// standing on — the menu drops it there instead.
const downloadPath = localizedPath('/voice/download/', lang);
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const onDownloadPage = here === downloadPath;

const [mac, linuxX64, linuxArm, winX64, winArm] = await Promise.all([
  getDownload('mac'),
  getDownload('linux-x64'),
  getDownload('linux-arm64'),
  getDownload('windows-x64'),
  getDownload('windows-arm64'),
]);

// The one list, shared with the grid on the download page.
const groups = buildGroups(
  ui,
  { mac, linuxX64, linuxArm, winX64, winArm },
  { macAppStore: MAC_APP_STORE_CAMPAIGN_URL, msStore: MS_STORE_CAMPAIGN_URL },
);

// Every entry here is both a candidate primary and a menu row, and the two
// are exact opposites: the menu lists precisely what the button isn't
// offering. One list drives both, so the pair can't drift into showing a
// choice twice or not at all. A Linux visitor on x64 still sees the ARM
// build in the menu — it is the one choice their primary can't make for
// them — and an ARM visitor sees x64 there for the same reason, in reverse.
const entries = groups.flatMap((g) =>
  g.rows.filter((row) => isPromotable(row.archKey)).map((row) => ({
    group: g,
    row,
    Tag: row.href ? ('a' as const) : ('button' as const),
    avail: rowAvailable(row),
  })),
);

// The primary button's icon. The menu rows resolve their own (see
// VoiceDownloadRow), so this is the one place left that needs the map.
const ICONS: Record<PlatformGroupKey, any> = { mac: Apple, windows: AppWindow, linux: Package };

// Mac is the SSR default primary; the script swaps to Linux or Windows.
// `DEFAULT_ARCH` is the arch half of the same statement: nothing is known
// about the chip until a script asks, so the server always renders the
// row every machine of that platform can run.
const DEFAULT = 'mac';
const DEFAULT_ARCH = 'default';

const isDefaultPrimary = (e: (typeof entries)[number]) =>
  e.group.key === DEFAULT && e.row.archKey === DEFAULT_ARCH;

// Display utility is toggled separately from the rest: an element gets
// EITHER its own display class or `hidden`, never both — putting both on
// one element lets the display utility win the race and `hidden` silently
// does nothing. Each toggleable element names its display in
// `data-dl-show` so the script never has to guess which one to restore.
const primaryCls =
  variant === 'cta'
    ? 'items-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#ff6d00]/30'
    : 'items-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#ff6d00]/25 transition-all hover:shadow-xl hover:shadow-[#ff6d00]/35 hover:-translate-y-0.5';

// The primary when it is a store handoff rather than one of our files.
//
// It shares the hover lift with the pill above — the two swap places when
// the promotion script fires, and a control that stopped responding to the
// pointer because the visitor is on a Mac rather than Linux would read as
// broken. Everything else is deliberately absent: no padding, no
// background, no radius of ours. The badge is already a complete control
// with all three, and both stores require their artwork be used as
// published — a background behind it or a corner radius over it is exactly
// the alteration they forbid.
//
// The radius here is on the FOCUS RING alone, so keyboard focus traces the
// badge's own corners rather than boxing it in a square.
const badgePrimaryCls =
  'items-center rounded-lg transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff6d00]';

// `text-left` because the CTA card centres its text and the menu shouldn't
// inherit that — the rows are left-aligned, so the note under them is too.
//
// The panel has two sizings, and they answer different questions.
//
// From `sm` up: `w-max` is load-bearing. The panel is absolutely positioned
// inside the `relative` <details>, so its containing block is only as wide
// as the "other platforms" summary — shrink-to-fit caps it there and every
// row wraps, which is what `min-w` was really propping open. A fixed minimum
// can't hold nine locales ("Für Windows auf ARM herunterladen" is half
// again as long as the English), so the panel sizes to its own widest row
// instead.
//
// On a phone that same anchor is the bug: the summary sits beside the
// primary button, a third of the way across the screen, and a panel wide
// enough to read from there runs off the right edge — which scrolls the
// whole document sideways, since nothing above clips it. A viewport-width
// `max-w` can't save it, because a cap on width says nothing about where
// the box starts. So below `sm` the panel measures against the control
// instead of the summary (the wrapper is the `relative` one there, see the
// markup) and takes its full width: left edge on the page margin, right
// edge on the other, correct at any width and in any language.
const panelCls =
  'absolute left-0 top-full z-20 mt-2 flex w-full max-w-full flex-col gap-1 rounded-xl border border-gray-200 bg-white/95 p-1.5 text-left shadow-xl backdrop-blur-xl sm:w-max sm:min-w-[19rem] sm:max-w-[calc(100vw-2rem)] dark:border-white/10 dark:bg-wk-surface/95';

// The footer link to the full list, styled as a quiet last line of the
// panel rather than as another row — it goes to a page, not to a file.
const allCls =
  'flex items-center gap-1.5 rounded px-3 py-2 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white';
---

{/* `relative` so the menu has something page-wide to measure against on a
    phone — see `panelCls`. Full width there for the same reason, which also
    puts the row's other button (GitHub, or the install link) on its own line
    rather than squeezed beside this one; `sm:inline-block` restores the
    shrink-to-fit box every layout above that expects. */}
<div class="relative block w-full text-left sm:inline-block sm:w-auto" data-voice-download>
  {/* The CTA card centres its content by centring this box, which a
      full-width box can't be — so on a phone the row does its own centring. */}
  <div class:list={['flex flex-wrap items-center gap-3', variant === 'cta' && 'max-sm:justify-center']}>
    {/* One primary per (platform, arch) — exactly one is ever shown. Our
        own downloads are <button>s: the URL is built on click, so no
        artifact filename and no version ever reaches the delivered HTML.
        The App Store row is the exception and a real <a>, because there
        the link IS the thing — it's the same URL for every visitor, it
        exposes nothing, and a crawler following it through to the listing
        is a link worth having followed. `data-dl-avail` is the build's
        answer to "does this file exist", refreshed in the browser, and the
        promotion script won't put an unavailable target on the button. */}
    {entries.map((e) => {
      const Icon = ICONS[e.group.key];
      // Mac and Windows promote to a store, so their primary IS the store's
      // badge; Linux has no store and keeps the orange pill. That isn't an
      // inconsistency to tidy away later — it's the same `href` vs `dl`
      // split the rest of this file turns on, drawn at button size.
      //
      // Except on the download page, where the grid below already draws
      // both badges: a second copy of the same artwork one screen higher
      // reads as a bug rather than as emphasis. There the primary returns
      // to the orange pill, which also keeps the brand control above the
      // fold on the one page whose body is store artwork. Keyed on the
      // page and not on which platform is promoted, because the promotion
      // happens in the browser — see the same reasoning in
      // VoiceDownloadRow.
      const store = onDownloadPage ? null : badgeStoreFor(e.row.key);
      return (
        <e.Tag
          type={e.row.href ? undefined : 'button'}
          href={e.row.href ?? undefined}
          data-conversion={e.row.conversion}
          data-dl-primary={e.group.key}
          data-dl-arch={e.row.archKey}
          data-dl-platform={e.row.href ? undefined : e.row.key}
          data-dl-avail={e.avail ? '1' : '0'}
          data-dl-show="inline-flex"
          class:list={[
            store ? badgePrimaryCls : primaryCls,
            'cursor-pointer border-0',
            isDefaultPrimary(e) ? 'inline-flex' : 'hidden',
          ]}
          style={store ? undefined : 'background-color: #ff6d00'}
        >
          {store ? (
            /* `eager`: on /voice/ this is the hero control, above the fold,
               and the one image on the page worth blocking nothing on. */
            <StoreBadge store={store} locale={lang} alt={e.row.label} loading="eager" />
          ) : (
            <Fragment>
              <Icon class="w-5 h-5" />
              {e.row.label}
            </Fragment>
          )}
        </e.Tag>
      );
    })}

    {/* Other platforms — native <details> so it works without JS. Each row
        (VoiceDownloadRow) is WRAPPED, so promoting a platform toggles the
        wrapper while the row's own hidden state stays about whether that
        file exists. Two independent reasons to hide, on one element, is
        the bug this avoids. */}
    <details class="group sm:relative" data-dl-more>
      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-xs font-medium text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white [&::-webkit-details-marker]:hidden">
        {ui.dlOther}
        <ChevronDown class="h-3.5 w-3.5 transition-transform group-open:rotate-180" />
      </summary>
      <div class={panelCls}>
        {entries.map((e) => (
          <VoiceDownloadRow group={e.group} row={e.row} ui={ui} context="menu" hidden={isDefaultPrimary(e)} />
        ))}

        {/* The last line, and the only one that isn't a download: every
            installer this menu deliberately doesn't list is on that page,
            laid out one column per system. Dropped on the download page
            itself, where it would point at the reader's own location. */}
        {!onDownloadPage && (
          <a href={downloadPath} class={allCls}>
            {ui.dlAllDownloads}
            <ArrowRight class="h-3.5 w-3.5 shrink-0" />
          </a>
        )}
      </div>
    </details>

    {/* Invisible to anyone with JS. It exposes no filename and is logged
        like every other download, so it costs nothing and keeps the page
        honest for crawlers and the handful of readers without scripting. */}
    <noscript>
      <div class="flex flex-wrap items-center gap-4">
        {groups.flatMap((g) =>
          g.rows.filter((r) => r.href || r.dl).map((r) => {
            const Icon = ICONS[g.key];
            return (
              <a
                href={r.href ?? r.dl!.url}
                class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 underline underline-offset-2 dark:text-white"
              >
                <Icon class="h-4 w-4" style="color: #ff6d00" />
                {r.label}
              </a>
            );
          }),
        )}
      </div>
    </noscript>
  </div>
</div>

<ConversionTracking />

<script is:inline define:vars={{ base: DOWNLOAD_BASE, releasesUrl: RELEASES_URL }}>
  // The download itself. Delegated from the document so it covers the
  // primary control, both menus, and anything either script below shows
  // later. The URL names a target and nothing else — the platform
  // resolves the current installer, records the download and redirects
  // (wavekat-platform docs/37 §3.6).
  //
  // The App Store rows carry no `data-dl-platform`, so this handler never
  // sees them and their <a> navigates on its own. That is the whole
  // integration: Apple's link needs no resolving, and putting it through
  // an endpoint that answers with one of our own installers is exactly
  // the bug the missing attribute prevents.
  (function () {
    document.addEventListener('click', function (e) {
      // e.target can be a text node or the document itself, neither of
      // which has closest().
      var t = e.target;
      var el = t && t.closest ? t.closest('[data-dl-platform]') : null;
      if (!el) return;
      window.location.href = base + '/' + el.dataset.dlPlatform + '?src=web';
    });
  })();

  // Keep the printed version and size true when a release lands between
  // site deploys. The build-time values are already in the HTML, so this
  // corrects them silently or does nothing at all — there is no skeleton,
  // no pop-in, and a failed fetch leaves the page exactly as served.
  //
  // It also reveals or withdraws a whole choice. `windows-arm64` did not
  // exist before the native ARM build, so its row ships hidden and
  // appears the day a release publishes one, with no site rebuild. A row
  // for a file the platform says is missing would 404, so the same rule
  // runs in reverse.
  (function () {
    if (!document.querySelector('[data-dl-version],[data-dl-size],[data-dl-row]')) return;
    fetch(releasesUrl)
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        ['mac', 'linux', 'windows-x64', 'windows-arm64'].forEach(function (key) {
          var rel = data[key];
          document.querySelectorAll('[data-dl-row="' + key + '"]').forEach(function (el) {
            el.classList.toggle(el.dataset.dlShow || 'inline-flex', !!rel);
            el.classList.toggle('hidden', !rel);
          });
          // The same fact on the primary controls, which the promotion
          // script reads before it puts a target on the button.
          document.querySelectorAll('[data-dl-primary][data-dl-platform="' + key + '"]').forEach(
            function (el) { el.dataset.dlAvail = rel ? '1' : '0'; },
          );
          if (!rel) return;
          document.querySelectorAll('[data-dl-version="' + key + '"]').forEach(function (el) {
            el.textContent = rel.version;
          });
          document.querySelectorAll('[data-dl-size="' + key + '"]').forEach(function (el) {
            el.textContent = Math.round(rel.sizeBytes / 1048576) + ' MB';
          });
        });
        // Availability may have changed under the primary control — an
        // ARM visitor promoted to a build this release didn't publish
        // has to be handed x64 back, and vice versa.
        if (window.__wkResolveDownload) window.__wkResolveDownload();
      })
      .catch(function () {});
  })();
</script>

<script is:inline>
  // Promote the visitor's platform to the primary control, then — on
  // Linux only — the visitor's chip.
  //
  // The PLATFORM pass runs synchronously as the markup is parsed, so
  // there's no flash of the wrong default, and it is plain UA sniffing.
  //
  // The CHIP pass is separate because it has to be: the only place a
  // browser exposes the architecture is
  // `navigator.userAgentData.getHighEntropyValues()`, which is
  // Chromium-only and returns a promise. That shapes the design: x64 goes
  // on the button first and holds it for everything that can't answer
  // (every non-Chromium browser, and every Intel or AMD machine, which is
  // nearly all of them), and an ARM64 machine is upgraded to the native
  // build a few milliseconds later. Guessing wrong in that direction is
  // recoverable rather than fatal, which is why the slow, partial signal
  // is safe to act on and the button never waits for it.
  (function () {
    var ua = navigator.userAgent || '';
    var plat = navigator.platform || '';
    var probe = plat + ' ' + ua;
    // Windows first: a Windows UA never says Linux, but Android's does.
    var active = /Win(dows|32|64)/i.test(probe)
      ? 'windows'
      : /Linux/i.test(probe) && !/Android/i.test(ua)
        ? 'linux'
        : 'mac';
    var activeArch = 'default';
    // Show/hide by swapping the single display class, never stacking both.
    function setShown(el, shown) {
      el.classList.toggle(el.dataset.dlShow || 'inline-flex', shown);
      el.classList.toggle('hidden', !shown);
    }
    function resolve() {
      document.querySelectorAll('[data-voice-download]').forEach(function (root) {
        // Pick the first arch this release actually published: the one
        // we'd rather serve, then the one every machine of this platform
        // can run. `null` if it published neither, which shows no primary
        // at all — the menu is still there, and an unpublished target
        // behind a visible button is a 404, which is the one outcome
        // worse than an extra click. The same rule the menu rows follow,
        // so the two can't disagree about what exists. Decided per root
        // and per call, so the release refresh below can withdraw or
        // restore the choice by re-running this.
        var order = activeArch === 'default' ? ['default'] : [activeArch, 'default'];
        var arch = null;
        for (var i = 0; i < order.length; i++) {
          var want = root.querySelector(
            '[data-dl-primary="' + active + '"][data-dl-arch="' + order[i] + '"]',
          );
          if (want && want.dataset.dlAvail !== '0') {
            arch = order[i];
            break;
          }
        }
        root.querySelectorAll('[data-dl-primary]').forEach(function (el) {
          setShown(el, el.dataset.dlPrimary === active && el.dataset.dlArch === arch);
        });
        // A menu row hides when the primary is already offering it. Every
        // wrapper names an arch, so this is a plain (platform, arch) match
        // — the note at the foot of the panel used to be the one exception
        // and is now unconditional, because it is about the direct .exe
        // rows rather than about Windows.
        root.querySelectorAll('[data-dl-alt]').forEach(function (el) {
          setShown(el, !(el.dataset.dlAlt === active && el.dataset.dlAltArch === arch));
        });
      });
      // Show only the active platform's caption, matching the single
      // control. Keyed on platform alone, which is all that is left to key
      // on: every platform now shows one primary whatever the chip. These
      // <p> have no display utility, so toggling `hidden` alone is safe.
      // Caption lines can sit after this script in the page, so
      // DOMContentLoaded catches them — controls swap synchronously (no
      // flicker).
      document.querySelectorAll('[data-dl-meta]').forEach(function (el) {
        el.classList.toggle('hidden', el.dataset.dlMeta !== active);
      });
    }
    // Exposed so the release refresh above can re-run the promotion when
    // it learns a target appeared or vanished since the build.
    window.__wkResolveDownload = resolve;
    resolve();
    document.addEventListener('DOMContentLoaded', resolve);

    // Linux is the only platform with an architecture left to work out.
    // macOS publishes a single arm64 build; Windows hands the question to
    // the Microsoft Store, whose one listing carries both packages. On
    // either of them there is no second row to promote to, so the probe
    // could only cost a call and change nothing.
    var uad = navigator.userAgentData;
    if (active !== 'linux' || !uad || !uad.getHighEntropyValues) return;
    uad
      .getHighEntropyValues(['architecture', 'bitness'])
      .then(function (h) {
        // Chromium reports the chip as 'arm' with a separate bitness, so
        // both halves are checked: 32-bit ARM exists and cannot run the
        // arm64 package. Anything else keeps x64.
        if (!h || h.architecture !== 'arm' || h.bitness !== '64') return;
        activeArch = 'arm64';
        resolve();
      })
      .catch(function () {});
  })();
</script>

<script is:inline>
  // Native <details> only toggles via its <summary>, so a menu stays open
  // when you click elsewhere. Close any open one on an outside click or
  // the Escape key, the way a menu is expected to behave.
  (function () {
    document.addEventListener('click', function (e) {
      document.querySelectorAll('[data-dl-more][open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('[data-dl-more][open]').forEach(function (d) {
        d.removeAttribute('open');
      });
    });
  })();
</script>
