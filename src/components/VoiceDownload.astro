---
// Smart download control for WaveKat Voice.
//
// Shows ONE primary control for the visitor's platform, with the others
// tucked behind an "other platforms" disclosure. The site is statically
// built (no server to sniff the OS), so this is progressive enhancement:
// the server renders Mac as the default primary, and a tiny inline script
// promotes Linux or Windows when it detects one. With JS off, the native
// <details> still lets anyone reach every build.
//
// Windows ships two installers, x64 and arm64, and the button still doesn't
// ask which one — it works it out. x64 is what everyone starts on, because
// it runs on every Windows PC we support (natively on Intel and AMD,
// emulated on Windows 11 for ARM) while an arm64 build runs on almost none
// of them. A machine that confirms it is ARM64 is then upgraded to the
// native build, which is the only case where the emulated one is the wrong
// answer. Confirming that takes `navigator.userAgentData`, so it happens a
// beat after the platform swap rather than with it. See docs/05.
//
// Mac has two rows for an unrelated reason: the same app arrives either
// from the Mac App Store or as a .dmg from us, and the store is the
// button — Apple signs it, installs it and keeps it updated, which is a
// better first run than a disk image for anyone not specifically after
// the direct build. The .dmg stays one click away in the menu. That falls
// out of the arch mechanism instead of adding a rule to it: the .dmg's
// `archKey` is one nothing ever promotes, so it can only be a menu row.
import { Apple, Package, AppWindow, ChevronDown } from '@lucide/astro';
import ConversionTracking from './ConversionTracking.astro';
import {
  getDownload,
  DOWNLOAD_BASE,
  RELEASES_URL,
  MAC_APP_STORE_CAMPAIGN_URL,
} from '../lib/voice-download';
import { localizedPath, resolveLocale, t } from '../lib/i18n';

interface Props {
  /** 'hero' = elevated pill (default), 'cta' = flatter button for cards. */
  variant?: 'hero' | 'cta';
}
const { variant = 'hero' } = Astro.props;

const { code: lang } = resolveLocale(Astro.url.pathname);
const ui = t(lang);

// The SmartScreen walkthrough lives on our own download page, in the
// reader's language — not in /docs/**, which is synced from the private
// repo and English-only. On /voice/download/ itself this is a same-page
// jump to the section below the fold.
const unsignedHref = `${localizedPath('/voice/download/', lang)}#windows`;

const [macDl, linuxX64Dl, linuxArmDl, winX64Dl, winArmDl] = await Promise.all([
  getDownload('mac'),
  getDownload('linux-x64'),
  getDownload('linux-arm64'),
  getDownload('windows-x64'),
  getDownload('windows-arm64'),
]);

// Grouped by the control a visitor sees, not by file. Labels and hardware
// requirements are localised here — the download lib stays
// language-agnostic, knowing only versions, sizes and URLs.
//
// `archKey` is which machine a row is promoted for, and it is what makes a
// row a candidate primary: `default` is the row a visitor on that platform
// gets when nothing more is known, `arm64` is the one they get instead once
// the browser confirms an ARM64 chip. Only Windows has both, because only
// Windows ships two installers that are not interchangeable.
const groups = [
  {
    key: 'mac',
    icon: Apple,
    windows: false,
    rows: [
      {
        // The Mac App Store is the default Mac primary. It carries an
        // `href` and no `dl`: there is no release behind it to read a
        // version or a size from, and nothing for the browser-side
        // refresh to correct — Apple owns the whole handoff.
        key: 'mac-app-store',
        archKey: 'default',
        conversion: 'download_mac_app_store',
        label: ui.dlMacAppStore,
        arch: ui.dlArchMacAppStore,
        // The campaign-tagged listing, not the canonical one: this is the
        // link a visitor actually follows, and the tag is the only way
        // App Store Connect can tell an install that started here from
        // one that started in App Store search.
        href: MAC_APP_STORE_CAMPAIGN_URL,
        dl: null,
      },
      {
        // `direct` is an arch nothing promotes, and that is the whole
        // trick: the promotion script only ever asks for 'default' or
        // 'arm64', so this row can never win the button and is therefore
        // always in the menu — without teaching that script a second rule.
        key: 'mac',
        archKey: 'direct',
        conversion: 'download_mac',
        label: ui.dlMac,
        arch: ui.dlArchMac,
        href: null,
        dl: macDl,
      },
    ],
  },
  {
    key: 'linux',
    icon: Package,
    windows: false,
    rows: [
      {
        key: 'linux-x64',
        archKey: 'default',
        conversion: 'download_linux',
        label: ui.dlLinux,
        arch: ui.dlArchLinux,
        href: null,
        dl: linuxX64Dl,
      },
      {
        // Same shape as the Windows pair above, and unconditional for the
        // same reason: the row renders hidden whenever the platform reports
        // the target unpublished, and the browser-side refresh flips it
        // either way without a rebuild. So this is correct both before and
        // after the first release that builds an arm64 Linux package.
        key: 'linux-arm64',
        archKey: 'arm64',
        conversion: 'download_linux_arm64',
        label: ui.dlLinuxArm64,
        arch: ui.dlArchLinuxArm64,
        href: null,
        dl: linuxArmDl,
      },
    ],
  },
  {
    key: 'windows',
    icon: AppWindow,
    windows: true,
    rows: [
      {
        key: 'windows-x64',
        archKey: 'default',
        conversion: 'download_windows_x64',
        label: ui.dlWindows,
        arch: ui.dlArchWindowsX64,
        href: null,
        dl: winX64Dl,
      },
      {
        // Published since 0.0.46. Nothing here is conditional on that:
        // the row renders hidden whenever the platform reports the
        // target unpublished, and the browser-side refresh flips it
        // either way without a rebuild. The promotion script checks the
        // same fact before it hands an ARM machine this primary, so a
        // release that builds no arm64 installer leaves x64 on the
        // button rather than a control that 404s. See the scripts below.
        key: 'windows-arm64',
        archKey: 'arm64',
        conversion: 'download_windows_arm64',
        label: ui.dlWindowsArm64,
        arch: ui.dlArchWindowsArm64,
        href: null,
        dl: winArmDl,
      },
    ],
  },
];

// Every row is both a candidate primary and a menu row, and the two are
// exact opposites: the menu lists precisely what the button isn't
// downloading. So one list drives both, and the pair can't drift into
// showing a file twice or not at all. A Windows visitor on an Intel
// machine still sees the ARM build in the menu — it is the one choice
// their primary can't make for them — and an ARM visitor sees x64 there
// for the same reason, in reverse.
//
// A row with an `href` is a handoff rather than a download, and the two
// differ in every way that matters here: it renders as a real <a>, it
// keeps `data-dl-platform` off itself so the delegated download handler
// ignores it, and it is available by definition — there is no release
// object behind it to ask.
const entries = groups.flatMap((g) =>
  g.rows.map((row) => ({
    group: g,
    row,
    Tag: row.href ? 'a' : 'button',
    avail: !!(row.href || row.dl),
  })),
);

// The unsigned note covers BOTH Windows builds, so it caps the group at the
// foot of the panel rather than sitting on one row — attached to the x64
// row it rendered between the two Windows entries, reading as a caveat
// about x64 alone and cutting the ARM row loose from the group above it.
// It carries the Windows platform key and deliberately no arch, which the
// script reads as "either Windows build": hidden exactly when a Windows
// visitor is already reading the same line under their button, whichever
// of the two installers that button hands them.
const windowsKey = groups.find((g) => g.windows)!.key;

// Mac is the SSR default primary; the script swaps to Linux or Windows.
// `DEFAULT_ARCH` is the arch half of the same statement: nothing is known
// about the chip until a script asks, so the server always renders the
// row every machine of that platform can run.
const DEFAULT = 'mac';
const DEFAULT_ARCH = 'default';

const isDefaultPrimary = (e: (typeof entries)[number]) =>
  e.group.key === DEFAULT && e.row.archKey === DEFAULT_ARCH;

// Display utility is toggled separately from the rest: an element gets
// EITHER its own display class or `hidden`, never both — putting both on
// one element lets the display utility win the race and `hidden` silently
// does nothing. Each toggleable element names its display in
// `data-dl-show` so the script never has to guess which one to restore.
const primaryCls =
  variant === 'cta'
    ? 'items-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold text-white transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#ff6d00]/30'
    : 'items-center gap-2.5 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#ff6d00]/25 transition-all hover:shadow-xl hover:shadow-[#ff6d00]/35 hover:-translate-y-0.5';

// `text-left` because the CTA card centres its text and the menu shouldn't
// inherit that — the rows are left-aligned, so the note under them is too.
//
// `w-max` is load-bearing. The panel is absolutely positioned inside the
// `relative` <details>, so its containing block is only as wide as the
// "other platforms" summary — shrink-to-fit caps it there and every row
// wraps, which is what `min-w` was really propping open. A fixed minimum
// can't hold nine locales ("Für Windows auf ARM herunterladen" is half
// again as long as the English), so the panel sizes to its own widest row
// instead, and `max-w` keeps it inside a phone screen when that row is
// wider than the viewport.
const panelCls =
  'absolute left-0 top-full z-20 mt-2 flex w-max min-w-[19rem] max-w-[calc(100vw-2rem)] flex-col gap-1 rounded-xl border border-gray-200 bg-white/95 p-1.5 text-left shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-wk-surface/95';

const rowCls =
  'w-full cursor-pointer items-center gap-2.5 rounded border-0 bg-transparent px-3 py-2 text-left transition-colors hover:bg-gray-100 dark:hover:bg-white/5';

// `shrink-0 whitespace-nowrap` — the label beside it wraps in several
// languages, and a two-line pill looks broken.
const tagCls =
  'shrink-0 rounded-full bg-gray-100 px-1.5 py-0.5 text-[10px] font-semibold whitespace-nowrap uppercase tracking-wide text-gray-500 dark:bg-white/10 dark:text-gray-400';

// Sits at the foot of the panel now, so it pays for its own top spacing —
// the rows above are buttons with their own padding and would otherwise
// leave the note crowded against the last one.
//
// The `max-w` is what keeps a `w-max` panel sane: a paragraph's max-content
// width is the whole sentence on one line, so without a cap this one
// sentence would set the width of the entire menu. Capped below the panel's
// minimum, it wraps like a caption and the rows decide the width.
const noteCls =
  'max-w-[17rem] px-3 pt-1 pb-1 text-[11px] leading-relaxed text-gray-500 dark:text-gray-400';
---

<div class="inline-block text-left" data-voice-download>
  <div class="flex flex-wrap items-center gap-3">
    {/* One primary per (platform, arch) — exactly one is ever shown. Our
        own downloads are <button>s: the URL is built on click, so no
        artifact filename and no version ever reaches the delivered HTML.
        The App Store row is the exception and a real <a>, because there
        the link IS the thing — it's the same URL for every visitor, it
        exposes nothing, and a crawler following it through to the listing
        is a link worth having followed. `data-dl-avail` is the build's
        answer to "does this file exist", refreshed in the browser, and the
        promotion script won't put an unavailable target on the button. */}
    {entries.map((e) => (
      <e.Tag
        type={e.row.href ? undefined : 'button'}
        href={e.row.href ?? undefined}
        data-conversion={e.row.conversion}
        data-dl-primary={e.group.key}
        data-dl-arch={e.row.archKey}
        data-dl-platform={e.row.href ? undefined : e.row.key}
        data-dl-avail={e.avail ? '1' : '0'}
        data-dl-show="inline-flex"
        class:list={[primaryCls, 'cursor-pointer border-0', isDefaultPrimary(e) ? 'inline-flex' : 'hidden']}
        style="background-color: #ff6d00"
      >
        <e.group.icon class="w-5 h-5" />
        {e.row.label}
      </e.Tag>
    ))}

    {/* Other platforms — native <details> so it works without JS. Each row
        is WRAPPED, so promoting a platform toggles the wrapper while the
        row's own hidden state stays about whether that file exists. Two
        independent reasons to hide, on one element, is the bug this
        avoids. */}
    <details class="group relative" data-dl-more>
      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-xs font-medium text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white [&::-webkit-details-marker]:hidden">
        {ui.dlOther}
        <ChevronDown class="h-3.5 w-3.5 transition-transform group-open:rotate-180" />
      </summary>
      <div class={panelCls}>
        {entries.map((e) => (
          <div
            data-dl-alt={e.group.key}
            data-dl-alt-arch={e.row.archKey}
            data-dl-show="flex"
            class:list={['flex-col', isDefaultPrimary(e) ? 'hidden' : 'flex']}
          >
            <e.Tag
              type={e.row.href ? undefined : 'button'}
              href={e.row.href ?? undefined}
              data-conversion={e.row.conversion}
              data-dl-platform={e.row.href ? undefined : e.row.key}
              data-dl-row={e.row.href ? undefined : e.row.key}
              data-dl-show="inline-flex"
              class:list={[rowCls, e.avail ? 'inline-flex' : 'hidden']}
            >
              <e.group.icon class="h-4 w-4 shrink-0" style="color: #ff6d00" />
              <span class="flex flex-col">
                <span class="flex items-center gap-1.5 text-sm font-bold text-gray-900 dark:text-white">
                  {e.row.label}
                  {e.group.windows && <span class={tagCls}>{ui.dlEarly}</span>}
                </span>
                {/* The size is ours to state only for a file we publish.
                    The App Store row shows its requirement line alone —
                    Apple prints the download size on the listing. */}
                <span class="whitespace-nowrap text-[11px] font-normal text-gray-500 dark:text-gray-400">{e.row.arch}{e.row.dl && <Fragment> · <span data-dl-size={e.row.key}>{e.row.dl.size}</span></Fragment>}</span>
              </span>
            </e.Tag>
          </div>
        ))}
        <p
          data-dl-alt={windowsKey}
          data-dl-show="block"
          class:list={[noteCls, windowsKey === DEFAULT ? 'hidden' : 'block']}
        >
          {ui.dlWindowsUnsigned}{' '}
          <a href={unsignedHref} class="underline underline-offset-2 hover:text-gray-900 dark:hover:text-white">{ui.dlWindowsUnsignedLink}</a>
        </p>
      </div>
    </details>

    {/* Invisible to anyone with JS. It exposes no filename and is logged
        like every other download, so it costs nothing and keeps the page
        honest for crawlers and the handful of readers without scripting. */}
    <noscript>
      <div class="flex flex-wrap items-center gap-4">
        {groups.flatMap((g) => g.rows.filter((r) => r.href || r.dl).map((r) => (
          <a
            href={r.href ?? r.dl!.url}
            class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 underline underline-offset-2 dark:text-white"
          >
            <g.icon class="h-4 w-4" style="color: #ff6d00" />
            {r.label}
          </a>
        )))}
      </div>
    </noscript>
  </div>

  {/* Windows warns on first launch, and the visitor about to hit that
      warning is exactly the one whose primary says Windows — so the note
      sits under the button for them, and inside the menu for everyone
      else. Hidden by default and shown by the promotion script, like the
      version captions on the page. */}
  <p data-dl-note="windows" class="hidden mt-2.5 max-w-xs text-[11px] leading-relaxed text-gray-500 dark:text-gray-400">
    {ui.dlWindowsUnsigned}{' '}
    <a href={unsignedHref} class="underline underline-offset-2 hover:text-gray-900 dark:hover:text-white">{ui.dlWindowsUnsignedLink}</a>
  </p>
</div>

<ConversionTracking />

<script is:inline define:vars={{ base: DOWNLOAD_BASE, releasesUrl: RELEASES_URL }}>
  // The download itself. Delegated from the document so it covers the
  // primary control, both menus, and anything either script below shows
  // later. The URL names a target and nothing else — the platform
  // resolves the current installer, records the download and redirects
  // (wavekat-platform docs/37 §3.6).
  //
  // The App Store rows carry no `data-dl-platform`, so this handler never
  // sees them and their <a> navigates on its own. That is the whole
  // integration: Apple's link needs no resolving, and putting it through
  // an endpoint that answers with one of our own installers is exactly
  // the bug the missing attribute prevents.
  (function () {
    document.addEventListener('click', function (e) {
      // e.target can be a text node or the document itself, neither of
      // which has closest().
      var t = e.target;
      var el = t && t.closest ? t.closest('[data-dl-platform]') : null;
      if (!el) return;
      window.location.href = base + '/' + el.dataset.dlPlatform + '?src=web';
    });
  })();

  // Keep the printed version and size true when a release lands between
  // site deploys. The build-time values are already in the HTML, so this
  // corrects them silently or does nothing at all — there is no skeleton,
  // no pop-in, and a failed fetch leaves the page exactly as served.
  //
  // It also reveals or withdraws a whole choice. `windows-arm64` did not
  // exist before the native ARM build, so its row ships hidden and
  // appears the day a release publishes one, with no site rebuild. A row
  // for a file the platform says is missing would 404, so the same rule
  // runs in reverse.
  (function () {
    if (!document.querySelector('[data-dl-version],[data-dl-size],[data-dl-row]')) return;
    fetch(releasesUrl)
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        ['mac', 'linux', 'windows-x64', 'windows-arm64'].forEach(function (key) {
          var rel = data[key];
          document.querySelectorAll('[data-dl-row="' + key + '"]').forEach(function (el) {
            el.classList.toggle(el.dataset.dlShow || 'inline-flex', !!rel);
            el.classList.toggle('hidden', !rel);
          });
          // The same fact on the primary controls, which the promotion
          // script reads before it puts a target on the button.
          document.querySelectorAll('[data-dl-primary][data-dl-platform="' + key + '"]').forEach(
            function (el) { el.dataset.dlAvail = rel ? '1' : '0'; },
          );
          if (!rel) return;
          document.querySelectorAll('[data-dl-version="' + key + '"]').forEach(function (el) {
            el.textContent = rel.version;
          });
          document.querySelectorAll('[data-dl-size="' + key + '"]').forEach(function (el) {
            el.textContent = Math.round(rel.sizeBytes / 1048576) + ' MB';
          });
        });
        // Availability may have changed under the primary control — an
        // ARM visitor promoted to a build this release didn't publish
        // has to be handed x64 back, and vice versa.
        if (window.__wkResolveDownload) window.__wkResolveDownload();
      })
      .catch(function () {});
  })();
</script>

<script is:inline>
  // Promote the visitor's platform to the primary control, then — on
  // Windows only — the visitor's chip.
  //
  // The PLATFORM pass runs synchronously as the markup is parsed, so
  // there's no flash of the wrong default, and it is plain UA sniffing.
  //
  // The CHIP pass is separate because it has to be. A Windows 11 machine
  // on ARM64 reports "Windows NT 10.0; Win64; x64" in its user-agent
  // string on purpose — Windows hides the chip so x64 software keeps
  // working — so no amount of UA reading can find it. The one place it is
  // exposed is `navigator.userAgentData.getHighEntropyValues()`, which is
  // Chromium-only and returns a promise. That shapes the whole design:
  // x64 goes on the button first and holds it for everything that can't
  // answer (every non-Chromium browser, and Windows on Intel and AMD,
  // which is nearly all of it), and an ARM64 machine is upgraded to the
  // native build a few milliseconds later. Guessing wrong in that
  // direction costs nothing — Windows 11 for ARM emulates x64 — which is
  // why the slow, partial signal is safe to act on and the button never
  // waits for it.
  (function () {
    var ua = navigator.userAgent || '';
    var plat = navigator.platform || '';
    var probe = plat + ' ' + ua;
    // Windows first: a Windows UA never says Linux, but Android's does.
    var active = /Win(dows|32|64)/i.test(probe)
      ? 'windows'
      : /Linux/i.test(probe) && !/Android/i.test(ua)
        ? 'linux'
        : 'mac';
    var activeArch = 'default';
    // Show/hide by swapping the single display class, never stacking both.
    function setShown(el, shown) {
      el.classList.toggle(el.dataset.dlShow || 'inline-flex', shown);
      el.classList.toggle('hidden', !shown);
    }
    function resolve() {
      document.querySelectorAll('[data-voice-download]').forEach(function (root) {
        // Pick the first arch this release actually published: the one
        // we'd rather serve, then the one every machine of this platform
        // can run. `null` if it published neither, which shows no primary
        // at all — the menu is still there, and an unpublished target
        // behind a visible button is a 404, which is the one outcome
        // worse than an extra click. The same rule the menu rows follow,
        // so the two can't disagree about what exists. Decided per root
        // and per call, so the release refresh below can withdraw or
        // restore the choice by re-running this.
        var order = activeArch === 'default' ? ['default'] : [activeArch, 'default'];
        var arch = null;
        for (var i = 0; i < order.length; i++) {
          var want = root.querySelector(
            '[data-dl-primary="' + active + '"][data-dl-arch="' + order[i] + '"]',
          );
          if (want && want.dataset.dlAvail !== '0') {
            arch = order[i];
            break;
          }
        }
        root.querySelectorAll('[data-dl-primary]').forEach(function (el) {
          setShown(el, el.dataset.dlPrimary === active && el.dataset.dlArch === arch);
        });
        // A menu row hides when the primary is already downloading it. A
        // row that names no arch (the unsigned-Windows note) means every
        // build of that platform, so it hides on either of them.
        root.querySelectorAll('[data-dl-alt]').forEach(function (el) {
          var a = el.dataset.dlAltArch;
          setShown(el, !(el.dataset.dlAlt === active && (!a || a === arch)));
        });
      });
      // Show only the active platform's caption and note, matching the
      // single control. Keyed on platform alone: the two Windows builds
      // share a version and both meet SmartScreen. These <p> have no
      // display utility, so toggling `hidden` alone is safe. Caption
      // lines can sit after this script in the page, so DOMContentLoaded
      // catches them — controls swap synchronously (no flicker).
      document.querySelectorAll('[data-dl-meta],[data-dl-note]').forEach(function (el) {
        var key = el.dataset.dlMeta || el.dataset.dlNote;
        el.classList.toggle('hidden', key !== active);
      });
    }
    // Exposed so the release refresh above can re-run the promotion when
    // it learns a target appeared or vanished since the build.
    window.__wkResolveDownload = resolve;
    resolve();
    document.addEventListener('DOMContentLoaded', resolve);

    // The arch probe now runs for Linux too, not just Windows. macOS is the
    // one platform that skips it: we publish a single arm64 build there, so
    // there is no second architecture to promote to.
    var uad = navigator.userAgentData;
    if (active === 'mac' || !uad || !uad.getHighEntropyValues) return;
    uad
      .getHighEntropyValues(['architecture', 'bitness'])
      .then(function (h) {
        // Chromium reports the chip as 'arm' with a separate bitness, so
        // both halves are checked: 32-bit ARM exists on both Windows and
        // Linux and cannot run these packages. Anything else keeps x64.
        if (!h || h.architecture !== 'arm' || h.bitness !== '64') return;
        activeArch = 'arm64';
        resolve();
      })
      .catch(function () {});
  })();
</script>

<script is:inline>
  // Native <details> only toggles via its <summary>, so a menu stays open
  // when you click elsewhere. Close any open one on an outside click or
  // the Escape key, the way a menu is expected to behave.
  (function () {
    document.addEventListener('click', function (e) {
      document.querySelectorAll('[data-dl-more][open]').forEach(function (d) {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('[data-dl-more][open]').forEach(function (d) {
        d.removeAttribute('open');
      });
    });
  })();
</script>
