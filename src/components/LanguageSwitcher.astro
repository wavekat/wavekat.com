---
// Global language switcher — a proper accessible dropdown for the header.
// Self-contained: derives the current locale and the per-language targets from
// the URL, so it works on any page without props. Links to the translated page
// when it exists, otherwise to that locale's home (never a dead 404).
import { Globe, Check, ChevronDown } from '@lucide/astro';
import { resolveLocale, switcherItems, localeLabel, t } from '../lib/i18n';

const { code: lang, basePath } = resolveLocale(Astro.url.pathname);
const items = switcherItems(basePath, lang);

// Only worth showing when there's more than one language to choose from.
const show = items.length > 1;
const current = localeLabel(lang);
const label = t(lang).switcherLabel;
---

{show && (
  <div class="relative" data-lang-switcher>
    <button
      type="button"
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={label}
      data-lang-trigger
      class="flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-900/5 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-gray-200"
    >
      <Globe class="h-3.5 w-3.5" />
      <span>{current}</span>
      <ChevronDown class="h-3 w-3 transition-transform" data-lang-chevron />
    </button>

    <div
      data-lang-menu
      hidden
      role="menu"
      class="absolute right-0 top-full z-40 mt-2 hidden min-w-[10rem] flex-col gap-0.5 rounded-xl border border-gray-200 bg-white/95 p-1.5 shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-wk-surface/95"
    >
      {items.map((item) => (
        <a
          href={item.href}
          hreflang={item.code}
          lang={item.code}
          role="menuitem"
          aria-current={item.current ? 'true' : undefined}
          class:list={[
            'flex items-center gap-2 rounded px-2.5 py-1.5 text-xs transition-colors hover:bg-gray-100 dark:hover:bg-white/5',
            item.current
              ? 'font-bold text-gray-900 dark:text-white'
              : 'text-gray-600 dark:text-gray-300',
          ]}
        >
          {item.current ? (
            <Check class="h-3.5 w-3.5 shrink-0" style="color: #ff6d00" />
          ) : (
            <span class="h-3.5 w-3.5 shrink-0" aria-hidden="true"></span>
          )}
          {item.label}
        </a>
      ))}
    </div>
  </div>
)}

<script is:inline>
  // Accessible dropdown: toggle on click, close on outside-click or Escape.
  (function () {
    document.querySelectorAll('[data-lang-switcher]').forEach(function (root) {
      const trigger = root.querySelector('[data-lang-trigger]');
      const menu = root.querySelector('[data-lang-menu]');
      const chevron = root.querySelector('[data-lang-chevron]');
      if (!trigger || !menu) return;
      function open(show) {
        menu.hidden = !show;
        menu.classList.toggle('hidden', !show);
        menu.classList.toggle('flex', show);
        trigger.setAttribute('aria-expanded', show ? 'true' : 'false');
        if (chevron) chevron.classList.toggle('rotate-180', show);
      }
      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        open(menu.hidden);
      });
      document.addEventListener('click', function (e) {
        if (!root.contains(e.target)) open(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') open(false);
      });
    });
  })();
</script>
