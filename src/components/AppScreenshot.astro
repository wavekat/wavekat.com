---
// A locale- and theme-aware product screenshot.
//
// Picks the screenshot for the page's current language (falling back to English
// when a locale is missing) and renders both the light and dark variants,
// swapped with the site's existing `dark:` class — so the shot always matches
// the page theme with no JS. Wrapped in a lightweight, OS-neutral window frame
// the site draws itself (consistent with the rest of the page, and right for a
// Mac + Linux product).
//
// Shots sit inline at a modest size (kept narrow so they read as figures, not
// full-bleed walls) and are click-to-zoom: tapping one opens a full-size
// lightbox in the page's current theme. ESC or a click closes it.
//
// Source images are committed under src/assets/screenshots/<scene>/<code>-<theme>.webp
// by scripts/sync-screenshots.js; Astro re-encodes responsive WebP at build.
//
//   <AppScreenshot scene="in-call" priority class="mx-auto max-w-2xl" />  // hero
//   <AppScreenshot scene="history" class="max-w-sm" showCaption />        // small + caption
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Maximize2 } from "@lucide/astro";
import { resolveLocale } from "../lib/i18n";
import { screenshotCaption } from "../lib/screenshots";

interface Props {
  /** Scene id, e.g. "in-call" — matches a folder under src/assets/screenshots/. */
  scene: string;
  /** Override the localized alt/caption text. */
  caption?: string;
  /** Render the caption visibly under the frame (it's always the alt text). */
  showCaption?: boolean;
  /** Eager-load + above-the-fold hint, for a hero shot. */
  priority?: boolean;
  /** Extra classes on the <figure> (sizing/margins — e.g. "mx-auto max-w-xl"). */
  class?: string;
}

const {
  scene,
  caption,
  showCaption = false,
  priority = false,
  class: className = "",
} = Astro.props;

const { code } = resolveLocale(Astro.url.pathname);

// Eager glob so we can index by path and pick the right (scene, locale, theme).
const all = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/screenshots/**/*.webp",
  { eager: true },
);

function pick(theme: "light" | "dark"): ImageMetadata | undefined {
  for (const c of [code, "en"]) {
    const hit = all[`../assets/screenshots/${scene}/${c}-${theme}.webp`];
    if (hit) return hit.default;
  }
  return undefined;
}

const light = pick("light");
const dark = pick("dark");
const alt = caption ?? screenshotCaption(scene, code);

// Inline display is modest (a figure, not full-bleed); the lightbox shows
// detail. Give the browser sensible responsive steps up to the inline cap.
const widths = [360, 540, 720, 1080];
const sizes = "(min-width: 768px) 640px, 100vw";

if (!light && import.meta.env.DEV) {
  console.warn(`[AppScreenshot] no image for scene "${scene}" (locale ${code})`);
}
---

{
  light && (
    <figure class={`not-prose ${className}`}>
      <button
        type="button"
        data-zoom
        data-zoom-light={light.src}
        data-zoom-dark={(dark ?? light).src}
        data-zoom-alt={alt}
        aria-label={`${alt} — enlarge`}
        class="group relative block w-full p-0 m-0 text-left cursor-zoom-in overflow-hidden rounded-xl border border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-wk-surface shadow-xl shadow-black/5 dark:shadow-black/40 transition-shadow hover:shadow-2xl"
      >
        {/* OS-neutral title bar */}
        <span class="flex items-center gap-1.5 h-8 px-3.5 border-b border-gray-200 dark:border-white/10">
          <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15" />
          <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15" />
          <span class="w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/15" />
          <span class="ml-auto inline-flex items-center text-gray-400 dark:text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity">
            <Maximize2 class="w-3.5 h-3.5" />
          </span>
        </span>
        <Image
          src={light}
          alt={alt}
          widths={widths}
          sizes={sizes}
          loading={priority ? "eager" : "lazy"}
          class="block dark:hidden w-full h-auto"
        />
        {dark && (
          <Image
            src={dark}
            alt={alt}
            widths={widths}
            sizes={sizes}
            loading={priority ? "eager" : "lazy"}
            class="hidden dark:block w-full h-auto"
          />
        )}
      </button>
      {showCaption && (
        <figcaption class="mt-3 text-center text-xs text-gray-400 dark:text-gray-600">
          {alt}
        </figcaption>
      )}
    </figure>
  )
}

<style is:global>
  #screenshot-lightbox {
    border: 0;
    padding: 0;
    margin: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    background: transparent;
  }
  #screenshot-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(2px);
  }
</style>

<script>
  // One delegated handler for every <AppScreenshot> on the page. The dialog is
  // created lazily on first use, and the variant shown matches the page theme
  // at click time.
  function ensureDialog(): HTMLDialogElement {
    let dlg = document.getElementById(
      "screenshot-lightbox",
    ) as HTMLDialogElement | null;
    if (dlg) return dlg;
    dlg = document.createElement("dialog");
    dlg.id = "screenshot-lightbox";
    const wrap = document.createElement("div");
    wrap.style.cssText =
      "width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:clamp(1rem,4vw,3rem);cursor:zoom-out;";
    const img = document.createElement("img");
    img.style.cssText =
      "max-width:100%;max-height:100%;object-fit:contain;border-radius:0.75rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.6);";
    wrap.appendChild(img);
    dlg.appendChild(wrap);
    document.body.appendChild(dlg);
    // Click anywhere (backdrop or image) closes.
    dlg.addEventListener("click", () => dlg!.close());
    return dlg;
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as Element)?.closest<HTMLElement>("[data-zoom]");
    if (!trigger) return;
    const dark = document.documentElement.classList.contains("dark");
    const src = dark ? trigger.dataset.zoomDark : trigger.dataset.zoomLight;
    if (!src) return;
    const dlg = ensureDialog();
    const img = dlg.querySelector("img")!;
    img.src = src;
    img.alt = trigger.dataset.zoomAlt || "";
    dlg.showModal();
  });
</script>
