---
import { Mail } from '@lucide/astro';
import ConversionTracking from './ConversionTracking.astro';
import { resolveLocale, t } from '../lib/i18n';

interface Props {
  marginTop?: string;
}

const { marginTop = 'mt-16' } = Astro.props;

const emailHref = 'mailto:eason@wavekat.com?subject=wavekat-voice';

const { code: lang } = resolveLocale(Astro.url.pathname);
const ui = t(lang);
---

<section class={marginTop}>
  <h2 class="mb-5 font-mono text-xs font-bold uppercase tracking-widest text-gray-400">{ui.talkHeading}</h2>
  <div class="relative overflow-hidden rounded-2xl border border-gray-200/80 bg-gray-50/50 p-7 dark:border-white/10 dark:bg-wk-surface">
    <div
      class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full opacity-15 blur-3xl"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <p class="mb-6 max-w-xl text-[15px] leading-relaxed text-gray-600 dark:text-gray-300">
        {ui.talkBody}
      </p>

      <a
        href={emailHref}
        data-conversion="mailto_click"
        class="inline-flex items-center gap-2 rounded-full bg-wk-orange px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/35"
      >
        <Mail class="w-4 h-4" />
        {ui.talkButton}
      </a>

      <p class="mt-5 text-xs leading-relaxed text-gray-400 dark:text-gray-500">
        {ui.talkWritePre}
        <a
          href={emailHref}
          data-conversion="mailto_click"
          class="text-gray-600 underline underline-offset-2 transition-colors hover:text-gray-900 dark:text-gray-300 dark:hover:text-white"
        >
          eason@wavekat.com
        </a>{ui.talkWritePost}
      </p>
    </div>
  </div>
</section>

<ConversionTracking />
