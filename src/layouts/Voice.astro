---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { resolveLocale, localesForPath, localizedPath, t } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Locale comes from the URL; the sub-nav is localised and each link stays in
// the current locale where that page is translated, else falls back to English.
const { code: lang, basePath } = resolveLocale(Astro.url.pathname);
const ui = t(lang);

const subNav = [
  { href: '/voice/', label: ui.subOverview },
  { href: '/voice/use-cases/', label: ui.subUseCases },
  { href: '/voice/alternatives/', label: ui.subAlternatives },
  { href: '/voice/download/', label: ui.subDownload },
  { href: '/voice/changelog/', label: ui.subChangelog },
  { href: '/voice/talk/', label: ui.subTalk },
];

const localeHref = (href: string) =>
  localesForPath(href).includes(lang) ? localizedPath(href, lang) : href;

// A nav item is active on its own page and on any page beneath it (e.g. the
// per-competitor /voice/alternatives/<slug>/ pages keep "alternatives" lit).
// The overview href is everyone's prefix, so it only matches exactly. Compare
// against the locale-stripped basePath so it works under /zh/ too.
const isActive = (href: string) =>
  basePath === href || (href !== '/voice/' && basePath.startsWith(href));

// Second-level pages get a Voice > page BreadcrumbList from the layout, so
// every locale is covered in one place. Deeper pages (alternatives/<slug>)
// emit their own three-level breadcrumb and are excluded here.
const crumbLabels: Record<string, string> = {
  '/voice/use-cases/': ui.subUseCases,
  '/voice/alternatives/': ui.subAlternatives,
  '/voice/download/': ui.subDownload,
  '/voice/changelog/': ui.subChangelog,
  '/voice/talk/': ui.subTalk,
};
const crumbSchema = crumbLabels[basePath]
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'WaveKat Voice',
          item: new URL(localizedPath('/voice/', lang), Astro.site).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: crumbLabels[basePath],
          item: new URL(Astro.url.pathname, Astro.site).href,
        },
      ],
    }
  : null;
---

<Base title={`${title} — WaveKat`} description={description}>
  <div class="max-w-3xl mx-auto px-6 py-12">

    <Header active="voice" />

    <!-- Sub-nav -->
    <nav class="flex flex-wrap items-center gap-3 mb-12">
      {subNav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={localeHref(item.href)}
            class={
              active
                ? 'text-xs font-bold rounded px-3 py-1 transition-colors'
                : 'text-xs text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition-colors border border-gray-200 dark:border-white/10 rounded px-3 py-1'
            }
            style={active ? 'color: #ff6d00; border: 1px solid #ff6d0060;' : ''}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <slot />

    <div class="mt-20">
      <Footer />
    </div>

  </div>

  {crumbSchema && <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />}
</Base>
