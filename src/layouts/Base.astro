---
import '../styles/global.css';
import SiteBackground from '../components/SiteBackground.astro';
import {
  resolveLocale,
  localeByCode,
  buildAlternates,
  localesForPath,
  localizedPath,
  localeLabel,
  t,
} from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    author?: string;
    tags?: string[];
  };
}

const {
  title = 'WaveKat — Open-Source AI Voice Tools for Small Business',
  description = 'WaveKat builds open-source AI voice tools for small business — a desktop app that makes your computer your business phone and records every call.',
  ogImage = '/og.png',
  ogImageAlt = 'WaveKat — open-source AI voice tools for small business',
  ogType = 'website',
  noindex = false,
  article,
} = Astro.props;

// Locale is derived from the URL, not passed in — every page is i18n-aware for
// free. '/zh/voice/' → code 'zh-Hans', basePath '/voice/'.
const { code: lang, basePath } = resolveLocale(Astro.url.pathname);
const ogLocale = localeByCode(lang)?.ogLocale ?? 'en_US';
const alternates = buildAlternates(basePath, Astro.site!);

// First-visit suggestion banner data: the *other* locales this page exists in,
// keyed by primary language subtag, with copy already in the target language.
// A tiny inline script matches navigator.language and offers a one-tap switch.
const bannerOffers = localesForPath(basePath)
  .filter((code) => code !== lang)
  .map((code) => ({
    primary: code.split('-')[0],
    href: localizedPath(basePath, code),
    label: localeLabel(code),
    text: t(code).bannerText,
    view: t(code).bannerView,
    dismiss: t(code).bannerDismiss,
  }));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Sitewide Organization + WebSite structured data. Emitted on every page so
// search engines can build a consistent entity for WaveKat (logo, social
// profiles) and surface the site name in results.
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://wavekat.com/#organization',
      name: 'WaveKat',
      url: 'https://wavekat.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://wavekat.com/logos/wavekat-icon-light.svg',
      },
      image: 'https://wavekat.com/og.png',
      description:
        'WaveKat builds open-source, AI-powered voice tools that give small businesses enterprise-grade phone capabilities.',
      sameAs: [
        'https://github.com/wavekat',
        'https://www.linkedin.com/company/wavekat/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://wavekat.com/#website',
      name: 'WaveKat',
      url: 'https://wavekat.com',
      publisher: { '@id': 'https://wavekat.com/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0e14" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />
    {alternates?.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/logos/wavekat-icon-light.svg" />
    <link rel="icon" type="image/svg+xml" href="/logos/wavekat-icon-light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/logos/wavekat-icon-dark.svg" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="WaveKat Blog" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WaveKat" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime.toISOString()} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
    )}
    {article?.author && <meta property="article:author" content={article.author} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Organization + WebSite structured data (sitewide) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load the font CSS without blocking first paint: it arrives as a
         low-priority preload and switches itself to a stylesheet once
         fetched. Blocking here cost ~950ms of mobile LCP. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
    </noscript>
    <!-- Google tag (GA4 + Google Ads) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H8ZGBL04R7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H8ZGBL04R7');
      gtag('config', 'AW-18128547216');
    </script>

    <script is:inline>
      // Apply theme before first paint to prevent flash
      const saved = localStorage.getItem('theme');
      const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      if (saved !== 'light' && (saved === 'dark' || !prefersLight)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-wk-bg text-gray-900 dark:text-gray-100 transition-colors duration-200">
    <SiteBackground />

    {bannerOffers.length > 0 && (
      <div
        id="lang-suggest"
        hidden
        class="fixed inset-x-0 top-0 z-50 hidden border-b border-gray-200 bg-white/95 backdrop-blur dark:border-white/10 dark:bg-wk-surface/95"
      >
        <div class="mx-auto flex max-w-3xl items-center gap-3 px-6 py-2.5 text-sm">
          <span id="lang-suggest-text" class="text-gray-700 dark:text-gray-200"></span>
          <a
            id="lang-suggest-view"
            href="#"
            class="ml-auto shrink-0 rounded px-3 py-1 text-xs font-bold text-white transition-opacity hover:opacity-90"
            style="background-color: #ff6d00"
          ></a>
          <button
            id="lang-suggest-dismiss"
            type="button"
            class="shrink-0 text-gray-400 transition-colors hover:text-gray-700 dark:hover:text-gray-200"
          >✕</button>
        </div>
      </div>

      <script is:inline define:vars={{ offers: bannerOffers }}>
        // Suggest, don't force: if the visitor's browser language has a
        // translation of THIS page they haven't seen, offer a one-tap switch.
        // Never redirects; the choice (or dismissal) is remembered.
        (function () {
          const KEY = 'lang-pref-dismissed';
          try { if (localStorage.getItem(KEY)) return; } catch (e) { return; }
          const langs = navigator.languages && navigator.languages.length
            ? navigator.languages : [navigator.language || ''];
          const primaries = langs.map((l) => String(l).toLowerCase().split('-')[0]);
          let offer = null;
          for (const p of primaries) {
            offer = offers.find((o) => o.primary.toLowerCase() === p);
            if (offer) break;
          }
          if (!offer) return;
          const bar = document.getElementById('lang-suggest');
          const text = document.getElementById('lang-suggest-text');
          const view = document.getElementById('lang-suggest-view');
          const dismiss = document.getElementById('lang-suggest-dismiss');
          text.textContent = offer.text;
          view.textContent = offer.view;
          view.setAttribute('href', offer.href);
          dismiss.setAttribute('aria-label', offer.dismiss);
          bar.hidden = false;
          bar.classList.remove('hidden');
          function remember() { try { localStorage.setItem(KEY, '1'); } catch (e) {} }
          view.addEventListener('click', remember);
          dismiss.addEventListener('click', function () {
            remember();
            bar.hidden = true;
            bar.classList.add('hidden');
          });
        })();
      </script>
    )}

    <slot />
  </body>
</html>
