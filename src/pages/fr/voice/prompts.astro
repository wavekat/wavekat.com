---
// French version of the standalone SEO/GEO landing page for the platform's
// free voice-prompt generator (the tool itself lives at
// platform.wavekat.com/voice/prompts, see wavekat-platform PR #161). This is
// the marketing/answer-engine front door: it explains the tool, targets the
// "free IVR / phone menu voice generator" queries, and hands off to the live
// app. It deliberately does NOT use the Voice layout — that section is the
// WaveKat Voice desktop app, a separate product — so it renders with the plain
// Base chrome, like the homepage.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  PhoneCall,
  ListOrdered,
  Voicemail,
  Clock,
  Music2,
  Sparkles,
  AudioLines,
  Languages,
  Download,
  Zap,
  ArrowRight,
  ArrowUpRight,
} from '@lucide/astro';

// The live tool. No trailing slash — matches the platform's own canonical and
// sitemap entry (apps/web/public/sitemap.xml).
const APP_URL = 'https://platform.wavekat.com/voice/prompts';

const title = 'Générateur vocal gratuit pour menus téléphoniques et SVI | WaveKat';
const description =
  'Transformez du texte en messages d\'accueil, menus SVI et messages de répondeur prêts pour la téléphonie, avec des voix IA de qualité studio — dans le format exact qu\'exige votre système téléphonique. Gratuit à essayer, sans compte.';

// What people actually search for and come to make. Each is a concrete,
// quotable phone-audio job the generator does.
const uses = [
  {
    icon: PhoneCall,
    title: 'Messages d\'accueil téléphoniques',
    body: '« Merci d\'appeler Plomberie Acme — comment pouvons-nous vous aider ? » Un accueil chaleureux et cohérent à chaque appel.',
  },
  {
    icon: ListOrdered,
    title: 'Menus SVI et standards automatiques',
    body: '« Pour le service commercial, tapez 1. Pour l\'assistance, tapez 2. » Enregistrez chaque branche de votre menu avec une seule voix.',
  },
  {
    icon: Voicemail,
    title: 'Messages de répondeur',
    body: 'Un message professionnel après le bip, pour les moments où personne ne peut décrocher.',
  },
  {
    icon: Clock,
    title: 'Messages hors horaires et jours fériés',
    body: '« Notre bureau est fermé pour les fêtes et rouvre lundi à 9 h. » Réglez-le une fois, diffusez-le au besoin.',
  },
  {
    icon: Music2,
    title: 'Annonces d\'attente',
    body: 'De brèves annonces vocales entre les musiques d\'attente — horaires d\'ouverture, une promotion, une invitation à être rappelé.',
  },
];

const features = [
  {
    icon: Sparkles,
    title: 'Des voix IA de qualité studio',
    body: 'Une sélection soignée de voix de synthèse commerciales, autorisées pour un usage téléphonique. Choisissez-en une et tout votre système sonne comme s\'il avait été enregistré en studio.',
  },
  {
    icon: AudioLines,
    title: 'Un audio prêt pour la téléphonie',
    body: 'Chaque clip sort dans les formats qu\'attendent les systèmes téléphoniques — µ-law 8 kHz, WAV ou MP3 — pour s\'intégrer directement à Asterisk, FreePBX, 3CX, Twilio et les autres, sans réencodage.',
  },
  {
    icon: Zap,
    title: 'Gratuit à essayer, sans inscription',
    body: 'Générez vos premiers clips directement dans le navigateur — sans compte, sans carte. Connectez-vous avec GitHub ou Google quand vous voulez aller plus loin et sauvegarder une bibliothèque.',
  },
  {
    icon: Languages,
    title: 'De nombreuses voix et langues',
    body: 'Choisissez parmi un éventail de voix dans plusieurs langues, pour que le message accueille vos appelants comme ils s\'attendent à l\'être.',
  },
  {
    icon: Download,
    title: 'Téléchargez et c\'est parti',
    body: 'Les fichiers se téléchargent avec un nom clair et descriptif — prêts à être chargés dans votre système téléphonique ou remis à celui qui s\'en occupe.',
  },
  {
    icon: AudioLines,
    title: 'Cohérent d\'un message à l\'autre',
    body: 'Une seule voix pour votre accueil, votre menu, votre répondeur et votre message d\'attente : vos appelants entendent une identité unique et cohérente, pas un patchwork d\'enregistrements.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Saisissez votre script',
    body: 'Rédigez l\'accueil, le menu ou le message — ou partez de l\'un des exemples intégrés et modifiez-le.',
  },
  {
    n: '2',
    title: 'Choisissez une voix',
    body: 'Choisissez parmi les voix sélectionnées et écoutez un aperçu de votre texte. Changez-en à tout moment.',
  },
  {
    n: '3',
    title: 'Téléchargez le fichier',
    body: 'Obtenez un clip prêt pour la téléphonie, dans le format qu\'exige votre système, et chargez-le. Terminé.',
  },
];

const faqs = [
  {
    q: 'Qu\'est-ce que le générateur de messages vocaux WaveKat ?',
    a: 'C\'est un outil web gratuit qui transforme du texte en audio prêt pour la téléphonie — messages d\'accueil, menus SVI et standards automatiques, messages de répondeur et annonces d\'attente — dit par des voix IA de qualité studio. Vous saisissez le script, choisissez une voix, et téléchargez un fichier que votre système téléphonique peut diffuser.',
  },
  {
    q: 'Est-ce gratuit ?',
    a: 'Oui. Vous pouvez générer vos premiers clips dans le navigateur gratuitement, sans compte. Vous connecter avec GitHub ou Google lève la limite et vous permet de sauvegarder une bibliothèque de vos messages ; un usage plus soutenu est décompté selon les mêmes offres gratuite et pro que le reste de la plateforme WaveKat.',
  },
  {
    q: 'Quel format audio est-ce que j\'obtiens, et fonctionnera-t-il avec mon système téléphonique ?',
    a: 'Les clips sortent dans les formats qu\'attendent les systèmes téléphoniques — µ-law 8 kHz, WAV et MP3 — pour s\'intégrer directement à des systèmes comme Asterisk, FreePBX, 3CX et Twilio, sans aucun réencodage. Choisissez le format que votre système demande et chargez le fichier.',
  },
  {
    q: 'Ai-je besoin d\'un compte pour l\'essayer ?',
    a: 'Non. N\'importe qui peut générer quelques clips sans s\'inscrire. Vous ne vous connectez que lorsque vous voulez continuer au-delà de l\'allocation gratuite et sauvegarder vos messages dans une bibliothèque que vous pourrez retrouver.',
  },
  {
    q: 'Puis-je utiliser les clips pour le système téléphonique de mon entreprise ?',
    a: 'Oui — c\'est précisément à cela que sert le générateur. Générez votre accueil, votre menu, votre répondeur et vos annonces d\'attente, téléchargez-les, et chargez-les dans votre système téléphonique.',
  },
  {
    q: 'Faut-il un système téléphonique pour utiliser les clips ?',
    a: 'Non. Si vous en exploitez déjà un — Asterisk, FreePBX, 3CX, Twilio ou une ligne VoIP hébergée —, téléchargez le clip et envoyez-le là-bas. Et si vous n’en avez pas, WaveKat Voice peut les diffuser : un flux d’appel répond aux appels entrants avec un accueil, un menu téléphonique et une messagerie, et ce même générateur met chaque étape en voix d’un seul clic.',
    link: { href: '/fr/blog/answer-calls-with-a-call-flow/', label: 'Comment marchent les flux' },
  },
  {
    q: 'En quoi est-ce différent de WaveKat Voice, l\'application ?',
    a: 'WaveKat Voice est une application de bureau qui transforme votre ordinateur en téléphone professionnel — recevoir et passer des appels, enregistrés et retranscrits. Le générateur de messages vocaux est un outil web gratuit distinct qui crée les messages d\'accueil et les menus que votre système téléphonique diffuse. Ils se complètent, mais vous pouvez utiliser l\'un ou l\'autre séparément.',
    link: { href: '/fr/voice/', label: 'À propos de WaveKat Voice' },
  },
];

// The app itself, for software rich results and AI answer engines. `url` points
// at the live tool (matching the platform's own WebApplication declaration), so
// engines bind one entity to one canonical app URL; this page is its marketing
// front door, referenced by the sitewide Organization.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'WaveKat Voice Prompt Generator',
  url: APP_URL,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires a modern web browser',
  isAccessibleForFree: true,
  image: 'https://wavekat.com/og.png',
  inLanguage: 'fr',
  description:
    'Un outil web gratuit qui transforme du texte en audio téléphonique prêt à l\'emploi — messages d\'accueil, menus SVI et messages de répondeur — à l\'aide de voix IA de qualité studio.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description}>
  <Header />

  <div class="max-w-4xl mx-auto px-6 pt-12 pb-12">
    <!-- Hero -->
    <section class="relative mb-20 pt-4">
      <!-- brand-orange glow -->
      <div
        class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
        style="background: radial-gradient(circle, var(--color-wk-orange) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="flex items-center gap-2 mb-5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-wk-orange/25 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase text-wk-orange">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse bg-wk-orange"></span>
          gratuit · essai sans inscription
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
        Générateur vocal gratuit pour<br />
        <span class="bg-gradient-to-r from-wk-orange to-[#ffa14d] bg-clip-text text-transparent">menus téléphoniques et SVI.</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
        Le générateur de messages vocaux WaveKat transforme n’importe quel texte en audio prêt pour la
        téléphonie — messages d’accueil, menus SVI, répondeur et annonces d’attente — dit par des voix IA de
        qualité studio, dans le format exact qu’exige votre système téléphonique. Essayez-le gratuitement dans
        votre navigateur ; connectez-vous pour sauvegarder une bibliothèque.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href={APP_URL}
          class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
        >
          Essayer gratuitement
          <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href="#how"
          class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          Voir comment ça marche
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-600">
        Fonctionne sur <span class="font-mono">platform.wavekat.com/voice/prompts</span> · sans téléchargement, sans carte
      </p>
    </section>

    <!-- What you can make -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Ce que vous pouvez créer</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {uses.map((u) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <u.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{u.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Pourquoi l’utiliser</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <f.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mb-16 scroll-mt-24">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Comment ça marche</h2>
      <ol class="space-y-4">
        {steps.map((s) => (
          <li class="flex gap-4">
            <span
              class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white bg-wk-orange"
            >
              {s.n}
            </span>
            <div>
              <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Try CTA -->
    <section class="mb-16">
      <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
        <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">Créez votre premier message maintenant</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
          Gratuit à essayer dans votre navigateur — sans téléchargement, sans compte. Saisissez une ligne,
          choisissez une voix, et téléchargez un clip prêt pour le téléphone en moins d’une minute.
        </p>
        <div class="flex justify-center">
          <a
            href={APP_URL}
            class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
          >
            Ouvrir le générateur de messages vocaux
            <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </section>

    <!-- Q&A -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Questions &amp; réponses</h2>
      <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
              {f.q}
              <span class="shrink-0 text-wk-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
              {f.a}
              {f.link && (
                <a
                  href={f.link.href}
                  class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
                >
                  {f.link.label}
                  <ArrowRight class="w-3 h-3" />
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- From the blog: the announcement post (the post links back here) -->
    <p class="text-xs text-gray-500 dark:text-gray-400">
      Envie d’en savoir plus sur l’outil ?
      <a
        href="/fr/blog/phone-menu-ivr-voice-generator/"
        class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
      >
        Lire l’annonce sur le blog
        <ArrowRight class="w-3 h-3" />
      </a>
    </p>
  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
