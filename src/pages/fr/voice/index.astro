---
// French version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully French. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import TalkCTA from '../../../components/TalkCTA.astro';
import {
  PhoneCall,
  Mic,
  FileText,
  Server,
  Cloud,
  Lock,
  ArrowRight,
} from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import AppScreenshot from '../../../components/AppScreenshot.astro';
import { getMacDownload, getLinuxDownload } from '../../../lib/voice-download';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

const features = [
  {
    icon: PhoneCall,
    title: 'Des appels depuis votre ordinateur',
    body: 'Recevez et passez vos appels directement depuis votre ordinateur — sans poste téléphonique, sans matériel supplémentaire, sans onglet de navigateur à surveiller. L’application reste discrètement en retrait jusqu’à ce que le téléphone sonne.',
  },
  {
    icon: Mic,
    title: 'Chaque appel enregistré',
    body: 'Chaque conversation est enregistrée automatiquement et sauvegardée dès que vous raccrochez. Réécoutez-la quand vous voulez — aucune configuration, rien à penser à activer.',
  },
  {
    icon: FileText,
    title: 'Transcription en direct',
    body: 'Voyez les mots à mesure qu’ils sont prononcés. Une transcription défile à côté de l’appel, pour saisir l’essentiel plutôt que de griffonner des notes.',
  },
  {
    icon: Server,
    title: 'Compatible avec votre opérateur',
    body: 'Gardez l’opérateur téléphonique que vous utilisez déjà — Twilio, Telnyx, 2talk, et bien d’autres. Choisissez-le dans la liste et la configuration se remplit toute seule.',
  },
  {
    icon: Cloud,
    title: 'Synchronisez si vous le souhaitez',
    body: 'Connectez-vous à votre compte WaveKat et vos enregistrements et transcriptions se synchronisent pour que vous puissiez les consulter sur le web. Ne vous connectez pas, et tout reste simplement sur votre ordinateur.',
  },
  {
    icon: Lock,
    title: 'À vous par défaut',
    body: 'Vos appels, vos enregistrements et vos transcriptions vivent d’abord sur votre propre ordinateur. Rien n’est téléversé sans votre accord — aucune entreprise mystère ne s’interpose entre vous et vos clients.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Connectez votre numéro',
    body: 'Connectez-vous à votre opérateur téléphonique au premier lancement de l’application. Choisissez-le dans la liste et les réglages se remplissent pour vous.',
  },
  {
    n: '2',
    title: 'Prenez l’appel',
    body: 'Un point vert signifie que vous êtes en ligne et joignable. Répondez, appelez, coupez le micro, utilisez le clavier — le tout depuis votre ordinateur.',
  },
  {
    n: '3',
    title: 'Revenez-y plus tard',
    body: 'Chaque appel atterrit dans votre historique d’appels avec son enregistrement et sa transcription, prêt à être revisité ou synchronisé sur le web.',
  },
];

const faqs = [
  {
    q: 'Qu’est-ce que WaveKat Voice, exactement ?',
    a: 'Une application de bureau qui transforme votre ordinateur en téléphone professionnel. Vous vous connectez avec votre opérateur téléphonique, et dès lors vous pouvez recevoir et passer des appels directement depuis votre ordinateur — chaque appel étant enregistré et retranscrit pour vous.',
  },
  {
    q: 'Ai-je besoin d’un matériel particulier ?',
    a: 'Non. Si vous avez un ordinateur et un compte chez un opérateur téléphonique, vous avez tout ce qu’il faut. Pas de poste téléphonique, pas d’équipement supplémentaire — un casque est appréciable, mais pas indispensable.',
  },
  {
    q: 'Avec quels opérateurs téléphoniques est-il compatible ?',
    a: 'La plupart des opérateurs courants — Twilio, Telnyx, 2talk, et bien d’autres. Nous remplissons la configuration des opérateurs que nous connaissons ; pour les autres, vous pouvez saisir les détails vous-même. Si vous passez déjà des appels professionnels par Internet, votre opérateur est presque certainement compatible.',
  },
  {
    q: 'Où sont conservés mes enregistrements et mes transcriptions ?',
    a: 'Sur votre ordinateur. Rien n’est téléversé sans votre décision. Si vous vous connectez à un compte WaveKat, vos enregistrements et transcriptions peuvent se synchroniser pour que vous les consultiez sur le web — sinon, ils ne quittent jamais votre ordinateur.',
  },
  {
    q: 'Est-ce gratuit ?',
    a: 'L’utilisation est gratuite pendant la bêta, le temps de le peaufiner avec de vraies entreprises. WaveKat Voice deviendra un produit payant plus tard — les utilisateurs de la bêta seront prévenus largement à l’avance avant tout changement.',
  },
  {
    q: 'Sur quoi fonctionne-t-il ?',
    a: `Mac et Linux. Sur macOS, il fonctionne à partir de la version 12 (${macDownload.arch}) ; sur Linux, c’est un paquet .deb pour ${linuxDownload.arch}.`,
  },
  {
    q: 'Prendrez-vous en charge Windows ou d’autres appareils ?',
    a: 'WaveKat Voice fonctionne aujourd’hui sur Mac et Linux. Windows et d’autres plateformes sont tout à fait envisageables — nous les développons simplement lorsqu’il y a une réelle demande. Donc si vous utiliseriez WaveKat Voice sur Windows ou ailleurs, dites-le-nous. Plus les demandes sont nombreuses, plus cela arrivera vite.',
    link: { href: '/fr/voice/talk/', label: 'Dites-nous ce qu’il vous faut' },
  },
  {
    q: 'Va-t-il ralentir ou perturber mon ordinateur ?',
    a: 'C’est une application de bureau légère qui reste en retrait jusqu’à l’arrivée d’un appel, et qui se met à jour discrètement en arrière-plan. Vous l’installez une fois et vous oubliez qu’elle est là.',
  },
];

// Localised structured data: same shape as the English page, but with the
// French URL and inLanguage so engines bind this variant to fr.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Linux',
  url: 'https://wavekat.com/fr/voice/',
  inLanguage: 'fr',
  softwareVersion: macDownload.version,
  downloadUrl: 'https://wavekat.com/fr/voice/download/',
  description:
    'Une application de bureau qui transforme votre ordinateur en téléphone professionnel — recevez et passez des appels, chaque appel étant enregistré et retranscrit. Compatible avec l’opérateur téléphonique que vous utilisez déjà.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — votre téléphone professionnel, sur votre ordinateur"
  description="WaveKat Voice est une application de bureau pour Mac et Linux qui transforme votre ordinateur en téléphone professionnel — recevez et passez des appels, chaque conversation étant enregistrée et retranscrite pour vous. Bêta publique gratuite."
>
  <!-- Hero -->
  <section class="relative mb-20 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        bêta publique gratuite
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      Votre ligne professionnelle,<br />sur votre ordinateur.<br />
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">Enregistrée et retranscrite.</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      WaveKat Voice est une application téléphonique pour votre ordinateur. Connectez l’opérateur téléphonique
      que vous utilisez déjà, et recevez et passez vos appels directement depuis votre ordinateur — chaque conversation
      étant automatiquement enregistrée et retranscrite pour vous, sans que rien ne quitte votre ordinateur sauf si vous le souhaitez.
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <VoiceDownload />
      <a
        href="/fr/voice/download/"
        class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        Détails d’installation
        <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {macDownload.arch} · <a href="/fr/voice/changelog/" title="Découvrez les nouveautés de cette version" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{macDownload.version}</a> · gratuit pendant la bêta</p>
      <p data-dl-meta="linux" class="hidden">Linux · {linuxDownload.arch} · <a href="/fr/voice/changelog/" title="Découvrez les nouveautés de cette version" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{linuxDownload.version}</a> · gratuit pendant la bêta</p>
    </div>
  </section>

  <!-- A look at the app: the call in progress, recorded and transcribed -->
  <AppScreenshot scene="in-call" priority class="mb-16 mt-0" />

  <!-- Features -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Ce qu’il fait</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((f) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors" style="background-color: #ff6d0014;">
            <f.icon class="w-4 h-4" style="color: #ff6d00" />
          </span>
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Comment ça marche</h2>
    <ol class="space-y-10">
      {steps.map((s, i) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div class="min-w-0 flex-1">
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
            <AppScreenshot
              scene={["add-account", "incoming-call", "history"][i]}
              class="mt-4 mb-0"
            />
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">À qui ça s’adresse</h2>
    <a
      href="/fr/voice/use-cases/"
      class="group block rounded border border-gray-200 dark:border-white/10 p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
    >
      <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">Les entreprises qui vivent au téléphone</span>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
        Cliniques, salons, artisans, cabinets d’avocats, restaurants, gestionnaires immobiliers — tous ceux
        pour qui un appel est un client. Découvrez où WaveKat Voice trouve sa place.
      </p>
      <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
        wavekat.com/voice/use-cases →
      </span>
    </a>
  </section>

  <!-- Download CTA -->
  <section class="mb-16">
    <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
      <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">Envie de l’essayer ?</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
        Gratuit pendant la bêta publique. Installez-le en une minute, connectez votre numéro et prenez votre prochain appel depuis votre ordinateur.
      </p>
      <div class="flex justify-center">
        <VoiceDownload variant="cta" />
      </div>
    </div>
  </section>

  <!-- Q&A -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Questions &amp; réponses</h2>
    <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
      {faqs.map((f) => (
        <details class="group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
            {f.q}
            <span class="shrink-0 text-gray-400 transition-transform group-open:rotate-45" style="color: #ff6d00" aria-hidden="true">+</span>
          </summary>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
            {f.a}
            {f.link && (
              <a
                href={f.link.href}
                class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity"
                style="color: #ff6d00"
              >
                {f.link.label}
                <ArrowRight class="w-3 h-3" />
              </a>
            )}
          </p>
        </details>
      ))}
    </div>
  </section>

  <TalkCTA />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
