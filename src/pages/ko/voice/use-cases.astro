---
import Voice from '../../../layouts/Voice.astro';
import TalkCTA from '../../../components/TalkCTA.astro';
import AppScreenshot from '../../../components/AppScreenshot.astro';

const cases = [
  {
    title: '병의원과 치과',
    pain: '프런트 데스크의 노트북에서 예약 전화를 받고, 환자마다 무엇을 요청했는지 녹음과 전사로 남겨 두세요.',
  },
  {
    title: '미용실과 스파',
    pain: '탁상 전화기 없이 손님 사이사이 전화를 받고, 메모를 놓쳐서 예약 정보를 잃는 일이 없도록 하세요.',
  },
  {
    title: '기술직 — 배관공, 전기공, 냉난방',
    pain: '현장에서 노트북으로 전화를 받으면, 주소와 작업 내용 설명이 전사로 그대로 담깁니다.',
  },
  {
    title: '법률사무소(상담 접수)',
    pain: '상담 접수 통화 옆에 그대로 받아쓴 전사가 함께 생성되어, 가장 중요한 첫 몇 분 동안 오간 말이 하나도 새지 않습니다.',
  },
  {
    title: '식당과 포장 주문',
    pain: '바쁜 시간에도 한 화면에서 예약과 주문을 처리하세요 — 어떤 세부 내용이 헷갈릴 때를 위해 녹음이 거기에 있습니다.',
  },
  {
    title: '부동산 관리',
    pain: '어디서든 임차인과 수리 관련 전화를 받고, 누가 전화했고 무엇이 필요했는지 검색 가능한 기록으로 남기세요.',
  },
];
---

<Voice
  title="적용 사례"
  description="WaveKat Voice가 가장 잘 맞는 곳 — 전화로 굴러가며, 통화·녹음·전사를 한곳에 모아 두어야 하는 소상공인을 위한 앱입니다."
>
  <section class="mb-12">
    <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
      누구를 위한 앱인가
    </h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      WaveKat Voice는 전화로 굴러가는 모든 소상공인에게 잘 맞습니다. 당신의 컴퓨터를 업무 전화로 바꾸고,
      모든 통화를 녹음하고 전사하며, 이 모든 것을 검색 가능한 하나의 기록에 담아 둡니다.
      가장 큰 도움이 되는 곳을 소개합니다.
    </p>
  </section>

  <AppScreenshot scene="call-details" class="mb-12" />

  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">예시</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {cases.map((c) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{c.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{c.pain}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">당신의 업종이 안 보이나요?</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
      이 목록은 우리가 시작하는 지점일 뿐 — 우리가 그 안에만 머무른다는 뜻은 아닙니다. 당신의 사업이
      전화로 굴러간다면, WaveKat Voice는 분명 손에 익은 듯 편할 것입니다. 다운로드해서 직접 확인하거나, 당신의 상황을 알려 주세요.
    </p>
  </section>

  <TalkCTA />
</Voice>
