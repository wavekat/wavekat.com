---
import Voice from '../../../layouts/Voice.astro';
import { PhoneCall, Mic, FileText } from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getDownload } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const linuxDownload = await getDownload('linux-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

const steps = [
  {
    n: '1',
    title: '설치하기',
    body: 'Mac에서는 App Store가 WaveKat Voice를 설치해 주며, "응용 프로그램" 폴더에서 열 수 있습니다. Windows에서는 Microsoft Store가 같은 일을 합니다. 직접 내려받은 경우에는 Mac에서 .dmg 파일을 더블 클릭하고 WaveKat Voice를 "응용 프로그램" 폴더로 끌어다 놓거나, Windows에서 .exe 파일을 실행합니다. Linux에서는 소프트웨어 설치 프로그램으로 .deb 파일을 열거나, 터미널에서 apt 또는 dpkg로 설치합니다.',
  },
  {
    n: '2',
    title: '실행하기',
    body: '설치가 끝나면 WaveKat Voice를 엽니다. 평소에는 조용히 한쪽에 머물러 있다가 전화가 울리면 언제든 준비된 상태가 됩니다.',
  },
  {
    n: '3',
    title: '번호 연결하기',
    body: '짧은 설정 과정이 전화 사업자 로그인을 안내합니다 — 목록에서 선택하면 나머지는 저희가 채워드립니다.',
  },
];

// These steps are about the DIRECT .exe only. The Microsoft Store package
// is signed by Microsoft and installs without a warning, so a visitor who
// takes the button never sees any of this — it is here for the one who
// opens Other Platforms and takes the file instead. The download menu's
// "how to get past it" link points at #windows below, deliberately here
// and not at /docs/**, which is English-only.
const windowsSteps = [
  'SmartScreen 창에서 "추가 정보"를 클릭합니다.',
  '"실행"을 클릭한 뒤 설치 마법사를 따라갑니다.',
  '이것으로 끝입니다 — 다음부터 Windows는 묻지 않고, 업데이트도 조용히 설치됩니다.',
];

const highlights = [
  { icon: PhoneCall, text: '컴퓨터에서 전화를 걸고 받기' },
  { icon: Mic, text: '모든 통화를 여러분의 컴퓨터에 녹음' },
  { icon: FileText, text: '말하는 동안 실시간 글자 기록' },
];
---

<Voice
  title="WaveKat Voice 다운로드"
  description="Mac, Windows, Linux용 WaveKat Voice 다운로드 — 모든 통화를 녹음하고 글로 받아 적어주는 전화 앱입니다. 베타 기간에는 무료."
>
  <!-- Hero / download -->
  <section class="relative mb-16 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-72 h-72 sm:w-[28rem] sm:h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        무료 공개 베타
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">WaveKat Voice</span> 다운로드
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      여러분의 업무용 전화를 데스크톱으로 — 전화를 걸고 받으며, 모든 대화를 녹음하고 글로 받아 적어드립니다.
      전화 사업자를 연결하면 몇 분 안에 바로 사용할 수 있습니다.
    </p>

    <VoiceDownload />

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {ui.dlArchMac} · Mac App Store에서 무료 · <a href="/ko/voice/changelog/" title="이 버전의 변경 사항 보기" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
      <p data-dl-meta="linux" class="hidden">Linux · <a href="/ko/voice/changelog/" title="이 버전의 변경 사항 보기" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="linux">{linuxDownload?.version}</span></a> · <span data-dl-size="linux">{linuxDownload?.size}</span></p>
      <p data-dl-meta="windows" class="hidden">{ui.dlArchMsStore} · Microsoft Store에서 무료 · <a href="/ko/voice/changelog/" title="이 버전의 변경 사항 보기" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
    </div>
  </section>

  <!-- What you get -->
  <section class="mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {highlights.map((h) => (
        <div class="rounded p-4 bg-gray-50 dark:bg-wk-surface flex items-start gap-3">
          <h.icon class="w-4 h-4 mt-0.5 shrink-0" style="color: #ff6d00" />
          <span class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">{h.text}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Getting set up -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">설정 시작하기</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Installing on Windows -->
  <section id="windows" class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Windows에 설치하기</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-4">
      WaveKat Voice는 Windows 10과 11용으로 Microsoft Store에 올라와 있고, 이것이 Windows에 설치하는 가장 간단한 방법입니다. 하나의 스토어 페이지가 Intel·AMD PC와 ARM PC를 모두 아우르므로, 스토어가 여러분의 PC에 맞는 빌드를 건네주고 계속 업데이트합니다. 패키지에 Microsoft가 서명하기 때문에 첫 실행 시 보안 경고도 나타나지 않습니다.
    </p>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-5">
      "다른 플랫폼"에 있는 .exe 직접 다운로드는 아직 코드 서명이 되어 있지 않아, 처음 실행하면 Windows SmartScreen의 파란색 "Windows의 PC 보호" 창이 나타납니다. 아직 구입하지 않은 인증서에 대한 경고일 뿐 파일 자체의 문제가 아니며, 아래 순서대로 진행하면 됩니다.
    </p>
    <ol class="space-y-3 mb-5 max-w-xl">
      {windowsSteps.map((s, i) => (
        <li class="flex gap-3">
          <span
            class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold text-white"
            style="background-color: #ff6d00"
          >
            {i + 1}
          </span>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed pt-0.5">{s}</p>
        </li>
      ))}
    </ol>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      직접 내려받는 두 빌드는 모두 "다른 플랫폼"에 있고, 어느 쪽을 받을지는 여러분이 고릅니다. "Windows용 다운로드"는 Intel과 AMD PC를 위한 64비트 버전이고, "ARM용 Windows 다운로드"는 Snapdragon 등 ARM PC를 위한 네이티브 버전입니다.
    </p>
  </section>

  <!-- What you'll need -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">필요한 것</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-3">
      전화 사업자 계정 — Twilio, Telnyx, 2talk 등입니다. 어떤 인터넷 전화에서든 사용하는 것과 같은
      로그인이며, 이미 온라인으로 업무용 전화를 걸고 있다면 여러분의 사업자는 거의 틀림없이 사용할 수 있습니다.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      어디서 시작해야 할지 모르시겠나요? 저희
      <a href="/docs/voice/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">설정 가이드</a>
      가 사업자 선택부터 첫 통화 연결까지 안내해 드립니다.
    </p>
  </section>

  <!-- Updates -->
  <section class="mb-4">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">최신 상태 유지</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3">
      WaveKat Voice는 스스로 최신 상태를 유지합니다. Mac App Store나 Microsoft Store에서 받은 앱은 다른 스토어 앱과 똑같이 업데이트되고,
      직접 내려받은 앱은 백그라운드에서 조용히 새 버전을 확인하고 업데이트합니다. 어느 쪽이든 새 버전을 받으러 다시 이곳에 올 필요가 없습니다.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      <a href="/ko/voice/changelog/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">각 버전의 새로운 내용 보기 →</a>
    </p>
  </section>
</Voice>
