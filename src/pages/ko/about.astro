---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Mail } from '@lucide/astro';

// Mirrors /about/ section-for-section (see src/pages/about.astro).
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://wavekat.com/ko/about/',
      url: 'https://wavekat.com/ko/about/',
      name: "WaveKat 소개",
      inLanguage: 'ko',
      mainEntity: { '@id': 'https://wavekat.com/#organization' },
    },
  ],
};
---

<Base
  title="소개 — WaveKat"
  description="WaveKat은 모든 작은 비즈니스가 큰 기업의 목소리를 갖도록 오픈소스 AI 음성 도구를 만듭니다. 무엇을 왜 만드는지, 그리고 어떻게 연락할 수 있는지 소개합니다."
>
  <Header />

  <div class="max-w-3xl mx-auto px-6 py-12">

    <section class="mb-16">
      <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
        WaveKat 소개
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl" set:html={"WaveKat은 작은 비즈니스를 위한 오픈소스 AI 음성 도구를 만드는 작고 독립적인 소프트웨어 회사입니다. 대표 제품인 <a href=\"/ko/voice/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat Voice</a>는 Mac과 Linux용 데스크톱 소프트폰으로, 모든 통화를 자동으로 녹음하고 텍스트로 옮깁니다. WaveKat은 창립자 Eason Guo가 만들며, 그는 WaveKat Voice와 그 기반이 되는 오픈소스 Rust 라이브러리를 개발합니다."} />
    </section>

    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">WaveKat이 존재하는 이유</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3" set:html={"우리의 미션은 <strong class=\"text-gray-700 dark:text-gray-200\">모든 작은 비즈니스에 큰 기업의 목소리를</strong> 주는 것입니다. 큰 회사에는 교환대, 통화 녹음, 전사 기록, 그리고 이를 움직이는 소프트웨어가 있습니다. 1인 가게에는 바쁜 주머니 속 전화기 한 대뿐이죠. WaveKat은 그 격차를 좁히는 도구를 만듭니다 — 전화에서 시작하는 이유는, 작은 비즈니스가 매일 전화에서 고객을 얻고 잃기 때문입니다."} />
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
        음성은 시작일 뿐, 전부가 아닙니다.
      </p>
    </section>

    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">우리가 만드는 것</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3" set:html={"<a href=\"/ko/voice/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat Voice</a>는 컴퓨터를 비즈니스 전화로 바꿉니다. 이미 사용 중인 SIP 사업자를 통해 전화를 걸고 받으며, 모든 통화가 내 컴퓨터에서 녹음되고 텍스트로 기록됩니다. 공개 베타 기간에는 무료이며, <a href=\"/ko/blog/place-calls-from-the-command-line/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">AI 어시스턴트가 대신 걸게</a> 할 수도 있습니다."} />
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl" set:html={"그 아래에는 오픈소스 Rust 라이브러리들 — 음성 활동 감지, 턴 감지, 음성 인식, 음성 합성, SIP/RTP 전송 — 이 있으며, 모두 <a href=\"https://github.com/wavekat\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat GitHub 조직</a>에 공개되어 있고 <a href=\"/docs/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">문서</a>도 갖추고 있습니다. 공개적으로 만드는 것이 우리를 정직하게 합니다. 당신의 통화를 다루는 코드를 직접 읽어볼 수 있으니까요."} />
    </section>

    <section class="mb-20">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">연락하기</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-5" set:html={"이메일이 가장 좋은 연락 방법입니다 — 모든 메시지를 읽습니다. WaveKat Voice에 대한 질문은 <a href=\"/ko/voice/talk/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">문의하기</a> 페이지에서 시작해 보세요."} />
      <a
        href="mailto:eason@wavekat.com"
        data-conversion="mailto_click"
        class="inline-flex items-center gap-2 rounded px-4 py-2.5 text-xs font-bold text-white transition-opacity hover:opacity-90"
        style="background-color: #ff6d00"
      >
        <Mail class="w-4 h-4" />
        eason@wavekat.com
      </a>
    </section>

  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
</Base>
