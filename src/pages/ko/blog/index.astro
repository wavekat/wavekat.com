---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { itemListSchema } from '../../../lib/seo';

// Korean posts live under src/content/blog/ko/ (id "ko/<slug>").
// Strip the locale prefix so the cards link to /ko/blog/<slug>/.
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'ko'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/^ko\//, '');

const listSchema = itemListSchema('WaveKat Blog', new URL(Astro.url.pathname, Astro.site!).href, posts.map((p) => ({ name: p.data.title, url: new URL(`/ko/blog/${slugOf(p.id)}/`, Astro.site!).href })));
---

<Base title="블로그 — WaveKat" description="WaveKat 팀의 엔지니어링 노트, 제품 소식, 그리고 심층 기술 글입니다.">
  <div class="max-w-3xl mx-auto px-6 py-12">

    <Header active="blog" />

    <!-- Blog listing -->
    <section class="mb-20">
      <h1 class="text-2xl font-bold leading-snug mb-3 text-gray-900 dark:text-white">블로그</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-10">
        WaveKat 팀의 엔지니어링 노트, 제품 소식, 그리고 심층 기술 글입니다.
      </p>

      {posts.length === 0 ? (
        <p class="text-sm text-gray-400 dark:text-gray-600">아직 글이 없습니다. 곧 다시 확인해 주세요.</p>
      ) : (
        <div class="grid gap-3">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              slug={slugOf(post.id)}
              hrefBase="/ko/blog/"
              dateLocale="ko"
            />
          ))}
        </div>
      )}
    </section>

    <Footer />

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
</Base>
