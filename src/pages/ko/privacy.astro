---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Mail } from '@lucide/astro';

// Mirrors /privacy/ section-for-section (see src/pages/privacy.astro).
// Keep the date in sync with the English page — one policy, one revision.
const updated = new Date('2026-08-04');
const updatedLabel = `${updated.getFullYear()}년 ${updated.getMonth() + 1}월 ${updated.getDate()}일`;

// Section id → heading, in document order. Ids match the English page so a
// deep link survives a language switch.
const S = {
  controller: '내 데이터는 누가 책임지나',
  website: '이 웹사이트가 수집하는 것',
  cookies: '쿠키와 브라우저 저장소',
  signin: '로그인, 그리고 계정에 저장되는 것',
  app: 'WaveKat Voice가 컴퓨터에 저장하는 것',
  account: 'WaveKat 계정에 동기화되는 것',
  sharing: '녹음을 다른 사람과 공유하기',
  integrations: '연결한 서비스로 통화 보내기',
  prompts: '음성 안내 생성기',
  telemetry: '오류 보고와 설치 수 집계',
  providers: '그 밖에 누가 데이터를 처리하나',
  retention: '각 데이터의 보관 기간',
  deletion: '데이터 삭제하기',
  rights: '나의 권리',
  security: '보안, 그리고 약속할 수 없는 것',
  children: '아동',
  changes: '이 방침의 변경',
  faq: '자주 묻는 질문',
  contact: '문의하기',
};

const faqs = [
  {
    q: 'WaveKat이 내 통화를 듣나요?',
    a: '아니요. WaveKat Voice는 통화를 여러분 자신의 컴퓨터에서 녹음하고 전사하며, 음성 인식도 로컬에서 실행됩니다. 전사를 위해 오디오가 어디론가 전송되는 일은 없습니다. 녹음과 전사가 컴퓨터 밖으로 나가는 경우는 WaveKat 계정에 로그인하고 클라우드 동기화를 켜 둔 때뿐입니다. 오류 보고에는 통화 오디오, 전화번호, 연락처가 절대 포함되지 않습니다.',
  },
  {
    q: 'wavekat.com은 쿠키를 사용하나요?',
    a: '사용합니다. Google Analytics와 Google Ads가 방문 수를 세고 광고 효과를 측정하기 위해 쿠키를 설정합니다. WaveKat 자체가 브라우저에 저장하는 것은 두 가지뿐이며 — 라이트/다크 테마 설정과 언어 안내 배너를 닫았는지 여부 — 둘 다 우리에게 전송되지 않습니다. 현재 쿠키 동의 배너는 없으며, 측정을 원치 않으면 브라우저 설정에서 분석 쿠키를 차단할 수 있습니다.',
  },
  {
    q: '내 개인 데이터를 판매하나요?',
    a: '아니요. WaveKat은 개인 데이터를 판매한 적이 없고 그럴 계획도 없습니다. 다만 이 사이트에서 Google Ads 전환 측정을 사용하는데, 미국 일부 주의 개인정보 보호법은 이를 광고 목적의 "공유"로 간주합니다. 거부하려면 hello@wavekat.com으로 메일을 보내 주세요.',
  },
  {
    q: 'WaveKat Voice를 쓰려면 WaveKat 계정이 필요한가요?',
    a: '아니요. 계정 없이 앱은 완전히 로컬로 동작합니다. 통화, 녹음, 전사, SIP 비밀번호가 모두 컴퓨터에 남습니다. 밖으로 나가는 것은 익명 오류 보고와 익명 설치 수뿐이며, "설정 → 정보"의 스위치 하나로 둘 다 끌 수 있습니다.',
  },
  {
    q: 'WaveKat으로 통화를 녹음해도 합법인가요?',
    a: '그것은 전적으로 여러분과 통화 상대가 어디에 있는지에 달려 있으며, 우리가 아니라 여러분의 책임입니다. 어떤 곳에서는 본인 동의만으로 충분하지만, 어떤 곳에서는 통화 참여자 전원의 동의가 필요하고, 잘못하면 형사 문제가 될 수도 있습니다. WaveKat Voice는 녹음되는 통화의 시작에 알림음을 재생하지만 이는 예의일 뿐, 법적 동의가 아닙니다. 확신이 없으면 녹음 중이라고 말하거나 설정에서 녹음을 끄세요.',
  },
  {
    q: 'HubSpot이나 웹훅을 연결하면 무엇이 WaveKat 밖으로 나가나요?',
    a: '연결 후의 모든 통화입니다. 상대의 번호, 통화의 시각·방향·결과·길이, 그리고 끄지 않는 한 전사 내용과 녹음 접근 권한이 전송됩니다. HubSpot에는 그 사람의 연락처에 연결된 통화 기록이 추가로 만들어지고, 일치하는 연락처가 없으면 새로 만들 수도 있습니다. 기본적으로는 아무것도 연결되어 있지 않고, 각 항목을 따로 끌 수 있으며, 연결을 끊으면 전송이 즉시 멈춥니다. 다만 이미 HubSpot에 기록된 내용은 그곳에 남으며, 삭제는 여러분이 그쪽에서 직접 해야 합니다.',
  },
  {
    q: 'WaveKat이 가진 내 데이터를 전부 지우려면?',
    a: '이 컴퓨터의 데이터는 "설정 → WaveKat 계정 → 로컬 데이터 삭제"로 통화 기록, 녹음, 전사, 로그인 상태가 지워집니다. WaveKat 계정에 동기화된 데이터는 hello@wavekat.com으로 메일을 보내 주시면 삭제해 드립니다.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://wavekat.com/ko/privacy/',
      url: 'https://wavekat.com/ko/privacy/',
      name: '개인정보 처리방침',
      description:
        'WaveKat의 데이터 처리: wavekat.com이 수집하는 것, WaveKat Voice가 컴퓨터에 저장하는 것, 계정에 동기화되는 것, 삭제 방법.',
      inLanguage: 'ko',
      dateModified: updated.toISOString().slice(0, 10),
      isPartOf: { '@id': 'https://wavekat.com/#website' },
      about: { '@id': 'https://wavekat.com/#organization' },
      publisher: { '@id': 'https://wavekat.com/#organization' },
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'ko',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const sec = 'mb-12';
const h2 = 'text-base font-bold text-gray-900 dark:text-white mb-4';
const p = 'text-sm text-gray-600 dark:text-gray-400 leading-relaxed';
const li = 'flex gap-2.5 text-sm text-gray-600 dark:text-gray-400 leading-relaxed';
const linkCls =
  'text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors';
const wrap = 'overflow-x-auto rounded-lg border border-gray-200 dark:border-white/10 mb-4';
const th = 'px-4 py-3 text-[10px] font-bold tracking-widest text-gray-400 uppercase';
const td = 'px-4 py-3 text-xs text-gray-600 dark:text-gray-400 leading-relaxed';
const tdKey = 'px-4 py-3 text-xs font-bold text-gray-900 dark:text-white';
const row = 'border-b border-gray-100 dark:border-white/5 last:border-0 align-top';
// CJK body copy is assembled as HTML strings and injected with set:html: mixing
// text and elements in JSX inserts whitespace that renders as stray gaps.
const dot = '<span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gray-300 dark:bg-gray-600"></span>';
const b = (text: string) => `<strong class="font-bold text-gray-900 dark:text-gray-200">${text}</strong>`;
---

<Base
  title="개인정보 처리방침 — WaveKat"
  description="WaveKat의 데이터 처리: wavekat.com이 수집하는 것, WaveKat Voice가 컴퓨터에 저장하는 것, 계정에 동기화되는 것, 삭제 방법."
>
  <Header />

  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="mx-auto max-w-3xl">

      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3 text-gray-900 dark:text-white">
          개인정보 처리방침
        </h1>
        <p class="text-xs text-gray-400 dark:text-gray-600 mb-6">최종 업데이트: {updatedLabel}</p>
        <p class={`${p} mb-3`}>WaveKat은 꼭 필요한 최소한의 데이터만 수집합니다. 여러분의 통화 — 오디오, 전사, 기록 — 는 WaveKat 계정에 로그인해 클라우드 동기화를 켜 두거나, 스스로 계정을 다른 서비스에 연결하지 않는 한 여러분 자신의 컴퓨터를 떠나지 않습니다. 이 웹사이트는 트래픽 측정에 Google Analytics와 Google Ads를 사용합니다. 우리는 개인 데이터를 판매한 적이 없고 그럴 계획도 없습니다.</p>
        <p class={p} set:html={`이 방침은 WaveKat이 운영하는 모든 것 — wavekat.com 웹사이트, 데스크톱 앱 <a href="/ko/voice/" class="${linkCls}">WaveKat Voice</a>, WaveKat 계정 — 을 다룹니다.`} />
      </header>

      <aside
        class="mb-14 rounded-lg border p-5"
        style="border-color: #ff6d0040; background-color: #ff6d0008;"
      >
        <p class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-4">먼저 알아야 할 세 가지</p>
        <ul class="space-y-3">
          <li class={li} set:html={`${dot}<span>${b('WaveKat Voice는 전화 통화를 녹음하며, 녹음은 기본적으로 켜져 있습니다.')}통화를 녹음해도 되는지, 상대에게 알려야 하는지는 여러분과 상대가 있는 지역에 따라 다릅니다. 그것은 우리가 아니라 여러분의 책임입니다. 확신이 없으면 상대에게 알리거나 녹음을 끄세요.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('WaveKat은 공개 베타 중인 작은 독립 프로젝트입니다.')}준법 부서를 갖춘 대기업이 아닙니다. 버그와 변경을 예상하시고, 잃어서는 안 되는 것은 반드시 직접 사본을 보관하세요.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('엄격히 규제되는 정보를 WaveKat에 통과시키지 마세요.')}카드 번호, 의료 기록 등 PCI DSS나 HIPAA 같은 제도가 다루는 데이터를 위해 설계되거나 인증받지 않았습니다. 통화가 일상적으로 그런 데이터를 다룬다면 WaveKat은 맞는 도구가 아닙니다.</span>`} />
        </ul>
      </aside>

      <nav
        aria-label="이 페이지의 목차"
        class="mb-14 border-t border-b border-gray-200 py-5 dark:border-white/10"
      >
        <p class="text-[10px] font-bold tracking-widest text-gray-400 uppercase mb-3">이 페이지의 목차</p>
        <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
          {Object.entries(S).map(([id, label]) => (
            <li>
              <a
                href={`#${id}`}
                class="text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section id="controller" class={sec}>
        <h2 class={h2}>{S.controller}</h2>
        <p class={p} set:html={`wavekat.com, WaveKat Voice, WaveKat 계정의 데이터를 책임지는 주체는 WaveKat입니다. 개인정보에 관한 어떤 질문이든 <a href="mailto:hello@wavekat.com" class="${linkCls}">hello@wavekat.com</a>으로 보내 주세요 — 아래에 설명된 권리 행사도 같은 주소로 접수합니다. 모든 메일을 읽습니다.`} />
      </section>

      <section id="website" class={sec}>
        <h2 class={h2}>{S.website}</h2>
        <p class={`${p} mb-4`}>wavekat.com을 읽는 데 계정은 필요 없고, 사이트에 입력 양식도 없습니다 — 연락 수단은 이메일뿐입니다. 사이트가 실제로 수집하는 것은 측정 데이터입니다:</p>
        <ul class="space-y-2.5 mb-4">
          <li class={li} set:html={`${dot}<span>${b('Google Analytics 4')}(측정 ID <code class="font-mono text-xs">G-H8ZGBL04R7</code>)는 어떤 페이지를 봤는지, IP 주소로 추정한 대략적 위치, 기기와 브라우저, 어느 사이트에서 왔는지를 기록합니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('Google Ads 전환 측정')}은 광고를 통해 들어온 방문자가 나중에 "메일 보내기" 링크를 눌렀다는 사실을 기록합니다. 기록되는 것은 클릭이며, 이후에 쓰는 메일 내용은 절대 아닙니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('Google Fonts')}는 Google 서버에서 로드되므로, 페이지가 글꼴을 불러올 때 Google이 여러분의 IP 주소를 보게 됩니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('Cloudflare')}는 사이트를 호스팅하고 앱 다운로드를 제공하면서, 페이지 전달과 악용 차단을 위해 일반적인 서버 로그 — IP 주소, 요청한 파일, 시각, 브라우저 — 를 보관합니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('여러분이 보낸 메일')}은 답장하고 대화 기록을 남기는 데 필요한 기간 동안 보관됩니다.</span>`} />
        </ul>
        <p class={p}>분석과 광고 측정의 법적 근거는, 동의가 요구되는 지역에서는 여러분의 동의이고, 그 외 지역에서는 사이트가 어떻게 쓰이는지 이해하려는 우리의 정당한 이익입니다. 호스팅 로그는 사이트를 안전하게 유지하려는 정당한 이익에 근거합니다.</p>
      </section>

      <section id="cookies" class={sec}>
        <h2 class={h2}>{S.cookies}</h2>
        <div class={wrap}>
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-wk-surface">
                <th class={`${th} w-[30%]`}>이름</th>
                <th class={`${th} w-[20%]`}>설정 주체</th>
                <th class={th}>용도</th>
                <th class={`${th} w-[18%]`}>보관 기간</th>
              </tr>
            </thead>
            <tbody>
              <tr class={row}>
                <td class={`${tdKey} font-mono`}>_ga, _ga_*</td>
                <td class={td}>Google Analytics</td>
                <td class={td}>재방문을 구분하고 세션 수를 셉니다</td>
                <td class={td}>최대 2년</td>
              </tr>
              <tr class={row}>
                <td class={`${tdKey} font-mono`}>_gcl_au</td>
                <td class={td}>Google Ads</td>
                <td class={td}>광고 클릭을 이 사이트에서의 이후 행동과 연결합니다</td>
                <td class={td}>90일</td>
              </tr>
              <tr class={row}>
                <td class={`${tdKey} font-mono`}>theme</td>
                <td class={td}>WaveKat(로컬 저장소)</td>
                <td class={td}>라이트/다크 테마 선택을 기억합니다</td>
                <td class={td}>지울 때까지</td>
              </tr>
              <tr class={row}>
                <td class={`${tdKey} font-mono`}>lang-pref-dismissed</td>
                <td class={td}>WaveKat(로컬 저장소)</td>
                <td class={td}>"이 페이지를 내 언어로" 배너를 닫았음을 기억합니다</td>
                <td class={td}>지울 때까지</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class={p} set:html={`표의 WaveKat 두 항목은 브라우저 밖으로 절대 나가지 않습니다. 현재 사이트는 쿠키 동의 배너를 표시하지 않습니다. 측정을 원치 않으면 브라우저 설정에서 서드파티 또는 분석 쿠키를 차단하거나, Google의 <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="${linkCls}">애널리틱스 차단 부가기능</a>을 설치하세요. 메일을 주시면 측정에서 제외해 드릴 수도 있습니다.`} />
      </section>

      <section id="signin" class={sec}>
        <h2 class={h2}>{S.signin}</h2>
        <p class={`${p} mb-3`} set:html={`WaveKat 계정은 선택 사항입니다 — 데스크톱 앱은 계정 없이도 동작합니다. 계정을 만들 때는 우리가 보관하는 비밀번호가 아니라 ${b('GitHub 또는 Google')}로 로그인합니다. 여러분의 GitHub나 Google 비밀번호를 우리는 절대 보지 못합니다.`} />
        <p class={`${p} mb-3`}>그 로그인이 우리에게 넘기고 우리가 저장하는 것은: 사용자 이름, 표시 이름, 이메일 주소, 프로필 사진 주소, 제공자의 계정 식별자, 마지막 로그인 시각입니다. 다음에 여러분을 알아보고 로그인 상태로 표시하는 데 쓰입니다. GitHub와 Google을 같은 계정에 모두 연결할 수 있고, 마지막 로그인 수단이 아닌 한 어느 쪽이든 연결을 해제할 수 있습니다.</p>
        <p class={p} set:html={`명령줄 도구 <code class="font-mono text-xs">wk</code>를 쓰면 같은 방식으로 로그인하고 액세스 토큰을 저장하는데, 토큰에는 요청한 기기의 이름이 붙어 있어 자신의 기기를 구분할 수 있습니다.`} />
      </section>

      <section id="app" class={sec}>
        <h2 class={h2}>{S.app}</h2>
        <p class={`${p} mb-4`}>WaveKat Voice는 Mac과 Linux용 데스크톱 앱이며, 기본적으로 로컬에서 동작합니다. WaveKat 계정에 로그인하지 않는 한, 아래 모든 것은 여러분의 기기에 남고 우리에게 절대 도달하지 않습니다:</p>
        <ul class="space-y-2.5 mb-4">
          <li class={li} set:html={`${dot}<span>${b('통화 녹음.')}녹음은 기본적으로 켜져 있고, 각 통화는 양쪽 목소리를 담은 오디오 파일로 저장됩니다. "설정 → 녹음"에서 언제든 끌 수 있습니다. 자동 정리는 없습니다 — 녹음은 여러분이 지울 때까지 남습니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('통화 기록')}— 날짜, 번호, 길이, 통화가 끝난 방식. 로컬 데이터베이스에 저장됩니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('전사.')}실시간 전사는 기본적으로 꺼져 있습니다. 켜면 음성 인식은 전부 여러분의 컴퓨터에서 실행됩니다 — 전사를 위해 오디오가 어디론가 전송되지 않습니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('SIP 계정 비밀번호')}. 여러분의 컴퓨터에 저장되고 운영체제가 암호화합니다. WaveKat으로 전송되는 일은 절대 없습니다.</span>`} />
        </ul>
        <p class={p} set:html={`${b('녹음과 동의.')}통화 녹음 법규는 나라와 지역마다 다릅니다. 본인 동의만으로 충분한 곳도 있고, 통화 참여자 전원의 동의가 필요한 곳도 있습니다. WaveKat Voice는 녹음되는 통화의 시작에 짧은 알림음을 재생해 상대에게 알립니다. 알림음은 예의일 뿐 법적 보장이 아닙니다 — 여러분과 통화 상대가 있는 곳의 동의 법규를 지키는 것은 여러분 자신의 책임입니다.`} />
      </section>

      <section id="account" class={sec}>
        <h2 class={h2}>{S.account}</h2>
        <p class={`${p} mb-4`} set:html={`로그인하기 전에는 아무것도 동기화되지 않습니다. 로그인 후 ${b('클라우드 동기화')}를 켜 두면(로그인하면 기본적으로 켜집니다), 앱은 통화 기록(날짜, 번호, 타임스탬프, 길이, 통화가 끝난 방식), 녹음, 전사를 여러분 전용 WaveKat 계정에 업로드해, 로그인한 모든 기기에서 통화를 볼 수 있게 합니다. 로그인하면 그 컴퓨터 — 이름, 운영체제, 앱 버전 — 도 등록되어 어떤 기기가 연결돼 있는지 확인할 수 있습니다.`} />
        <p class={p} set:html={`${b('클라우드 동기화')}를 끄면 모든 것이 그 컴퓨터에 남고, 로컬 녹음과 기록은 그대로 동작합니다. 앱은 또한 그 컴퓨터에서 처음 동기화한 계정이 아닌 다른 WaveKat 계정의 데이터 업로드를 거부합니다. 동기화된 녹음·전사·기록은 플랫폼 전체가 올라가 있는 ${b('Cloudflare')}의 우리 계정에 저장됩니다. 여러분의 통화를 모델 학습에 쓰지 않으며, 판매하지도 않습니다.`} />
      </section>

      <section id="sharing" class={sec}>
        <h2 class={h2}>{S.sharing}</h2>
        <p class={`${p} mb-3`}>녹음된 통화를 링크로 만들어 누군가에게 보낼 수 있습니다. 그 링크를 가진 사람은 누구나 열 수 있습니다 — 받는 쪽에 로그인은 없습니다 — 그러니 링크 자체를 열쇠처럼 다루세요. 공유는 언제나 여러분이 시작하며, 자동으로 공유되는 것은 없습니다.</p>
        <p class={`${p} mb-3`}>링크를 만들 때 상대가 무엇을 받을지 선택합니다. 기본적으로 오디오는 들리고, 전사는 숨겨지며, 통화 상대의 신원은 가려집니다. 각 항목을 켜고 끌 수 있고, 다운로드를 허용하거나 막을 수 있으며, 어느 쪽 목소리를 재생할지도 고를 수 있습니다. 링크를 회수하면 더는 열리지 않습니다.</p>
        <p class={p}>보내기 전에 한 번 생각해 주세요. 공유된 녹음에는 다른 사람의 목소리와, 여러분에게만 말하고 있다고 믿으며 한 이야기가 담겨 있습니다. 공유는 여러분의 결정이자 책임입니다 — 기본 마스킹은 도우려고 있는 것이지, 결정을 대신해 주는 것이 아닙니다.</p>
      </section>

      <section id="integrations" class={sec}>
        <h2 class={h2}>{S.integrations}</h2>
        <p class={`${p} mb-4`}>WaveKat 계정은 여러분이 연결한 다른 시스템으로 통화를 전달할 수 있습니다. 기본적으로 아무것도 연결되어 있지 않습니다 — 모든 목적지는 여러분이 직접 추가하며, 제거하면 전송이 즉시 멈춥니다. 목적지가 연결된 동안 통화 데이터는 WaveKat을 떠나 우리가 운영하지 않는 서비스로 갑니다. 두 종류가 있습니다:</p>
        <ul class="space-y-2.5 mb-4">
          <li class={li} set:html={`${dot}<span>${b('웹훅.')}여러분이 URL을 주면 WaveKat이 통화마다 기록을 그리로 전송합니다. 기본적으로 그 기록에는 상대의 번호와 발신자 표시, 전체 전사, 그리고 24시간 동안 통화 오디오를 다운로드할 수 있는 링크가 담깁니다. 엔드포인트마다 세 개의 스위치로 신원·전사·녹음을 각각 끌 수 있고 — 끈 항목은 빈칸이 아니라 메시지에서 통째로 빠집니다. 모든 요청에는 서명이 붙어, 받는 쪽에서 정말 우리가 보낸 것인지 검증할 수 있습니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('HubSpot.')}연결은 HubSpot 자체의 동의 화면에서 이뤄집니다. 통화가 끝날 때마다 WaveKat은 전화번호로 여러분의 HubSpot 연락처에서 상대를 찾아 그 사람 앞으로 통화 기록을 남깁니다: 시각, 방향, 결과, 길이, 번호들, 한 줄 요약, WaveKat 안의 통화로 돌아가는 링크, 그리고 전사 동기화를 끄지 않는 한 대화 내용까지. 녹음이 있는 통화라면 HubSpot이 오디오를 재생하는 데 필요한 정보도 함께 갑니다. 선택 스위치 두 개로, 번호와 일치하는 사람이 없을 때 HubSpot 연락처를 만들지, WaveKat에서 통화를 삭제할 때 HubSpot 기록을 보관 처리할지 정할 수 있습니다.</span>`} />
        </ul>
        <p class={`${p} mb-3`} set:html={`${b('여러분의 HubSpot 자격 증명.')}연결하면 WaveKat은 여러분 HubSpot 계정의 액세스 토큰과 갱신 토큰을 받습니다. 둘 다 저장 전에 암호화되고, 우리 API의 어디에서도 반환되지 않으며, 연결을 끊으면 지워집니다 — 동시에 HubSpot에도 폐기를 요청합니다. 이미 HubSpot에 만들어진 기록은 그대로 남습니다. 그것은 여러분 CRM의 데이터이고, 연동을 끊는 것과 이력을 지우는 것은 다른 일입니다.`} />
        <p class={`${p} mb-3`} set:html={`${b('도착한 뒤에는 그쪽의 것입니다.')}여러분의 웹훅이나 HubSpot 계정에 도착한 데이터는 이미 WaveKat을 떠난 것입니다. 그곳에서의 처리는 그 시스템 자체의 개인정보 방침이 정하며, 어떻게 쓸지는 여러분이 결정합니다.`} />
        <p class={`${p} mb-3`} set:html={`${b('통화 상대에 대해 한마디.')}이 목적지들은 여러분과 통화한 사람의 번호와 전사를 받고, 허용하면 그 사람의 연락처 기록도 CRM에 만들어집니다. 그 사람은 WaveKat 사용자가 아니고, 우리와 아무것도 약속한 적이 없습니다. 그 사람의 번호와 목소리와 말을 기록해도 되는지의 판단은, 애초에 통화를 녹음해도 되는지의 판단과 같은 무게의 여러분 책임입니다.`} />
        <p class={p}>장애를 진단할 수 있도록 전송 로그 — 어떤 이벤트가 어디로 갔고, 목적지가 뭐라고 응답했고, 얼마나 걸렸는지 — 를 30일간 보관합니다. 계속 실패하는 목적지는 무한 재시도 대신 비활성화됩니다. 웹훅은 베타 기간 동안 무료이고, HubSpot 연동은 Pro 기능입니다.</p>
      </section>

      <section id="prompts" class={sec}>
        <h2 class={h2}>{S.prompts}</h2>
        <p class={`${p} mb-3`} set:html={`WaveKat에는 입력한 문장을 전화 안내 음성으로 바꿔 주는 도구가 있습니다. 입력한 문장은 우리가 쓰는 음성 합성 서비스 ${b('ElevenLabs')}로 전송되고, 오디오가 돌아옵니다. WaveKat 밖으로 나가면 안 되는 내용은 입력하지 마세요 — 이것은 안내 음성 생성기이지, 개인 메모장이 아닙니다.`} />
        <p class={p} set:html={`계정 없이도 쓸 수 있습니다. 이때는 방문자 한 명이 모두의 하루 한도를 소진하지 않도록 ${b('IP 주소를 뒤섞은 값')}으로 사용량을 셉니다. 그날의 집계를 위한 단방향 값일 뿐, 여러분에 대한 프로필이 아니며, 사이트 안에서 여러분을 추적하는 데도 쓰지 않습니다.`} />
      </section>

      <section id="telemetry" class={sec}>
        <h2 class={h2}>{S.telemetry}</h2>
        <p class={`${p} mb-3`}>앱이 충돌하거나 내부 오류를 만나면, 버그를 고칠 수 있도록 익명 보고를 보낼 수 있습니다. 내용은 오류 자체, 앱의 어느 부분에서 일어났는지, 직전에 앱이 무엇을 하고 있었는지입니다. 보고는 우리가 쓰는 오류 보고 서비스 Sentry로 갑니다. 전송 전에 앱은 사용자 이름, 이메일 주소, IP 주소, 사용자 이름이 든 파일 경로, 자격 증명처럼 보이는 모든 것을 제거합니다. 오류 보고에 통화 오디오, 통화 기록, 전화번호, 연락처가 포함되는 일은 절대 없습니다.</p>
        <p class={`${p} mb-3`}>또한 실행할 때마다 한 번, 설치가 몇 건인지와 어떤 버전·운영체제를 지원해야 할지 알기 위한 익명 신호를 보냅니다. 담기는 것은 무작위 설치 식별자, 앱 버전, 운영체제와 그 버전, 프로세서 종류, 언어뿐 — 이름도, 계정도, 컴퓨터 이름도 없습니다.</p>
        <p class={p} set:html={`둘 다 기본적으로 켜져 있고, "설정 → 정보"의 ${b('오류 보고 보내기')} 스위치 하나로 둘 다 꺼집니다. 앱 업데이트 확인은 우리 업데이트 서버에서 파일을 내려받는 것으로, 개인 데이터가 붙지 않는 일반적인 웹 요청입니다.`} />
      </section>

      <section id="providers" class={sec}>
        <h2 class={h2}>{S.providers}</h2>
        <p class={`${p} mb-4`} set:html={`WaveKat은 소수의 다른 회사 서비스 위에서 동작합니다. 각 회사가 받는 것은 이 페이지에 적힌 내용뿐이고, 모두 표준 상용 조건으로 이용합니다 — 다만 그들은 대기업이고, 그들의 관행은 우리가 아닌 그들의 것이며, 그들이 무엇을 하는지는 각자의 개인정보 방침이 정합니다. 아래는 <em>우리가</em> 고른 업체들입니다. <em>여러분이</em> 연결하는 서비스는 별개의 문제로, <a href="#integrations" class="${linkCls}">${S.integrations}</a>에서 다룹니다.`} />
        <div class={wrap}>
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-gray-200 dark:border-white/10 bg-gray-50 dark:bg-wk-surface">
                <th class={`${th} w-[18%]`}>업체</th>
                <th class={`${th} w-[34%]`}>역할</th>
                <th class={th}>받는 정보</th>
              </tr>
            </thead>
            <tbody>
              <tr class={row}>
                <td class={tdKey}>Google</td>
                <td class={td}>사이트 분석, 광고 측정, 웹 글꼴</td>
                <td class={td}>페이지 조회, IP 주소, 기기와 브라우저, 광고 클릭 귀속</td>
              </tr>
              <tr class={row}>
                <td class={tdKey}>Cloudflare</td>
                <td class={td}>사이트 호스팅, 앱 다운로드, WaveKat 계정 뒤의 저장소</td>
                <td class={td}>서버 로그. 클라우드 동기화를 켰다면 동기화된 녹음·전사·통화 기록도</td>
              </tr>
              <tr class={row}>
                <td class={tdKey}>ElevenLabs</td>
                <td class={td}>입력한 문장을 전화 안내 음성으로 합성</td>
                <td class={td}>입력한 문장. 통화 오디오·전사·연락처는 절대 아님</td>
              </tr>
              <tr class={row}>
                <td class={tdKey}>Sentry</td>
                <td class={td}>데스크톱 앱의 익명 오류 보고</td>
                <td class={td}>개인 정보 항목을 제거한 오류 상세 — 통화 데이터는 절대 아님</td>
              </tr>
              <tr class={row}>
                <td class={tdKey}>GitHub / Google</td>
                <td class={td}>로그인</td>
                <td class={td}>그들이 우리에게 여러분이 누구인지 알려 줍니다. 우리는 그들에게 통화에 관한 것을 보내지 않습니다</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class={p}>이 업체들은 미국에 있으므로, 이 방침이 다루는 데이터는 각사의 표준 데이터 처리 조건에 있는 이전 보호 장치에 따라 미국에서 처리될 수 있습니다. 우리는 개인 데이터를 판매하지 않습니다. Google Ads 전환 측정은 사용하며, 미국 여러 주법은 이를 맥락 간 광고를 위한 "공유"로 간주합니다 — 아래의 거부 방법이 여기에도 적용됩니다.</p>
      </section>

      <section id="retention" class={sec}>
        <h2 class={h2}>{S.retention}</h2>
        <ul class="space-y-2.5">
          <li class={li} set:html={`${dot}<span>${b('사이트 분석 데이터')}— Google Analytics 보존 설정에 따라 Google이 보관합니다. 현재는 약 14개월의 표준 기간입니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('오류 보고')}— 이용 중인 요금제의 보존 기간에 따라 Sentry가 보관합니다. 연 단위가 아니라 월 단위입니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('연동·웹훅 전송 로그')}— 30일 후 자동 삭제됩니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('컴퓨터에 있는 녹음·기록·전사')}— 여러분이 지울 때까지. 우리가 대신 지우는 일은 없습니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('WaveKat 계정에 동기화된 데이터')}— 앱에서 지우거나 우리에게 요청할 때까지.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('이메일')}— 답장하고 주고받은 기록을 남기는 데 필요한 기간 동안.</span>`} />
        </ul>
      </section>

      <section id="deletion" class={sec}>
        <h2 class={h2}>{S.deletion}</h2>
        <ul class="space-y-2.5">
          <li class={li} set:html={`${dot}<span>${b('녹음 하나 지우기')}— 해당 통화의 상세 페이지를 열어 그곳에서 녹음을 삭제합니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('녹음 전부 지우기')}— "설정 → 녹음 → 모든 녹음 지우기".</span>`} />
          <li class={li} set:html={`${dot}<span>${b('이 컴퓨터의 모든 것 지우기')}— "설정 → WaveKat 계정 → 로컬 데이터 삭제"가 그 기기에서 통화 기록, 녹음, 전사, 로그인 상태를 지웁니다.</span>`} />
          <li class={li} set:html={`${dot}<span>${b('계정에 동기화된 데이터 지우기')}— <a href="mailto:hello@wavekat.com" class="${linkCls}">hello@wavekat.com</a>으로 메일을 주시면 삭제해 드립니다.</span>`} />
        </ul>
      </section>

      <section id="rights" class={sec}>
        <h2 class={h2}>{S.rights}</h2>
        <p class={`${p} mb-3`}>EU, 영국 또는 유사한 법이 있는 지역에 계시다면, 데이터 사본 요청, 정정, 삭제, 이용의 제한이나 반대, 이동 가능한 형식으로의 반출, 이전에 한 동의의 철회를 요구할 수 있습니다. 거주 지역의 데이터 보호 당국에 진정을 낼 수도 있습니다.</p>
        <p class={`${p} mb-3`}>캘리포니아 등 개인정보 보호법이 있는 미국 주에 계시다면, 우리가 무엇을 수집하는지 묻고, 삭제나 정정을 요구하고, 판매나 광고 관련 공유를 거부할 수 있습니다. 권리를 행사했다는 이유로 다르게 대우하는 일은 절대 없습니다.</p>
        <p class={p} set:html={`이 모든 것은 <a href="mailto:hello@wavekat.com" class="${linkCls}">hello@wavekat.com</a>으로 메일을 보내 행사할 수 있습니다. WaveKat은 아주 작은 팀이니 시간을 조금만 주세요 — 최대한 빨리, 법이 적용되는 곳에서는 법이 허용하는 한 달 안에 답합니다. 해당 계정이나 이메일 주소를 정말 관리하고 있는지 확인을 요청할 수 있는데, 이는 다른 사람이 여러분의 데이터를 가로채는 것을 막기 위한 절차입니다.`} />
      </section>

      <section id="security" class={sec}>
        <h2 class={h2}>{S.security}</h2>
        <p class={`${p} mb-3`}>상식적인 조치는 되어 있습니다. 여러분과 WaveKat 사이를 오가는 모든 것 — 이 사이트, 클라우드 동기화, 다운로드 — 은 암호화된 연결을 통합니다. 로그인은 GitHub 또는 Google을 거치므로 우리가 잃어버릴 수 있는 여러분의 비밀번호가 없습니다. 연결한 서비스의 자격 증명은 저장 전에 암호화됩니다. 링크로 공유한 녹음은 링크가 있어야 열립니다. SIP 비밀번호는 애초에 컴퓨터 밖으로 나가지 않습니다.</p>
        <p class={`${p} mb-3`}>솔직히 덧붙일 것이 하나 있습니다: 전화 자체는 여러분 SIP 사업자의 망을 지나며, 그 구간의 암호화 여부는 여러분과 사업자 사이의 일입니다 — 오늘날 업무용 SIP 트래픽 대부분은 암호화되지 않습니다. 이는 그 회선의 어떤 전화기에도 해당하는 일이고 WaveKat이 더한 문제가 아니지만, 프라이버시를 말하는 페이지가 침묵할 일도 아닙니다.</p>
        <p class={`${p} mb-3`}>우리가 하지 않을 말은, 이것으로 무언가가 불가능해진다는 말입니다. 완전히 안전한 온라인 서비스는 없고, WaveKat은 전담 보안 부서가 없는 아주 작은 팀이 만들고 운영합니다. 여러분의 데이터가 노출된 사실을 알게 되면, 합리적으로 가능한 한 빨리 아는 것을 알려 드리고, 모르는 것도 분명히 말씀드리겠습니다.</p>
        <p class={p}>가장 강한 보호는 여전히 여러분 손에 있습니다. 여러분이 달리 선택하지 않는 한 WaveKat Voice는 모든 것을 여러분의 컴퓨터에 둡니다. 유출되면 심각할 통화라면, 클라우드 동기화를 꺼 두고 공유도 전달도 하지 않는 것이 그것을 우리 손이 닿지 않는 곳에 완전히 두는 길입니다.</p>
      </section>

      <section id="children" class={sec}>
        <h2 class={h2}>{S.children}</h2>
        <p class={p}>WaveKat Voice는 업무용 도구이며 아동을 대상으로 하지 않습니다. 16세 미만의 개인 데이터를 고의로 수집하지 않습니다. 아동이 데이터를 제공했다고 생각되면 메일을 주세요. 삭제하겠습니다.</p>
      </section>

      <section id="changes" class={sec}>
        <h2 class={h2}>{S.changes}</h2>
        <p class={`${p} mb-3`}>이 방침이 바뀌면 맨 위의 날짜도 함께 바뀝니다. 수집하는 것이나 받는 곳에 실질적으로 영향을 주는 변경이라면, 문장을 조용히 고치는 대신 이 페이지에서 분명히 말씀드리겠습니다.</p>
        <p class={p}>이 페이지는 WaveKat이 실제로 어떻게 동작하는지를, 변호사가 아니라 만드는 사람들이 쉬운 말로 쓴 설명입니다. 법률 자문이 아니며, 여러분이 살고 일하는 곳에서 무엇을 녹음하고 보관하고 공유해도 되는지에 대한 여러분 자신의 판단을 대신하지 않습니다. 여기 적힌 내용이 사업에 중요하고 확실한 답이 필요하다면, 여러분 나라의 자격 있는 전문가와 상의하세요 — 그리고 이 페이지에서 사실과 다른 것을 발견하면 알려 주세요. 우리는 그것을 변호하기보다 고치는 쪽을 택하겠습니다.</p>
      </section>

      <section id="faq" class={sec}>
        <h2 class={h2}>{S.faq}</h2>
        <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
          {faqs.map((f) => (
            <details class="group">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
                {f.q}
                <span class="shrink-0 transition-transform group-open:rotate-45" style="color: #ff6d00" aria-hidden="true">+</span>
              </summary>
              <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed pb-4 -mt-1">
                {f.a}
              </p>
            </details>
          ))}
        </div>
      </section>

      <section id="contact" class="mb-8">
        <h2 class={h2}>{S.contact}</h2>
        <p class={`${p} mb-5`}>개인정보 관련 질문, 데이터 요청, 이 페이지에서 불분명한 부분 — 메일을 보내 주세요. 사람이 답합니다.</p>
        <a
          href="mailto:hello@wavekat.com"
          class="inline-flex items-center gap-2 rounded px-4 py-2.5 text-xs font-bold text-white transition-opacity hover:opacity-90"
          style="background-color: #ff6d00"
        >
          <Mail class="w-4 h-4" />
          hello@wavekat.com
        </a>
      </section>

    </div>
  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
