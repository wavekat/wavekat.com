---
// Korean homepage. Mirrors src/pages/index.astro; body copy is
// translated, repo names/colors/links are shared. Locale, hreflang, the
// language switcher and localised header/footer are all derived from the /ko/
// URL by Base/Header — this page just passes its Korean title/description.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VoiceDownload from '../../components/VoiceDownload.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';

// The hero screenshots, read as one story: a flow you drew answers the phone,
// you can still take the call over mid-message, and the recording is yours
// afterwards. Shared assets under /screenshots/<scene>/<code>.webp.
const heroShots = [
  {
    scene: 'flow-detail',
    alt: 'WaveKat Voice의 통화 플로우 지도 — 인사말, 영업시간 확인, 내 자리 울리기, 마지막으로 음성 메시지',
    label: '통화 플로우',
    caption: '인사말, 영업시간, 내 자리 울리기, 그리고 음성 메시지 — 한 장의 지도로.',
  },
  {
    scene: 'flow-takeover',
    alt: '통화 플로우가 메시지를 받는 동안의 WaveKat Voice — 실시간 전사와 받기 버튼',
    label: '손이 빌 때까지 대신 받기',
    caption: '대신 받아 줍니다 — 상대의 말을 읽으면서 도중에 넘겨받을 수 있습니다.',
  },
  {
    scene: 'share-sheet',
    alt: 'WaveKat Voice의 통화 녹음 공유 — 비공개·초대 전용·링크를 아는 누구나 중에서 고르고 발신자 정보는 가려집니다',
    label: '녹음은 링크로 공유',
    caption: '모든 통화가 녹음되고 글로 남습니다. 링크로 보내고, 누가 들을지 정하세요.',
  },
];

const voicePipeline = [
  {
    name: 'wavekat-vad',
    description: '음성 활동 감지 — WebRTC, Silero, TEN-VAD, FireRedVAD 지원.',
    color: '#00bcd4',
    href: 'https://github.com/wavekat/wavekat-vad',
  },
  {
    name: 'wavekat-turn',
    description: '발화 차례 감지 — 화자가 말을 마쳤는지 판단합니다.',
    color: '#7c4dff',
    href: 'https://github.com/wavekat/wavekat-turn',
  },
  {
    name: 'wavekat-asr',
    description: '스트리밍 음성 인식 — 여러 ASR 백엔드를 하나의 Rust 인터페이스로 통합.',
    color: '#f44336',
    href: 'https://github.com/wavekat/wavekat-asr',
  },
  {
    name: 'wavekat-tts',
    description: '음성 합성 — 여러 TTS 백엔드를 하나의 Rust 인터페이스로 통합.',
    color: '#ff4081',
    href: 'https://github.com/wavekat/wavekat-tts',
  },
  {
    name: 'wavekat-core',
    description: '공유 오디오 기본 요소 — AudioFrame, 샘플 포맷 변환.',
    color: '#00e676',
    href: 'https://github.com/wavekat/wavekat-core',
  },
  {
    name: 'wavekat-sip',
    description: 'SIP 시그널링과 RTP 전송 — REGISTER, INVITE, SDP, 세션 추적.',
    color: '#3f51b5',
    href: 'https://github.com/wavekat/wavekat-sip',
  },
];

const toolsAndClients = [
  {
    name: 'wavekat-lab',
    description: '다양한 오디오 백엔드를 테스트하고 비교하는 인터랙티브 대시보드.',
    color: '#ffd740',
    href: 'https://github.com/wavekat/wavekat-lab',
  },
  {
    name: 'wavekat-cli',
    description: 'WaveKat 플랫폼용 커맨드라인 클라이언트(wk).',
    color: '#2196f3',
    href: 'https://github.com/wavekat/wavekat-cli',
  },
];
// The pipeline reads as a signal chain; the last two crates are the foundation
// every stage sits on. Slicing here keeps one data array per locale file.
const pipelineFlow = voicePipeline.slice(0, 4);
const pipelineBase = voicePipeline.slice(4);
---

<Base
  title="WaveKat — 소상공인을 위한 오픈소스 AI 음성 도구"
  description="WaveKat은 오픈소스 AI 도구를 만들어, 예전에는 대기업만 누릴 수 있던 역량을 소상공인에게도 제공합니다 — 음성에서 시작합니다: 컴퓨터를 업무 전화로 바꾸고 모든 통화를 자동으로 녹음·기록하는 데스크톱 앱입니다."
>
  <Header />

  <!-- Hero: product-first, screenshot front and center -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_1px_1px,rgb(0_0_0/0.07)_1px,transparent_0)] bg-[size:28px_28px] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_35%,black,transparent)] dark:bg-[radial-gradient(circle_at_1px_1px,rgb(255_255_255/0.06)_1px,transparent_0)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-[30rem] w-[50rem] -translate-x-1/2 rounded-full opacity-[0.13] blur-3xl"
      style="background: radial-gradient(closest-side, #ff6d00, transparent);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <a
          href="/ko/voice/"
          class="animate-rise group inline-flex items-center gap-2 rounded-full border border-wk-orange/30 bg-wk-orange/5 py-1.5 pl-4 pr-3 text-xs font-medium text-wk-orange transition-colors hover:border-wk-orange/60 hover:bg-wk-orange/10"
        >
          <span class="font-semibold">WaveKat Voice</span>
          <span class="h-3 w-px bg-wk-orange/30" aria-hidden="true"></span>
          무료 공개 베타
          <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
        <h1 class="animate-rise mt-7 text-4xl font-extrabold leading-[1.08] tracking-tight [text-wrap:balance] text-gray-900 dark:text-white sm:text-5xl xl:text-6xl">
          모든 소상공인에게,<br />
          <span class="text-gradient-brand">대기업의 목소리를.</span>
        </h1>
        <p class="animate-rise-late mt-7 max-w-xl text-base leading-relaxed text-gray-500 dark:text-gray-400 sm:text-lg">
          WaveKat은 AI 기반 도구를 만들어, 예전에는 대기업만 누릴 수 있던 역량을 소상공인에게도 제공합니다.
        우리는 음성에서 시작합니다 — 당신의 컴퓨터를 업무 전화로 바꾸고, 모든 통화를 자동으로 녹음하고 기록하는
        데스크톱 앱입니다.
        </p>
        <div class="animate-rise-late mt-9 flex flex-wrap items-center gap-4">
          <VoiceDownload />
          <a
            href="https://github.com/wavekat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-700 transition-all hover:-translate-y-0.5 hover:border-gray-400 hover:bg-gray-900/5 dark:border-white/15 dark:text-gray-200 dark:hover:border-white/30 dark:hover:bg-white/5"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
            GitHub에서 보기
          </a>
        </div>
      </div>

      <div class="animate-rise-late">
        <HeroCarousel imgCode="ko" shots={heroShots} />
      </div>
    </div>
  </section>

  <!-- Product statement: a dark full-bleed band in both themes -->
  <section class="relative overflow-hidden border-y border-gray-200/60 bg-[#070b14] dark:border-white/10 dark:bg-white/[0.05]" data-reveal>
    <div
      class="pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full opacity-15 blur-3xl"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <h2 class="mb-8 font-mono text-xs font-bold uppercase tracking-widest text-white/40">우리 앱</h2>
      <div class="flex flex-wrap items-center gap-4">
        <span class="text-3xl font-bold tracking-tight text-wk-orange sm:text-4xl">WaveKat Voice</span>
        <span class="inline-flex items-center rounded-full border border-wk-orange/30 bg-wk-orange/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-wk-orange">
          무료 공개 베타
        </span>
      </div>
      <p class="mt-6 max-w-3xl text-lg font-medium leading-relaxed text-gray-200 sm:text-2xl sm:leading-relaxed">
        당신의 컴퓨터에서 돌아가는 전화 앱입니다. 이미 쓰고 있는 전화 사업자를 그대로 이용해,
            데스크톱에서 바로 전화를 받고 걸 수 있습니다 — 모든 대화는 자동으로 녹음되고 글로 기록됩니다.
            심지어 AI 어시스턴트가 당신을 대신해 전화를 걸게 할 수도 있습니다.
      </p>
      <a
        href="/ko/voice/"
        class="group mt-9 inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
      >
        자세히 보기 및 다운로드
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
  </section>

  <!-- Free tool: the public voice-prompt generator, a browser-based front door
       to the platform. Links to its dedicated landing page (/voice/prompts/). -->
  <section class="mx-auto max-w-6xl px-6 pt-20 sm:pt-24" data-reveal>
    <h2 class="mb-8 font-mono text-xs font-bold uppercase tracking-widest text-gray-400">무료 도구</h2>
    <div class="group relative overflow-hidden rounded-2xl border border-gray-200/70 bg-white p-8 shadow-sm dark:border-white/[0.06] dark:bg-white/[0.02] dark:shadow-none sm:p-10">
      <span
        class="absolute inset-x-0 top-0 h-0.5 opacity-60 transition-opacity group-hover:opacity-100"
        style="background: linear-gradient(90deg, transparent, #ff6d00, transparent);"
        aria-hidden="true"
      ></span>
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-2xl">
          <span class="inline-flex items-center rounded-full border border-wk-orange/30 bg-wk-orange/10 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-wk-orange">
            무료 · 가입 불필요
          </span>
          <h3 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">
            전화 메뉴 · IVR 음성 생성기
          </h3>
          <p class="mt-3 text-base leading-relaxed text-gray-500 dark:text-gray-400">
            텍스트를 전화 시스템에 바로 쓸 수 있는 인사말, IVR 메뉴, 음성사서함 안내로 바꿔 드립니다.
            스튜디오 품질의 AI 음성으로, 당신의 전화 시스템이 요구하는 바로 그 형식으로. 브라우저에서
            무료로 사용해 보세요.
          </p>
          <a
            href="/ko/voice/prompts/"
            class="group/more mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-wk-orange transition-opacity hover:opacity-70"
          >
            생성기에 대해 자세히 알아보기
            <ArrowRight class="h-4 w-4 transition-transform group-hover/more:translate-x-0.5" />
          </a>
        </div>
        <a
          href="https://platform.wavekat.com/voice/prompts"
          class="group/cta inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40 sm:self-auto"
        >
          무료로 사용해 보기
          <ArrowUpRight class="h-4 w-4 transition-transform group-hover/cta:translate-x-0.5 group-hover/cta:-translate-y-0.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Libraries: the pipeline drawn as the signal chain it is -->
  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <h2 class="mb-3 font-mono text-xs font-bold uppercase tracking-widest text-gray-400">오픈소스 라이브러리</h2>
    <h3 class="mb-10 text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">음성 파이프라인</h3>

    <div class="grid gap-4 md:grid-cols-4 md:gap-8" data-reveal>
      {pipelineFlow.map((lib, i) => (
        <div class="relative">
          <a
            href={lib.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative block h-full overflow-hidden rounded-2xl border border-gray-200/70 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-[0_20px_40px_-24px_var(--lib)] dark:border-white/[0.06] dark:bg-white/[0.02] dark:shadow-none"
            style={`--lib: ${lib.color};`}
          >
            <span
              class="absolute inset-x-0 top-0 h-0.5 opacity-60 transition-opacity group-hover:opacity-100"
              style={`background: linear-gradient(90deg, transparent, ${lib.color}, transparent);`}
              aria-hidden="true"
            ></span>
            <span class="mb-2 block font-mono text-sm font-bold" style={`color: ${lib.color}`}>{lib.name}</span>
            <p class="text-sm leading-relaxed text-gray-500 dark:text-gray-400">{lib.description}</p>
          </a>
          {i < 3 && (
            <ArrowRight
              class="absolute top-1/2 -right-6 hidden h-4 w-4 -translate-y-1/2 text-gray-300 dark:text-gray-600 md:block"
              aria-hidden="true"
            />
          )}
        </div>
      ))}
    </div>

    <div class="mt-4 grid gap-4 md:mt-8 md:grid-cols-2 md:gap-8" data-reveal>
      {pipelineBase.map((lib) => (
        <a
          href={lib.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-2xl border border-gray-200/70 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-[0_20px_40px_-24px_var(--lib)] dark:border-white/[0.06] dark:bg-white/[0.02] dark:shadow-none"
          style={`--lib: ${lib.color};`}
        >
          <span
            class="absolute inset-x-0 top-0 h-0.5 opacity-60 transition-opacity group-hover:opacity-100"
            style={`background: linear-gradient(90deg, transparent, ${lib.color}, transparent);`}
            aria-hidden="true"
          ></span>
          <span class="mb-2 block font-mono text-sm font-bold" style={`color: ${lib.color}`}>{lib.name}</span>
          <p class="text-sm leading-relaxed text-gray-500 dark:text-gray-400">{lib.description}</p>
        </a>
      ))}
    </div>

    <h3 class="mb-8 mt-16 text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">도구와 클라이언트</h3>
    <div class="grid gap-4 md:grid-cols-2 md:gap-8" data-reveal>
      {toolsAndClients.map((lib) => (
        <a
          href={lib.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded-2xl border border-gray-200/70 bg-white p-6 shadow-sm transition-all hover:-translate-y-1 hover:shadow-[0_20px_40px_-24px_var(--lib)] dark:border-white/[0.06] dark:bg-white/[0.02] dark:shadow-none"
          style={`--lib: ${lib.color};`}
        >
          <span
            class="absolute inset-x-0 top-0 h-0.5 opacity-60 transition-opacity group-hover:opacity-100"
            style={`background: linear-gradient(90deg, transparent, ${lib.color}, transparent);`}
            aria-hidden="true"
          ></span>
          <span class="mb-2 block font-mono text-sm font-bold" style={`color: ${lib.color}`}>{lib.name}</span>
          <p class="text-sm leading-relaxed text-gray-500 dark:text-gray-400">{lib.description}</p>
        </a>
      ))}
    </div>
  </section>

  <Footer />

  <script>
    // Scroll reveal — content is visible without JS; motion is added on top.
    const els = document.querySelectorAll('[data-reveal]');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => el.classList.add('reveal-in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('reveal-in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      els.forEach((el) => {
        el.classList.add('reveal-init');
        io.observe(el);
      });
    }
  </script>
</Base>
