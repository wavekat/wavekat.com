---
import { getCollection } from 'astro:content';
import { blogFilter } from '../../../lib/blog';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { itemListSchema } from '../../../lib/seo';

// Japanese posts live under src/content/blog/ja/ (id "ja/<slug>").
// Strip the locale prefix so the cards link to /ja/blog/<slug>/.
const posts = (await getCollection('blog', blogFilter('ja')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/^ja\//, '');

const listSchema = itemListSchema('WaveKat Blog', new URL(Astro.url.pathname, Astro.site!).href, posts.map((p) => ({ name: p.data.title, url: new URL(`/ja/blog/${slugOf(p.id)}/`, Astro.site!).href })));
---

<Base title="ブログ — WaveKat" description="WaveKat チームによるエンジニアリングノート、お知らせ、技術的な深掘り記事。">
  <div class="max-w-3xl mx-auto px-6 py-12">

    <Header active="blog" />

    <!-- Blog listing -->
    <section class="mb-20">
      <h1 class="text-2xl font-bold leading-snug mb-3 text-gray-900 dark:text-white">ブログ</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-10">
        WaveKat チームによるエンジニアリングノート、お知らせ、技術的な深掘り記事。
      </p>

      {posts.length === 0 ? (
        <p class="text-sm text-gray-400 dark:text-gray-600">まだ記事はありません。近日中にまたご確認ください。</p>
      ) : (
        <div class="grid gap-3">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              slug={slugOf(post.id)}
              hrefBase="/ja/blog/"
              dateLocale="ja"
            />
          ))}
        </div>
      )}
    </section>

    <Footer />

  </div>

  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
</Base>
