---
import { getCollection } from 'astro:content';
import { blogFilter } from '../../../lib/blog';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { itemListSchema } from '../../../lib/seo';

// Spanish posts live under src/content/blog/es/ (id "es/<slug>").
// Strip the locale prefix so the cards link to /es/blog/<slug>/.
const posts = (await getCollection('blog', blogFilter('es')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const slugOf = (id: string) => id.replace(/^es\//, '');

const listSchema = itemListSchema('WaveKat Blog', new URL(Astro.url.pathname, Astro.site!).href, posts.map((p) => ({ name: p.data.title, url: new URL(`/es/blog/${slugOf(p.id)}/`, Astro.site!).href })));
---

<Base title="Blog — WaveKat" description="Notas de ingeniería, anuncios y análisis en profundidad del equipo de WaveKat.">
  <Header active="blog" />

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Blog listing -->
    <section class="mb-20">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3 text-gray-900 dark:text-white">Blog</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-10">
        Notas de ingeniería, anuncios y análisis en profundidad del equipo de WaveKat.
      </p>

      {posts.length === 0 ? (
        <p class="text-sm text-gray-400 dark:text-gray-600">Aún no hay publicaciones. Vuelva pronto.</p>
      ) : (
        <div class="grid gap-4 sm:grid-cols-2">
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              slug={slugOf(post.id)}
              hrefBase="/es/blog/"
              dateLocale="es"
            />
          ))}
        </div>
      )}
    </section>


  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
</Base>
