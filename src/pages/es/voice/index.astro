---
// Spanish version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully Spanish. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import TalkCTA from '../../../components/TalkCTA.astro';
import {
  PhoneCall,
  Mic,
  FileText,
  Terminal,
  Server,
  Cloud,
  Languages,
  Lock,
  ArrowRight,
} from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getMacDownload, getLinuxDownload } from '../../../lib/voice-download';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

const features = [
  {
    icon: PhoneCall,
    title: 'Llamadas desde su escritorio',
    body: 'Conteste y haga llamadas directamente desde su computadora: sin teléfono de mesa, sin hardware extra, sin una pestaña del navegador que vigilar. Espera tranquilo y apartado hasta que suena el teléfono.',
  },
  {
    icon: Mic,
    title: 'Cada llamada grabada',
    body: 'Cada conversación se graba automáticamente y se guarda en cuanto cuelga. Vuelva a escucharla cuando la necesite: sin configuración, nada que recordar activar.',
  },
  {
    icon: FileText,
    title: 'Transcripción en vivo',
    body: 'Vea las palabras a medida que se pronuncian. Una transcripción en marcha aparece junto a la llamada, para que pueda asimilar lo importante en lugar de garabatear notas.',
  },
  {
    icon: Terminal,
    title: 'Deje que un asistente de IA marque',
    body: 'Active la automatización y una herramienta de línea de comandos —o un asistente de IA como Claude— podrá realizar llamadas, esperar a que contesten y finalizarlas por usted. Maneja el teclado de marcación; usted es quien habla. Desactivado hasta que usted lo active.',
  },
  {
    icon: Server,
    title: 'Funciona con su proveedor',
    body: 'Use el proveedor de telefonía que ya tiene — Twilio, Telnyx, 2talk y más. Elíjalo de la lista y la configuración se rellena por usted.',
  },
  {
    icon: Cloud,
    title: 'Sincronice si quiere',
    body: 'Inicie sesión en su cuenta de WaveKat y sus grabaciones y transcripciones se sincronizan para que pueda revisarlas en la web. Si no inicia sesión, todo se queda simplemente en su computadora.',
  },
  {
    icon: Languages,
    title: 'Habla su idioma',
    body: 'La app sigue el idioma de su computadora y habla nueve: inglés, español, francés, alemán, italiano, japonés, coreano y chino, tanto simplificado como tradicional. Cámbielo cuando quiera en Ajustes.',
  },
  {
    icon: Lock,
    title: 'Suyo por defecto',
    body: 'Sus llamadas, grabaciones y transcripciones residen primero en su propia computadora. No se sube nada salvo que usted lo decida: ninguna empresa misteriosa entre usted y sus clientes.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Conecte su número',
    body: 'Inicie sesión en su proveedor de telefonía la primera vez que abra la app. Elíjalo de la lista y los ajustes se rellenan por usted.',
  },
  {
    n: '2',
    title: 'Atienda la llamada',
    body: 'Un punto verde significa que está en línea y localizable. Conteste, marque, silencie, use el teclado: todo desde su escritorio.',
  },
  {
    n: '3',
    title: 'Revísela más tarde',
    body: 'Cada llamada va a parar a su historial con su grabación y su transcripción, lista para volver a verla o sincronizarla con la web.',
  },
];

const faqs = [
  {
    q: '¿Qué es exactamente WaveKat Voice?',
    a: 'Una app de escritorio que convierte su computadora en su teléfono de empresa. Inicia sesión con su proveedor de telefonía y, a partir de ahí, puede contestar y hacer llamadas directamente desde su computadora, con cada llamada grabada y transcrita por usted.',
  },
  {
    q: '¿Necesito algún hardware especial?',
    a: 'No. Si tiene una computadora y una cuenta con un proveedor de telefonía, tiene todo lo que necesita. Sin teléfono de mesa, sin equipo extra; unos auriculares vienen bien, pero no son obligatorios.',
  },
  {
    q: '¿Con qué proveedores de telefonía funciona?',
    a: 'Con la mayoría de los habituales — Twilio, Telnyx, 2talk y más. Rellenamos la configuración de los proveedores que conocemos; para cualquier otro puede introducir los datos usted mismo. Si ya hace llamadas de empresa por internet, su proveedor casi con seguridad funciona.',
  },
  {
    q: '¿Dónde se guardan mis grabaciones y transcripciones?',
    a: 'En su computadora. No se sube nada salvo que usted lo decida. Si inicia sesión en una cuenta de WaveKat, sus grabaciones y transcripciones pueden sincronizarse para que las revise en la web; de lo contrario, nunca salen de su computadora.',
  },
  {
    q: '¿Puede un asistente de IA realizar llamadas por mí?',
    a: 'Sí. Active la automatización en Ajustes → Automatización y una herramienta de línea de comandos —o un asistente de IA conectado como Claude, Cursor o Windsurf— podrá realizar, seguir y finalizar llamadas a través de la app. El asistente maneja el teclado de marcación; usted sigue siendo quien habla. Está desactivado de forma predeterminada y los asistentes se conectan en un solo clic.',
    link: { href: '/es/blog/place-calls-from-the-command-line/', label: 'Cómo funciona' },
  },
  {
    q: '¿En qué idiomas viene la app?',
    a: 'Nueve: inglés, español, francés, alemán, italiano, japonés, coreano y chino, tanto simplificado como tradicional. Sigue el idioma de su computadora automáticamente, y puede elegir otro cuando quiera en Ajustes.',
  },
  {
    q: '¿Es gratis?',
    a: 'Es gratis durante la beta mientras lo pulimos con empresas reales. WaveKat Voice se convertirá en un producto de pago más adelante; los usuarios de la beta recibirán aviso con mucha antelación antes de que eso cambie.',
  },
  {
    q: '¿En qué funciona?',
    a: `Mac y Linux. En macOS funciona en la versión 12 y posteriores (${macDownload.arch}); en Linux es un paquete .deb para ${linuxDownload.arch}.`,
  },
  {
    q: '¿Darán soporte a Windows u otros dispositivos?',
    a: 'WaveKat Voice funciona hoy en Mac y Linux. Windows y otras plataformas están totalmente sobre la mesa: simplemente las construimos cuando hay demanda real. Así que si usaría WaveKat Voice en Windows o en otro lugar, díganoslo. Cuanta más gente lo pida, antes ocurrirá.',
    link: { href: '/es/voice/talk/', label: 'Cuéntenos qué necesita' },
  },
  {
    q: '¿Ralentizará o interferirá con mi computadora?',
    a: 'Es una app de escritorio ligera que se mantiene apartada hasta que entra una llamada, y se actualiza sola sin ruido en segundo plano. La instala una vez y se olvida de que está ahí.',
  },
];

// Localised structured data: same shape as the English page, but with the
// Spanish URL and inLanguage so engines bind this variant to es.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Linux',
  image: 'https://wavekat.com/og.png',
  url: 'https://wavekat.com/es/voice/',
  inLanguage: 'es',
  softwareVersion: macDownload.version,
  downloadUrl: 'https://wavekat.com/es/voice/download/',
  description:
    'Una app de escritorio que convierte su computadora en su teléfono de empresa: conteste y haga llamadas, con cada llamada grabada y transcrita. Funciona con el proveedor de telefonía que ya tiene.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'es',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — su teléfono de empresa, en su escritorio"
  description="WaveKat Voice es una app de escritorio para Mac y Linux que convierte su computadora en su teléfono de empresa: conteste y haga llamadas, con cada llamada grabada y transcrita por usted. Beta pública gratuita."
>
  <!-- Hero -->
  <section class="relative mb-20 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        beta pública gratuita
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      Su línea de empresa,<br />en su escritorio.<br />
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">Grabada y transcrita.</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      WaveKat Voice es una app de teléfono para su computadora. Conecte el proveedor de telefonía que
      ya usa y conteste y haga llamadas directamente desde su escritorio, con cada conversación grabada
      y transcrita por usted automáticamente, y sin que nada salga de su computadora salvo que usted lo quiera.
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <VoiceDownload />
      <a
        href="/es/voice/download/"
        class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        Detalles de instalación
        <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {macDownload.arch} · <a href="/es/voice/changelog/" title="Vea las novedades de esta versión" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{macDownload.version}</a> · gratis durante la beta</p>
      <p data-dl-meta="linux" class="hidden">Linux · {linuxDownload.arch} · <a href="/es/voice/changelog/" title="Vea las novedades de esta versión" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{linuxDownload.version}</a> · gratis durante la beta</p>
    </div>
  </section>

  <!-- Features -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Qué hace</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((f) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors" style="background-color: #ff6d0014;">
            <f.icon class="w-4 h-4" style="color: #ff6d00" />
          </span>
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Cómo funciona</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Para quién es</h2>
    <a
      href="/es/voice/use-cases/"
      class="group block rounded border border-gray-200 dark:border-white/10 p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
    >
      <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">Negocios que funcionan al teléfono</span>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
        Clínicas, peluquerías, oficios, despachos de abogados, restaurantes, administradores de
        fincas: cualquiera para quien una llamada es un cliente. Vea dónde encaja WaveKat Voice.
      </p>
      <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
        wavekat.com/voice/use-cases →
      </span>
    </a>
  </section>

  <!-- Download CTA -->
  <section class="mb-16">
    <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
      <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">¿Listo para probarlo?</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
        Gratis durante la beta pública. Instálelo en un minuto, conecte su número y atienda su próxima llamada desde su escritorio.
      </p>
      <div class="flex justify-center">
        <VoiceDownload variant="cta" />
      </div>
    </div>
  </section>

  <!-- Q&A -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Preguntas y respuestas</h2>
    <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
      {faqs.map((f) => (
        <details class="group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
            {f.q}
            <span class="shrink-0 text-gray-400 transition-transform group-open:rotate-45" style="color: #ff6d00" aria-hidden="true">+</span>
          </summary>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
            {f.a}
            {f.link && (
              <a
                href={f.link.href}
                class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity"
                style="color: #ff6d00"
              >
                {f.link.label}
                <ArrowRight class="w-3 h-3" />
              </a>
            )}
          </p>
        </details>
      ))}
    </div>
  </section>

  <TalkCTA />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
