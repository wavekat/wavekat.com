---
import Voice from '../../../layouts/Voice.astro';
import { PhoneCall, Mic, FileText } from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getMacDownload, getLinuxDownload } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

const steps = [
  {
    n: '1',
    title: 'Download öffnen',
    body: 'Auf einem Mac doppelklicken Sie die .dmg-Datei und ziehen WaveKat Voice in den Programme-Ordner. Unter Linux öffnen Sie die .deb-Datei in Ihrem Software-Installer oder installieren sie im Terminal mit apt oder dpkg.',
  },
  {
    n: '2',
    title: 'Starten',
    body: 'Öffnen Sie WaveKat Voice, sobald es installiert ist. Es hält sich unauffällig im Hintergrund und ist bereit, wann immer das Telefon klingelt.',
  },
  {
    n: '3',
    title: 'Nummer verbinden',
    body: 'Eine kurze Einrichtung führt Sie durch die Anmeldung bei Ihrem Telefonanbieter — wählen Sie ihn aus der Liste, und den Rest füllen wir für Sie aus.',
  },
];

const highlights = [
  { icon: PhoneCall, text: 'Anrufe vom Desktop aus tätigen und entgegennehmen' },
  { icon: Mic, text: 'Jeder Anruf auf Ihrem Gerät aufgezeichnet' },
  { icon: FileText, text: 'Live-Transkripte, während Sie sprechen' },
];
---

<Voice
  title="WaveKat Voice herunterladen"
  description="Laden Sie WaveKat Voice für Mac oder Linux herunter — eine Telefon-App, die jeden Anruf aufzeichnet und mitschreibt. Kostenlos zum Ausprobieren."
>
  <!-- Hero / download -->
  <section class="relative mb-16 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        kostenlose öffentliche Beta
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">WaveKat Voice</span> herunterladen
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      Ihre Geschäftsnummer auf Ihrem Desktop — nehmen Sie Anrufe entgegen und tätigen Sie sie, wobei jedes Gespräch für Sie aufgezeichnet
      und mitgeschrieben wird. Verbinden Sie Ihren Telefonanbieter, und in ein paar Minuten sind Sie startklar.
    </p>

    <VoiceDownload />

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {ui.dlArchMac} · <a href="/de/voice/changelog/" title="Sehen Sie, was in dieser Version neu ist" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{macDownload.version}</a> · {macDownload.size}</p>
      <p data-dl-meta="linux" class="hidden">Linux · {ui.dlArchLinux} · <a href="/de/voice/changelog/" title="Sehen Sie, was in dieser Version neu ist" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{linuxDownload.version}</a> · {linuxDownload.size}</p>
    </div>
  </section>

  <!-- What you get -->
  <section class="mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {highlights.map((h) => (
        <div class="rounded p-4 bg-gray-50 dark:bg-wk-surface flex items-start gap-3">
          <h.icon class="w-4 h-4 mt-0.5 shrink-0" style="color: #ff6d00" />
          <span class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">{h.text}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Getting set up -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Einrichtung</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- What you'll need -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Was Sie brauchen</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-3">
      Ein Konto bei einem Telefonanbieter — Twilio, Telnyx, 2talk und weitere. Es ist dieselbe Anmeldung,
      die Sie für jedes Internettelefon verwenden würden, und wenn Sie bereits geschäftliche Anrufe online führen, funktioniert Ihr
      Anbieter mit ziemlicher Sicherheit.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Sie wissen nicht, wo Sie anfangen sollen? Unsere
      <a href="/docs/voice/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">Einrichtungsanleitungen</a>
      führen Sie durch die Wahl eines Anbieters und das Verbinden Ihres ersten Anrufs.
    </p>
  </section>

  <!-- Updates -->
  <section class="mb-4">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Immer aktuell bleiben</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3">
      WaveKat Voice hält sich selbst aktuell. Einmal installiert, sucht es leise im Hintergrund nach neuen Versionen und
      aktualisiert sich — Sie müssen nie wieder hierher zurückkommen, um eine neuere Version herunterzuladen.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      <a href="/de/voice/changelog/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">Sehen Sie, was in jeder Version neu ist →</a>
    </p>
  </section>
</Voice>

<script is:inline>
  // Fire the Google Ads download conversion (label shares the AW account in
  // Base.astro). No-op if gtag isn't loaded.
  document.querySelectorAll('[data-conversion^="download_"]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'conversion', { send_to: 'AW-18128547216' });
      }
    });
  });
</script>
