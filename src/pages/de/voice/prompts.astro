---
// German version of the standalone SEO/GEO landing page for the platform's free
// voice-prompt generator (the tool itself lives at
// platform.wavekat.com/voice/prompts, see wavekat-platform PR #161). This is the
// marketing/answer-engine front door: it explains the tool, targets the "free
// IVR / phone menu voice generator" queries, and hands off to the live app. It
// deliberately does NOT use the Voice layout — that section is the WaveKat Voice
// desktop app, a separate product — so it renders with the plain Base chrome,
// like the homepage.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  PhoneCall,
  ListOrdered,
  Voicemail,
  Clock,
  Music2,
  Sparkles,
  AudioLines,
  Languages,
  Download,
  Zap,
  ArrowRight,
  ArrowUpRight,
} from '@lucide/astro';

// The live tool. No trailing slash — matches the platform's own canonical and
// sitemap entry (apps/web/public/sitemap.xml).
const APP_URL = 'https://platform.wavekat.com/voice/prompts';

const title = 'Kostenloser Ansagen- & IVR-Sprachgenerator | WaveKat';
const description =
  'Verwandeln Sie Text in telefonfertige Ansagen, IVR-Menüs und Anrufbeantworter-Ansagen mit KI-Stimmen in Studioqualität — in genau dem Format, das Ihre Telefonanlage braucht. Kostenlos testen, ganz ohne Konto.';

// What people actually search for and come to make. Each is a concrete,
// quotable phone-audio job the generator does.
const uses = [
  {
    icon: PhoneCall,
    title: 'Telefonansagen',
    body: '„Danke für Ihren Anruf bei Acme Sanitär — wie können wir helfen?“ Eine freundliche, einheitliche Begrüßung bei jedem Anruf.',
  },
  {
    icon: ListOrdered,
    title: 'IVR- & Telefonmenüs',
    body: '„Für Vertrieb die 1, für Support die 2.“ Nehmen Sie jeden Zweig Ihres Telefonmenüs mit einer einzigen Stimme auf.',
  },
  {
    icon: Voicemail,
    title: 'Anrufbeantworter-Ansagen',
    body: 'Eine professionelle Ansage nach dem Signalton für die Momente, in denen niemand abnehmen kann.',
  },
  {
    icon: Clock,
    title: 'Ansagen außerhalb der Zeiten & an Feiertagen',
    body: '„Unser Büro ist über die Feiertage geschlossen und öffnet wieder am Montag um 9 Uhr.“ Einmal einrichten, abspielen, wann Sie es brauchen.',
  },
  {
    icon: Music2,
    title: 'Warteschleifen-Ansagen',
    body: 'Kurze gesprochene Hinweise zwischen der Wartemusik — Öffnungszeiten, eine Aktion, die Bitte um einen Rückruf.',
  },
];

const features = [
  {
    icon: Sparkles,
    title: 'KI-Stimmen in Studioqualität',
    body: 'Eine kuratierte Auswahl kommerzieller Text-to-Speech-Stimmen, freigegeben für den Telefoneinsatz. Wählen Sie eine aus, und Ihre gesamte Anlage klingt wie im Studio aufgenommen.',
  },
  {
    icon: AudioLines,
    title: 'Telefonfertiges Audio',
    body: 'Jeder Clip kommt in den Formaten heraus, die Telefonanlagen erwarten — 8 kHz µ-law, WAV oder MP3 — und lässt sich ohne erneutes Kodieren direkt in Asterisk, FreePBX, 3CX, Twilio und den Rest einspielen.',
  },
  {
    icon: Zap,
    title: 'Kostenlos testen, ohne Anmeldung',
    body: 'Erzeugen Sie Ihre ersten Clips direkt im Browser — kein Konto, keine Karte. Melden Sie sich mit GitHub oder Google an, wenn Sie weitermachen und eine Bibliothek anlegen möchten.',
  },
  {
    icon: Languages,
    title: 'Viele Stimmen & Sprachen',
    body: 'Wählen Sie aus einer Vielfalt von Stimmen in mehreren Sprachen, damit die Ansage Ihre Anrufer so begrüßt, wie sie es erwarten.',
  },
  {
    icon: Download,
    title: 'Herunterladen und loslegen',
    body: 'Dateien werden mit einem klaren, sprechenden Namen heruntergeladen — bereit zum Hochladen in Ihre Telefonanlage oder zur Übergabe an die zuständige Person.',
  },
  {
    icon: AudioLines,
    title: 'Einheitlich über jede Ansage hinweg',
    body: 'Eine Stimme für Begrüßung, Menü, Anrufbeantworter und Warteschleife bedeutet: Anrufer hören eine einzige, stimmige Marke — kein Flickwerk aus verschiedenen Aufnahmen.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Text eingeben',
    body: 'Schreiben Sie die Begrüßung, das Menü oder die Ansage — oder starten Sie mit einem der eingebauten Beispiele und passen Sie es an.',
  },
  {
    n: '2',
    title: 'Stimme wählen',
    body: 'Wählen Sie aus den kuratierten Stimmen und hören Sie vorab, wie Ihr Text klingt. Jederzeit änderbar.',
  },
  {
    n: '3',
    title: 'Datei herunterladen',
    body: 'Erhalten Sie einen telefonfertigen Clip in dem Format, das Ihre Telefonanlage braucht, und laden Sie ihn hoch. Fertig.',
  },
];

const faqs = [
  {
    q: 'Was ist der WaveKat Voice Prompt Generator?',
    a: 'Es ist ein kostenloses Web-Werkzeug, das Text in telefonfertiges Audio verwandelt — Telefonansagen, IVR- und Telefonmenüs, Anrufbeantworter-Ansagen und Warteschleifen-Ansagen — gesprochen von KI-Stimmen in Studioqualität. Sie geben den Text ein, wählen eine Stimme und laden eine Datei herunter, die Ihre Telefonanlage abspielen kann.',
  },
  {
    q: 'Ist es kostenlos?',
    a: 'Ja. Sie können Ihre ersten Clips kostenlos im Browser erzeugen, ganz ohne Konto. Wenn Sie sich mit GitHub oder Google anmelden, entfällt das Limit und Sie können eine Bibliothek Ihrer Ansagen speichern; intensivere Nutzung wird nach denselben kostenlosen und Pro-Stufen abgerechnet wie der Rest der WaveKat-Plattform.',
  },
  {
    q: 'Welches Audioformat erhalte ich, und funktioniert es mit meiner Telefonanlage?',
    a: 'Die Clips kommen in den Formaten heraus, die Telefonanlagen erwarten — 8 kHz µ-law, WAV und MP3 — sodass sie sich ohne erneutes Kodieren direkt in Systeme wie Asterisk, FreePBX, 3CX und Twilio einspielen lassen. Wählen Sie das Format, das Ihr System verlangt, und laden Sie die Datei hoch.',
  },
  {
    q: 'Brauche ich ein Konto, um es auszuprobieren?',
    a: 'Nein. Jeder kann ein paar Clips erzeugen, ohne sich anzumelden. Sie melden sich erst an, wenn Sie über das kostenlose Kontingent hinaus weiter erzeugen und Ihre Ansagen in einer Bibliothek speichern möchten, zu der Sie zurückkehren können.',
  },
  {
    q: 'Darf ich die Clips für meine geschäftliche Telefonanlage nutzen?',
    a: 'Ja — genau dafür ist der Generator da. Erzeugen Sie Ihre Begrüßung, Ihr Menü, Ihre Anrufbeantworter- und Warteschleifen-Ansagen, laden Sie sie herunter und spielen Sie sie in Ihre Telefonanlage ein.',
  },
  {
    q: 'Wie unterscheidet sich das von WaveKat Voice, der App?',
    a: 'WaveKat Voice ist eine Desktop-App, die Ihren Computer zu Ihrem Geschäftstelefon macht — Anrufe entgegennehmen und tätigen, aufgezeichnet und transkribiert. Der Voice Prompt Generator ist ein separates, kostenloses Web-Werkzeug, das die aufgenommenen Begrüßungen und Menüs erstellt, die Ihre Telefonanlage abspielt. Sie ergänzen einander, aber Sie können jedes für sich nutzen.',
    link: { href: '/de/voice/', label: 'Über WaveKat Voice' },
  },
];

// The app itself, for software rich results and AI answer engines. `url` points
// at the live tool (matching the platform's own WebApplication declaration), so
// engines bind one entity to one canonical app URL; this page is its marketing
// front door, referenced by the sitewide Organization.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'WaveKat Voice Prompt Generator',
  url: APP_URL,
  inLanguage: 'de',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires a modern web browser',
  isAccessibleForFree: true,
  image: 'https://wavekat.com/og.png',
  description:
    'Ein kostenloses Web-Werkzeug, das Text in telefonfertiges Audio verwandelt — Ansagen, IVR-Menüs und Anrufbeantworter-Ansagen — mithilfe von KI-Stimmen in Studioqualität.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description}>
  <Header />

  <div class="max-w-4xl mx-auto px-6 pt-12 pb-12">
    <!-- Hero -->
    <section class="relative mb-20 pt-4">
      <!-- brand-orange glow -->
      <div
        class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
        style="background: radial-gradient(circle, var(--color-wk-orange) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="flex items-center gap-2 mb-5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-wk-orange/25 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase text-wk-orange">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse bg-wk-orange"></span>
          kostenlos · zum Testen ohne Anmeldung
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
        Kostenloser Ansagen- &amp; IVR-<br />
        <span class="bg-gradient-to-r from-wk-orange to-[#ffa14d] bg-clip-text text-transparent">Sprachgenerator.</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
        Der WaveKat Voice Prompt Generator verwandelt beliebigen Text in telefonfertiges Audio — Telefonansagen,
        IVR-Menüs, Anrufbeantworter- und Warteschleifen-Ansagen — gesprochen von KI-Stimmen in Studioqualität, in
        genau dem Format, das Ihre Telefonanlage braucht. Kostenlos im Browser testen; melden Sie sich an, um eine
        Bibliothek zu speichern.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href={APP_URL}
          class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
        >
          Kostenlos testen
          <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href="#how"
          class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          So funktioniert es
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-600">
        Läuft unter <span class="font-mono">platform.wavekat.com/voice/prompts</span> · kein Download, keine Karte
      </p>
    </section>

    <!-- What you can make -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Was Sie erstellen können</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {uses.map((u) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <u.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{u.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Warum Sie es nutzen sollten</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <f.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mb-16 scroll-mt-24">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">So funktioniert es</h2>
      <ol class="space-y-4">
        {steps.map((s) => (
          <li class="flex gap-4">
            <span
              class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white bg-wk-orange"
            >
              {s.n}
            </span>
            <div>
              <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Try CTA -->
    <section class="mb-16">
      <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
        <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">Erstellen Sie jetzt Ihre erste Ansage</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
          Kostenlos im Browser testen — kein Download, kein Konto. Tippen Sie eine Zeile, wählen Sie eine Stimme und
          laden Sie in unter einer Minute einen telefonfertigen Clip herunter.
        </p>
        <div class="flex justify-center">
          <a
            href={APP_URL}
            class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
          >
            Voice Prompt Generator öffnen
            <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </section>

    <!-- Q&A -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Fragen &amp; Antworten</h2>
      <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
              {f.q}
              <span class="shrink-0 text-wk-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
              {f.a}
              {f.link && (
                <a
                  href={f.link.href}
                  class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
                >
                  {f.link.label}
                  <ArrowRight class="w-3 h-3" />
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
