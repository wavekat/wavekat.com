---
// German version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully German. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import VoiceOverview from '../../../components/VoiceOverview.astro';
import {
  PhoneCall,
  PhoneForwarded,
  PhoneIncoming,
  MousePointerClick,
  AudioLines,
  Mic,
  FileText,
  Terminal,
  Server,
  Cloud,
  Languages,
  Lock,
} from '@lucide/astro';
import { getDownload, MAC_APP_STORE_URL } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const macDownload = await getDownload('mac');
const linuxDownload = await getDownload('linux-x64');
const windowsDownload = await getDownload('windows-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

// Locale code for the per-language app screenshots (/screenshots/<scene>/<code>.webp).
const imgCode = 'de';

// The three headline capabilities, each shown next to the screenshot that
// proves it. The rest of the features render as a grid below.
const spotlights = [
  {
    icon: PhoneIncoming,
    title: 'Nimmt ab, wenn Sie nicht können',
    body: 'Weisen Sie Ihrer Leitung einen Anrufablauf zu, und WaveKat Voice nimmt für Sie ab — Begrüßung, Öffnungszeiten, Telefonmenü, Anrufbeantworter oder Weiterleitung. Die Arbeit einer automatischen Telefonzentrale, auf Ihrem eigenen Computer. Sie sehen jeden Schritt live und können den Anruf mitten in der Nachricht übernehmen.',
    scene: 'flow-answering',
    alt: 'WaveKat Voice unter Ubuntu — ein Anruf, den ein Ablauf annimmt: „Empfang nimmt an" mit „Nimmt eine Nachricht auf…" und dem Namen des Anrufers.',
    link: { href: '/de/blog/answer-calls-with-a-call-flow/', label: 'So funktioniert es' },
  },
  {
    icon: PhoneForwarded,
    title: 'Halten, wechseln und weiterleiten',
    body: 'Legen Sie einen Anrufer in die Warteschleife, nehmen Sie eine zweite Leitung an und wechseln Sie zwischen beiden — leiten Sie ihn dann direkt weiter oder erst nach einem kurzen Wort unter vier Augen. Was in der Warteschleife passiert, bleibt aus der Aufzeichnung und dem Transkript heraus.',
    scene: 'in-call-transfer',
    alt: 'WaveKat Voice auf dem Desktop mitten in einer Weiterleitung mit Rückfrage — der Anrufer wird gehalten, daneben die Schaltfläche Weiterleitung abschließen.',
    link: { href: '/de/blog/hold-switch-and-transfer-calls/', label: 'So funktioniert es' },
  },
  {
    icon: Terminal,
    title: 'Einen KI-Assistenten wählen lassen',
    body: 'Schalten Sie die Automatisierung ein, und ein Kommandozeilenwerkzeug — oder ein KI-Assistent wie Claude — kann Anrufe für Sie tätigen, darauf warten und sie beenden. Es bedient das Wählfeld; sprechen tun Sie. Standardmäßig ausgeschaltet, bis Sie es aktivieren.',
    scene: 'settings-automation-agents',
    alt: 'WaveKat Voice, Einstellungen → Automatisierung — KI-Assistenten wie Claude und Cursor werden mit einer Ein-Klick-Schaltfläche „Verbinden“ angebunden.',
    link: { href: '/de/blog/place-calls-from-the-command-line/', label: 'So funktioniert es' },
  },
];

const features = [
  {
    icon: PhoneCall,
    title: 'Anrufe direkt vom Desktop',
    body: 'Nehmen Sie Anrufe entgegen und tätigen Sie sie direkt von Ihrem Computer aus — kein Tischtelefon, keine zusätzliche Hardware, kein Browser-Tab, das Sie im Auge behalten müssen. Es wartet unauffällig im Hintergrund, bis das Telefon klingelt.',
  },
  {
    icon: Mic,
    title: 'Jeder Anruf aufgezeichnet',
    body: 'Jedes Gespräch wird automatisch aufgezeichnet und in dem Moment gespeichert, in dem Sie auflegen. Spielen Sie es ab, wann immer Sie es brauchen — keine Einrichtung, nichts, was Sie aktivieren müssten.',
  },
  {
    icon: FileText,
    title: 'Live-Transkription',
    body: 'Sehen Sie die Wörter, während sie gesprochen werden. Ein laufendes Transkript läuft neben dem Anruf mit, sodass Sie das Wesentliche aufnehmen, statt mitzuschreiben.',
  },
  {
    icon: AudioLines,
    title: 'Anrufe in HD',
    body: 'Wenn Ihr Anbieter es unterstützt, handelt WaveKat Voice den Opus-Codec aus — für breitbandige, gestochen klare HD-Sprache — und fällt von selbst auf Standardqualität zurück, wenn das nicht möglich ist. Es gibt nichts einzuschalten.',
  },
  {
    icon: MousePointerClick,
    title: 'Nummer anklicken und anrufen',
    body: 'Schalten Sie Telefon-Links ein, und jeder tel:- oder sip:-Link im Web öffnet WaveKat Voice mit eingetragener Nummer, bereit für Ihren Druck auf Anrufen. Standardmäßig aus — eine Seite kann um einen Anruf bitten, ihn aber nie selbst starten.',
  },
  {
    icon: Server,
    title: 'Funktioniert mit Ihrem Anbieter',
    body: 'Bringen Sie den Telefonanbieter mit, den Sie bereits nutzen — Twilio, Telnyx, 2talk und weitere. Wählen Sie ihn aus der Liste, und die Einrichtung wird für Sie ausgefüllt.',
  },
  {
    icon: Cloud,
    title: 'Synchronisieren, wenn Sie möchten',
    body: 'Melden Sie sich bei Ihrem WaveKat-Konto an, und Ihre Aufzeichnungen und Transkripte werden synchronisiert, sodass Sie sie im Web durchsehen können — und wenn Sie HubSpot verbinden, landet jeder Anruf zusätzlich in Ihrem CRM. Melden Sie sich nicht an, bleibt einfach alles auf Ihrem Computer.',
  },
  {
    icon: Languages,
    title: 'Spricht Ihre Sprache',
    body: 'Die App richtet sich nach der Sprache Ihres Computers und spricht neun — Englisch, Spanisch, Französisch, Deutsch, Italienisch, Japanisch, Koreanisch und Chinesisch in Vereinfacht und Traditionell. Wechseln Sie sie jederzeit in den Einstellungen.',
  },
  {
    icon: Lock,
    title: 'Standardmäßig gehört es Ihnen',
    body: 'Ihre Anrufe, Aufzeichnungen und Transkripte liegen zuerst auf Ihrem eigenen Computer. Nichts wird hochgeladen, es sei denn, Sie entscheiden sich dafür — keine ominöse Firma zwischen Ihnen und Ihren Kunden.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Nummer verbinden',
    body: 'Melden Sie sich beim ersten Öffnen der App bei Ihrem Telefonanbieter an. Wählen Sie ihn aus der Liste, und die Einstellungen werden für Sie ausgefüllt.',
  },
  {
    n: '2',
    title: 'Anruf annehmen',
    body: 'Ein grüner Punkt bedeutet, dass Sie online und erreichbar sind. Annehmen, anrufen, stummschalten, das Tastenfeld nutzen — alles von Ihrem Desktop aus.',
  },
  {
    n: '3',
    title: 'Später nachsehen',
    body: 'Jeder Anruf landet mit Aufzeichnung und Transkript in Ihrem Verlauf, bereit zum erneuten Anhören oder zum Synchronisieren ins Web.',
  },
];

const faqs = [
  {
    q: 'Was genau ist WaveKat Voice?',
    a: 'Eine Desktop-App, die Ihren Computer zu Ihrem Geschäftstelefon macht. Sie melden sich mit Ihrem Telefonanbieter an und können von da an Anrufe direkt von Ihrem Computer aus entgegennehmen und tätigen — wobei jeder Anruf für Sie aufgezeichnet und mitgeschrieben wird.',
  },
  {
    q: 'Brauche ich spezielle Hardware?',
    a: 'Nein. Wenn Sie einen Computer und ein Konto bei einem Telefonanbieter haben, haben Sie alles, was Sie brauchen. Kein Tischtelefon, keine zusätzliche Ausrüstung — ein Headset ist schön, aber nicht erforderlich.',
  },
  {
    q: 'Kann ich einen Anrufer in die Warteschleife legen oder einen Anruf weiterleiten?',
    a: 'Ja. WaveKat Voice kann einen Anrufer in die Warteschleife legen, einen zweiten Anruf annehmen, während der erste wartet, zwischen den Anrufen wechseln und einen Anrufer an jemand anderen weiterleiten — entweder direkt (blind) oder nachdem Sie sich vorher kurz mit der Person abgestimmt haben (begleitet). Solange ein Anruf in der Warteschleife ist, pausieren seine Aufzeichnung und sein Live-Transkript von selbst.',
    link: { href: '/de/blog/hold-switch-and-transfer-calls/', label: 'So funktioniert es' },
  },
  {
    q: 'Kann WaveKat Voice Anrufe automatisch annehmen?',
    a: 'Ja. Ein Anrufablauf beantwortet eingehende Anrufe mit Begrüßung, Öffnungszeiten-Prüfung, Telefonmenü, Anrufbeantworter oder Weiterleitung — die Aufgabe, die andere Telefonsysteme automatische Telefonzentrale nennen. Sie bauen den Ablauf im Web, weisen ihn einer Leitung zu, und die App nimmt damit ab. Jeden Schritt sehen Sie live, und während jemand eine Nachricht hinterlässt, können Sie den Anruf übernehmen.',
    link: { href: '/de/blog/answer-calls-with-a-call-flow/', label: 'So funktioniert es' },
  },
  {
    q: 'Kann ich eine Telefonnummer auf einer Website anklicken, um sie anzurufen?',
    a: 'Ja. Schalten Sie Telefon-Links unter Einstellungen → Allgemein ein; danach öffnet ein Klick auf einen tel:- oder sip:-Link WaveKat Voice mit der Nummer bereits im Anruffeld, bereit für Ihren Druck auf Anrufen. Die Funktion bleibt aus, bis Sie sie einschalten, und eine Webseite kann nur die Nummer eintragen — den Anruf selbst startet sie nie.',
    link: { href: '/de/blog/click-to-call-phone-links/', label: 'So funktioniert es' },
  },
  {
    q: 'Unterstützt WaveKat Voice HD-Audio?',
    a: 'Ja. Wenn Ihr Telefonanbieter es unterstützt, nutzt WaveKat Voice den Opus-Codec für breitbandige — „HD“-Sprache, voller und klarer als eine gewöhnliche Telefonleitung, und fällt automatisch auf Standardqualität (G.711) zurück, wenn das nicht möglich ist. Es gibt nichts zu konfigurieren.',
  },
  {
    q: 'Mit welchen Telefonanbietern funktioniert es?',
    a: 'Mit den meisten gängigen — Twilio, Telnyx, 2talk und weitere. Für die Anbieter, die wir kennen, füllen wir die Einrichtung aus; für alle anderen können Sie die Daten selbst eingeben. Wenn Sie bereits geschäftliche Anrufe über das Internet führen, funktioniert Ihr Anbieter mit ziemlicher Sicherheit.',
  },
  {
    q: 'Wo werden meine Aufzeichnungen und Transkripte gespeichert?',
    a: 'Auf Ihrem Computer. Nichts wird hochgeladen, es sei denn, Sie entscheiden sich dafür. Wenn Sie sich bei einem WaveKat-Konto anmelden, können Ihre Aufzeichnungen und Transkripte synchronisiert werden, sodass Sie sie im Web durchsehen können — andernfalls verlassen sie nie Ihren Computer.',
  },
  {
    q: 'Kann WaveKat Voice Anrufe automatisch in HubSpot protokollieren?',
    a: 'Ja. Verbinden Sie Ihr HubSpot-Konto einmal, und jeder Anruf, den Sie annehmen oder tätigen, wird dort automatisch protokolliert — am passenden Kontakt, mit Ausgang, Dauer und Transkript, und die Aufnahme lässt sich in HubSpots eigenem Player abspielen. Eine Pro-Funktion; alles Übrige decken Webhooks ab.',
    link: { href: '/de/blog/log-calls-in-hubspot/', label: 'So funktioniert es' },
  },
  {
    q: 'Kann ein KI-Assistent für mich Anrufe tätigen?',
    a: 'Ja. Schalten Sie die Automatisierung unter Einstellungen → Automatisierung ein, und ein Kommandozeilenwerkzeug — oder ein verbundener KI-Assistent wie Claude, Cursor oder Windsurf — kann über die App Anrufe tätigen, verfolgen und beenden. Der Assistent bedient das Wählfeld; sprechen tun weiterhin Sie. Es ist standardmäßig ausgeschaltet, und Assistenten lassen sich mit einem Klick verbinden.',
    link: { href: '/de/blog/place-calls-from-the-command-line/', label: 'So funktioniert es' },
  },
  {
    q: 'In welchen Sprachen gibt es die App?',
    a: 'In neun: Englisch, Spanisch, Französisch, Deutsch, Italienisch, Japanisch, Koreanisch und Chinesisch in Vereinfacht und Traditionell. Sie richtet sich automatisch nach der Sprache Ihres Computers, und Sie können jederzeit in den Einstellungen eine andere wählen.',
  },
  {
    q: 'Ist es kostenlos?',
    a: 'Während der Beta ist die Nutzung kostenlos, solange wir es mit echten Unternehmen verfeinern. WaveKat Voice wird später ein kostenpflichtiges Produkt — Beta-Nutzer werden lange vorher informiert, bevor sich das ändert.',
  },
  {
    q: 'Worauf läuft es?',
    a: `Mac, Windows und Linux. Unter macOS läuft es ab Version 12 — ${ui.dlArchMac}; unter Windows sind es Windows 10 und 11; unter Linux ist es ein .deb-Paket für ${ui.dlArchLinux}.`,
  },
  {
    q: 'Gibt es WaveKat Voice im Mac App Store?',
    a: 'Ja. WaveKat Voice steht kostenlos im Mac App Store, und das ist der einfachste Weg, es auf einem Mac zu installieren — Apple übernimmt die Installation und jedes weitere Update. Es ist dieselbe App wie der direkte Download von wavekat.com, den es weiterhin gibt. Vorausgesetzt werden macOS 12 oder neuer und ein Mac mit Apple Chip.',
  },
  {
    q: 'Läuft WaveKat Voice unter Windows?',
    a: 'Ja — Windows 10 und 11, mit getrennten Installationsprogrammen für Intel oder AMD und für Windows auf ARM. Der Windows-Build ist jünger als die für Mac und Linux und noch nicht signiert, deshalb warnt Windows beim ersten Start vor einem unbekannten Herausgeber. WaveKat Voice ist eine Desktop-App, es gibt also keine Version für Handy oder Tablet — sagen Sie uns Bescheid, wenn Sie das brauchen.',
    link: { href: '/de/voice/talk/', label: 'Sagen Sie uns, was Sie brauchen' },
  },
  {
    q: 'Wird es meinen Computer verlangsamen oder stören?',
    a: 'Es ist eine schlanke Desktop-App, die sich im Hintergrund hält, bis ein Anruf kommt, und sich leise im Hintergrund selbst aktualisiert. Einmal installiert, vergessen Sie, dass sie da ist.',
  },
];

// Localised structured data: same shape as the English page, but with the
// German URL and inLanguage so engines bind this variant to de.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Windows, Linux',
  image: 'https://wavekat.com/og.png',
  url: 'https://wavekat.com/de/voice/',
  inLanguage: 'de',
  softwareVersion: macDownload?.version,
  downloadUrl: 'https://wavekat.com/de/voice/download/',
  installUrl: MAC_APP_STORE_URL,
  sameAs: [MAC_APP_STORE_URL],
  description:
    'Eine Desktop-App, die Ihren Computer zu Ihrem Geschäftstelefon macht — Anrufe entgegennehmen und tätigen, wobei jeder Anruf automatisch aufgezeichnet und transkribiert wird. Funktioniert mit dem Telefonanbieter, den Sie bereits haben.',
  featureList: [
    'Anrufe per SIP am Computer annehmen und tätigen',
    'Anrufabläufe: eine automatische Telefonzentrale mit Begrüßung, Öffnungszeiten, Telefonmenü, Anrufbeantworter und Weiterleitung',
    'Halten, Anklopfen sowie Weiterleiten mit und ohne Rückfrage',
    'Automatische Anrufaufzeichnung und Live-Transkription',
    'Click-to-Call über tel:- und sip:-Links im Web',
    'HD-Sprache mit dem Opus-Codec, wenn der Anbieter sie unterstützt',
    'Kommandozeile und MCP-Automatisierung für KI-Assistenten',
    'Automatisches Protokollieren von Anrufen in HubSpot, mit Transkript-Synchronisierung und Aufnahme-Wiedergabe im CRM',
    'Neun App-Sprachen, auf macOS, Windows und Linux',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — Ihr Geschäftstelefon am Desktop"
  description="WaveKat Voice ist eine Desktop-App für Mac, Windows und Linux: Anrufe annehmen und tätigen, jedes Gespräch automatisch aufgezeichnet und mitgeschrieben."
>
  <VoiceOverview
    imgCode={imgCode}
    badge="kostenlose öffentliche Beta"
    h1Lines={['Ihre Geschäftsnummer,', 'auf Ihrem Desktop.']}
    h1Accent="Aufgezeichnet und transkribiert."
    intro="WaveKat Voice ist eine Telefon-App für Ihren Computer. Verbinden Sie den Telefonanbieter, den Sie bereits nutzen, und nehmen Sie Anrufe direkt von Ihrem Desktop aus entgegen und tätigen Sie sie — wobei jedes Gespräch automatisch für Sie aufgezeichnet und mitgeschrieben wird und nichts Ihren Computer verlässt, es sei denn, Sie möchten es."
    installHref="/de/voice/download/"
    installLabel="Installationsdetails"
    changelogHref="/de/voice/changelog/"
    changelogTitle="Sehen Sie, was in dieser Version neu ist"
    freeLabel="kostenlos während der Beta"
    headingFeatures="Was es kann"
    headingHow="So funktioniert es"
    headingWho="Für wen es gedacht ist"
    headingFaq="Fragen & Antworten"
    spotlights={spotlights}
    features={features}
    steps={steps}
    whoTitle="Unternehmen, die vom Telefon leben"
    whoBody="Praxen, Salons, Handwerk, Kanzleien, Restaurants, Hausverwaltungen — alle, für die ein Anruf ein Kunde ist. Sehen Sie, wo WaveKat Voice passt."
    whoHref="/de/voice/use-cases/"
    ctaTitle="Bereit, es auszuprobieren?"
    ctaBody="Kostenlos während der öffentlichen Beta. In einer Minute installiert, Nummer verbinden, und Ihren nächsten Anruf nehmen Sie vom Desktop aus entgegen."
    faqs={faqs}
    macDownload={macDownload}
    linuxDownload={linuxDownload}
    windowsDownload={windowsDownload}
  />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
