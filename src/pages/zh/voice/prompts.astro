---
// Simplified-Chinese version of the standalone SEO/GEO landing page for the
// platform's free voice-prompt generator (the tool itself lives at
// platform.wavekat.com/voice/prompts, see wavekat-platform PR #161). This is the
// marketing/answer-engine front door: it explains the tool, targets the "free
// IVR / phone menu voice generator" queries, and hands off to the live app. It
// deliberately does NOT use the Voice layout — that section is the WaveKat Voice
// desktop app, a separate product — so it renders with the plain Base chrome,
// like the homepage.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  PhoneCall,
  ListOrdered,
  Voicemail,
  Clock,
  Music2,
  Sparkles,
  AudioLines,
  Languages,
  Download,
  Zap,
  ArrowRight,
  ArrowUpRight,
} from '@lucide/astro';

// The live tool. No trailing slash — matches the platform's own canonical and
// sitemap entry (apps/web/public/sitemap.xml).
const APP_URL = 'https://platform.wavekat.com/voice/prompts';

const title = '免费电话系统语音提示与 IVR 生成器';
const description =
  '免费生成电话系统的语音提示：来电问候语、IVR 菜单、语音信箱和等待提示，输出电话系统可直接使用的格式，无需注册。';

// What people actually search for and come to make. Each is a concrete,
// quotable phone-audio job the generator does.
const uses = [
  {
    icon: PhoneCall,
    title: '来电问候语',
    body: '“感谢致电顶顶水管——请问需要什么帮助？”让每一通电话都以一句温暖、一致的问候开场。',
  },
  {
    icon: ListOrdered,
    title: 'IVR 与自动话务员菜单',
    body: '“销售请按 1，客服请按 2。”用同一把嗓音录下电话菜单的每一个分支。',
  },
  {
    icon: Voicemail,
    title: '语音信箱问候语',
    body: '在无人接听时，为来电者留下一句专业得体的“嘟声后请留言”。',
  },
  {
    icon: Clock,
    title: '下班与节假日提示',
    body: '“本办公室节假日休息，将于周一上午 9 点恢复办公。”设置一次，需要时随时播放。',
  },
  {
    icon: Music2,
    title: '等待中的语音通知',
    body: '穿插在等待音乐之间的简短语音提示——营业时间、优惠活动，或回拨引导。',
  },
];

const features = [
  {
    icon: Sparkles,
    title: '录音棚级 AI 语音',
    body: '一组精选的商用文字转语音音色，已获准用于电话场景。选定一把嗓音，你的整套系统听起来就像在录音棚里录制的一样。',
  },
  {
    icon: AudioLines,
    title: '开箱即用的电话音频',
    body: '每段音频都以电话系统所需的格式输出——8 kHz µ-law、WAV 或 MP3——可直接导入 Asterisk、FreePBX、3CX、Twilio 及其他系统，无需重新编码。',
  },
  {
    icon: Zap,
    title: '免费试用，无需注册',
    body: '直接在浏览器里生成你的第一批音频——无需账户，无需绑卡。想继续使用并保存音频库时，再用 GitHub 或 Google 登录即可。',
  },
  {
    icon: Languages,
    title: '多种音色与语言',
    body: '从覆盖多种语言的一系列音色中挑选，让提示音以来电者期待的方式向他们问好。',
  },
  {
    icon: Download,
    title: '下载即用',
    body: '文件以清晰、见名知义的名称下载——可直接上传到电话系统，或交给负责维护的人。',
  },
  {
    icon: AudioLines,
    title: '每段提示音都保持一致',
    body: '问候语、菜单、语音信箱和等待提示用同一把嗓音，来电者听到的就是统一、连贯的品牌形象——而不是东拼西凑的一堆录音。',
  },
];

const steps = [
  {
    n: '1',
    title: '输入你的文案',
    body: '写下问候语、菜单或提示——或者从内置示例中选一个再改成你想要的样子。',
  },
  {
    n: '2',
    title: '挑选一把嗓音',
    body: '从精选音色中选择，并试听你的文案念出来的效果。随时可以更换。',
  },
  {
    n: '3',
    title: '下载文件',
    body: '获取一段符合你电话系统所需格式、可直接使用的音频，上传即可。完成。',
  },
];

const faqs = [
  {
    q: 'WaveKat 语音提示生成器是什么？',
    a: '这是一款免费的网页工具，能把文字变成可直接用于电话系统的音频——来电问候语、IVR 与自动话务员菜单、语音信箱留言，以及等待中的语音通知——由录音棚级 AI 语音念出。你输入文案、挑选一把嗓音，然后下载一个电话系统可以播放的文件。',
  },
  {
    q: '它免费吗？',
    a: '免费。你可以在浏览器里免费生成第一批音频，无需账户。用 GitHub 或 Google 登录可以解除限制，并保存一个属于你的提示音库；用量更大时，会按照与 WaveKat 平台其余部分相同的免费和专业档位计费。',
  },
  {
    q: '我拿到的是什么音频格式？能用在我的电话系统上吗？',
    a: '音频以电话系统所需的格式输出——8 kHz µ-law、WAV 和 MP3——因此可直接导入 Asterisk、FreePBX、3CX 和 Twilio 等系统，完全无需重新编码。选择你的系统要求的格式，上传文件即可。',
  },
  {
    q: '试用需要账户吗？',
    a: '不需要。任何人都可以在不注册的情况下生成几段音频。只有当你想在免费额度之外继续生成，并把提示音保存到一个日后可以回来查看的音频库时，才需要登录。',
  },
  {
    q: '怎样为我的电话系统制作语音提示？',
    a: '把电话系统需要的每一段提示语输入进去——来电问候语、IVR 菜单、语音信箱留言、等待提示——选一个声音，再按你的系统要求的格式下载每个音频。把文件上传到电话系统，它就会播放给来电者听。无需安装任何东西，也无需注册即可开始。',
  },
  {
    q: '一定要有电话系统才能用这些音频吗？',
    a: '不用。如果你已经在跑一套——Asterisk、FreePBX、3CX、Twilio 或托管 VoIP 线路——下载音频上传即可。如果没有，WaveKat Voice 本身就能播放它们：来电流程会用问候语、按键菜单和留言自动接听来电，而每一步的语音都由这个生成器一次配好。',
    link: { href: '/zh/blog/answer-calls-with-a-call-flow/', label: '了解来电流程' },
  },
  {
    q: '它和 WaveKat Voice 这款应用有什么区别？',
    a: 'WaveKat Voice 是一款桌面应用，把你的电脑变成办公电话——接听和拨打电话，并自动录音、转写。而语音提示生成器是一款独立的免费网页工具，用来制作电话系统所播放的那些录制好的问候语和菜单。两者相辅相成，但也都可以单独使用。',
    link: { href: '/zh/voice/', label: '了解 WaveKat Voice' },
  },
];

// The app itself, for software rich results and AI answer engines. `url` points
// at the live tool (matching the platform's own WebApplication declaration), so
// engines bind one entity to one canonical app URL; this page is its marketing
// front door, referenced by the sitewide Organization.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'WaveKat Voice Prompt Generator',
  url: APP_URL,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires a modern web browser',
  isAccessibleForFree: true,
  image: 'https://wavekat.com/og.png',
  inLanguage: 'zh-Hans',
  description:
    '一款免费的网页工具，把文字变成可直接用于电话系统的音频——问候语、IVR 菜单和语音信箱提示音——由录音棚级 AI 语音念出。',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'zh-Hans',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description}>
  <Header />

  <div class="max-w-4xl mx-auto px-6 pt-12 pb-12">
    <!-- Hero -->
    <section class="relative mb-20 pt-4">
      <!-- brand-orange glow -->
      <div
        class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
        style="background: radial-gradient(circle, var(--color-wk-orange) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="flex items-center gap-2 mb-5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-wk-orange/25 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase text-wk-orange">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse bg-wk-orange"></span>
          免费 · 试用无需注册
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
        免费的电话系统<br />
        <span class="bg-gradient-to-r from-wk-orange to-[#ffa14d] bg-clip-text text-transparent">语音提示。</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
        WaveKat 语音提示生成器能把任何文字变成可直接用于电话系统的音频——来电问候语、IVR
        菜单、语音信箱和等待提示——由录音棚级 AI 语音念出，并输出成你的电话系统所需的确切格式。在浏览器里免费试用；登录即可保存你的音频库。
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href={APP_URL}
          class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
        >
          免费试用
          <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href="#how"
          class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          看看它如何运作
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-600">
        运行于 <span class="font-mono">platform.wavekat.com/voice/prompts</span> · 无需下载，无需绑卡
      </p>
    </section>

    <!-- What you can make -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">你能做出什么</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {uses.map((u) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <u.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{u.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">为什么用它</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <f.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mb-16 scroll-mt-24">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">如何运作</h2>
      <ol class="space-y-4">
        {steps.map((s) => (
          <li class="flex gap-4">
            <span
              class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white bg-wk-orange"
            >
              {s.n}
            </span>
            <div>
              <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Try CTA -->
    <section class="mb-16">
      <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
        <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">现在就做出你的第一段提示音</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
          在浏览器里免费试用——无需下载，无需账户。输入一句话、挑一把嗓音，不到一分钟就能下载一段可直接用于电话系统的音频。
        </p>
        <div class="flex justify-center">
          <a
            href={APP_URL}
            class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
          >
            打开语音提示生成器
            <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </section>

    <!-- Q&A -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">问答</h2>
      <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
              {f.q}
              <span class="shrink-0 text-wk-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
              {f.a}
              {f.link && (
                <a
                  href={f.link.href}
                  class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
                >
                  {f.link.label}
                  <ArrowRight class="w-3 h-3" />
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- From the blog: the announcement post (the post links back here) -->
    <p class="text-xs text-gray-500 dark:text-gray-400">
      想看这款工具背后更完整的介绍？
      <a
        href="/zh/blog/phone-menu-ivr-voice-generator/"
        class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
      >
        阅读博客上的发布文章
        <ArrowRight class="w-3 h-3" />
      </a>
    </p>
  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
