---
import Voice from '../../../../layouts/Voice.astro';
import TalkCTA from '../../../../components/TalkCTA.astro';
import { ArrowRight } from '@lucide/astro';
import { getAlternatives } from '../../../../lib/voice-alternatives';
import { getProviders } from '../../../../lib/voice-providers';

const alternatives = getAlternatives('zh-Hans');

// ItemList of the comparison pages — helps search engines see the hub as the
// parent of the individual "<name> alternative" pages.
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  inLanguage: 'zh-Hans',
  itemListElement: alternatives.map((alt, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `WaveKat Voice 对比 ${alt.name}`,
    url: `https://wavekat.com/zh/voice/alternatives/${alt.slug}/`,
  })),
};
---

<Voice
  title="软电话替代方案"
  description="在 Mac 和 Linux 上，将 WaveKat Voice 与 Linphone 等桌面软电话对比。一款专注的办公电话，自动录音并转写每一通通话。"
>
  <section class="mb-12">
    <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
      看看其他替代方案
    </h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      从电脑上打电话有很多方式，大多数是通用型 SIP 客户端。WaveKat Voice 刻意做得更专注：一款办公
      电话，自动录音并写下每一通通话，设置时只需从列表中选择你的运营商。它目前支持 Mac 和 Linux，
      Windows 也在路上。下面是它的对比。
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">对比</h2>
    <div class="grid grid-cols-1 gap-3">
      {alternatives.map((alt) => (
        <a
          href={`/zh/voice/alternatives/${alt.slug}/`}
          class="group block rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5"
        >
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">
            WaveKat Voice 对比 {alt.name}
          </span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">{alt.tagline}</p>
          <span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
            查看对比
            <ArrowRight class="w-3 h-3 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Cross-link to the per-provider setup pages (SIP providers you connect
    to, distinct from the softphone alternatives above). -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">运营商</h2>
    <div class="grid grid-cols-1 gap-3">
      {getProviders('zh-Hans').map((p) => (
        <a
          href={`/zh/voice/providers/${p.slug}/`}
          class="group block rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5"
        >
          <span class="text-sm font-bold flex items-center gap-1.5 mb-1.5 text-gray-900 dark:text-white">
            {p.name}
            <ArrowRight class="w-3.5 h-3.5 text-gray-400 transition-transform group-hover:translate-x-0.5" />
          </span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{p.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <TalkCTA />

  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
</Voice>
