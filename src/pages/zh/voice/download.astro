---
import Voice from '../../../layouts/Voice.astro';
import { PhoneCall, Mic, FileText } from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getDownload } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const linuxDownload = await getDownload('linux-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

const steps = [
  {
    n: '1',
    title: '安装',
    body: '在 Mac 上，App Store 会替你装好 WaveKat Voice，之后在“应用程序”里就能打开；在 Windows 上，Microsoft Store 做的是同一件事。如果你用的是直接下载，在 Mac 上双击 .dmg 文件，把 WaveKat Voice 拖进“应用程序”文件夹，在 Windows 上运行 .exe 文件。在 Linux 上，用你的软件安装器打开 .deb 文件，或在终端里用 apt 或 dpkg 安装。',
  },
  {
    n: '2',
    title: '启动它',
    body: '安装好后打开 WaveKat Voice。它会安静地待在一旁，电话响起时随时就绪。',
  },
  {
    n: '3',
    title: '连接你的号码',
    body: '一段简短的设置会带你登录电话运营商——从列表中选择，剩下的我们为你填好。',
  },
];

// These steps are about the DIRECT .exe only. The Microsoft Store package
// is signed by Microsoft and installs without a warning, so a visitor who
// takes the button never sees any of this — it is here for the one who
// opens Other Platforms and takes the file instead. The download menu's
// "how to get past it" link points at #windows below, deliberately here
// and not at /docs/**, which is English-only.
const windowsSteps = [
  '在 SmartScreen 提示框中点击“更多信息”。',
  '点击“仍要运行”，然后按安装程序的提示操作。',
  '这样就好了——Windows 不会再问，之后的更新也会在后台静默安装。',
];

const highlights = [
  { icon: PhoneCall, text: '在电脑上接听和拨打电话' },
  { icon: Mic, text: '每通电话都录音保存到你的电脑' },
  { icon: FileText, text: '边说边生成实时文字稿' },
];
---

<Voice
  title="下载 WaveKat Voice"
  description="为 Mac、Windows 或 Linux 下载 WaveKat Voice：一款会为你录音并写下每通电话的电话应用。公测期间免费。"
>
  <!-- Hero / download -->
  <section class="relative mb-16 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-72 h-72 sm:w-[28rem] sm:h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        免费公测
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      下载 <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">WaveKat Voice</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      把你的办公电话搬到桌面上——接听和拨打电话，每通对话都为你录音并写成文字。
      连接你的电话运营商，几分钟就能上线。
    </p>

    <VoiceDownload />

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {ui.dlArchMac} · Mac App Store 免费下载 · <a href="/zh/voice/changelog/" title="查看此版本的更新内容" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
      <p data-dl-meta="linux" class="hidden">Linux · <a href="/zh/voice/changelog/" title="查看此版本的更新内容" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="linux">{linuxDownload?.version}</span></a> · <span data-dl-size="linux">{linuxDownload?.size}</span></p>
      <p data-dl-meta="windows" class="hidden">{ui.dlArchMsStore} · Microsoft Store 免费下载 · <a href="/zh/voice/changelog/" title="查看此版本的更新内容" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
    </div>
  </section>

  <!-- What you get -->
  <section class="mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {highlights.map((h) => (
        <div class="rounded p-4 bg-gray-50 dark:bg-wk-surface flex items-start gap-3">
          <h.icon class="w-4 h-4 mt-0.5 shrink-0" style="color: #ff6d00" />
          <span class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">{h.text}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Getting set up -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">开始设置</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Installing on Windows -->
  <section id="windows" class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">在 Windows 上安装</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-4">
      WaveKat Voice 已在 Microsoft Store 上架，支持 Windows 10 和 11，这也是最省事的安装方式：同一个商店页面同时覆盖 Intel、AMD 电脑和 ARM 电脑，商店会把适合你这台机器的版本交给你，并持续更新。安装包由 Microsoft 签名，首次启动不会弹出安全提示。
    </p>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-5">
      “其他平台”里的 .exe 直接下载尚未进行代码签名，因此第一次运行时，Windows SmartScreen 会弹出蓝色的“Windows 已保护你的电脑”提示。这条警告说的是我们还没购买的证书，而不是文件本身——按下面几步继续即可。
    </p>
    <ol class="space-y-3 mb-5 max-w-xl">
      {windowsSteps.map((s, i) => (
        <li class="flex gap-3">
          <span
            class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold text-white"
            style="background-color: #ff6d00"
          >
            {i + 1}
          </span>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed pt-0.5">{s}</p>
        </li>
      ))}
    </ol>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      两个直接下载的版本都在“其他平台”里，由你自己挑：“下载 Windows 版”是给 Intel 与 AMD 电脑的 64 位版本，“下载 ARM 版 Windows”是给骁龙等 ARM 电脑的原生版本。
    </p>
  </section>

  <!-- What you'll need -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">你需要准备什么</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-3">
      一个电话运营商账户——Twilio、Telnyx、2talk 等等。这和你用任何网络电话时的登录方式一样，
      如果你已经在网上拨打商务电话，你的运营商几乎一定可用。
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      不知道从哪里开始？我们的
      <a href="/docs/voice/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">设置指南</a>
      会带你挑选运营商，并接通你的第一通电话。
    </p>
  </section>

  <!-- Updates -->
  <section class="mb-4">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">保持最新</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3">
      WaveKat Voice 会自动保持最新。从 Mac App Store 或 Microsoft Store 装的版本，和其他商店应用一样自动更新；
      直接下载的版本会在后台安静地检查并更新到新版本。无论哪一种，你都不用回到这里下载更新的版本。
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      <a href="/zh/voice/changelog/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">查看每个版本的更新内容 →</a>
    </p>
  </section>
</Voice>
