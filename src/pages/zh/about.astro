---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Mail } from '@lucide/astro';

// Mirrors /about/ section-for-section (see src/pages/about.astro).
const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://wavekat.com/zh/about/',
      url: 'https://wavekat.com/zh/about/',
      name: "关于 WaveKat",
      inLanguage: 'zh-Hans',
      mainEntity: { '@id': 'https://wavekat.com/#organization' },
    },
  ],
};
---

<Base
  title="关于 — WaveKat"
  description="WaveKat 构建开源、AI 驱动的语音工具，让每一家小企业都拥有大企业的声音。了解我们在做什么、为什么，以及如何联系我们。"
>
  <Header />

  <div class="max-w-4xl mx-auto px-6 py-12">

    <section class="mb-16">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-5 text-gray-900 dark:text-white">
        关于 WaveKat
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl" set:html={"WaveKat 是一家小而独立的软件公司，为小企业构建开源、AI 驱动的语音工具。旗舰产品 <a href=\"/zh/voice/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat Voice</a> 是一款适用于 Mac 和 Linux 的桌面软电话，会自动录音并转写每一通通话。WaveKat 由创始人 Eason Guo 打造，他开发 WaveKat Voice 及其底层的开源 Rust 库。"} />
    </section>

    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">为什么会有 WaveKat</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3" set:html={"我们的使命是<strong class=\"text-gray-700 dark:text-gray-200\">让每一家小企业都拥有大企业的声音</strong>。大公司有话务台、通话录音、转写文字，以及驱动这一切的软件；一个人的小店只有一部装在忙碌口袋里的手机。WaveKat 构建的工具正是为了缩小这道差距——从电话开始，因为小企业每天都在电话上赢得或失去客户。"} />
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
        语音是我们的起点，但不会是终点。
      </p>
    </section>

    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">我们在做什么</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3" set:html={"<a href=\"/zh/voice/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat Voice</a> 把你的电脑变成企业电话：通过你现有的 SIP 运营商接打电话，每一通通话都在你自己的机器上录音并转写。公测期间免费，还可以<a href=\"/zh/blog/place-calls-from-the-command-line/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">让 AI 助手替你拨打</a>。"} />
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl" set:html={"在它之下是一系列开源 Rust 库——语音活动检测、话轮检测、语音转文字、文字转语音、SIP/RTP 传输——全部发布在 <a href=\"https://github.com/wavekat\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">WaveKat 的 GitHub 组织</a>下，并配有<a href=\"/docs/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">文档</a>。公开构建让我们保持诚实：处理你通话的代码，你可以亲自阅读。"} />
    </section>

    <section class="mb-20">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">联系我们</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-5" set:html={"邮件是联系我们的最佳方式——每一封我们都会阅读。关于 WaveKat Voice 的具体问题，可以从<a href=\"/zh/voice/talk/\" class=\"text-gray-700 dark:text-gray-200 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors\">联系我们</a>页面开始。"} />
      <a
        href="mailto:eason@wavekat.com"
        data-conversion="mailto_click"
        class="inline-flex items-center gap-2 rounded px-4 py-2.5 text-xs font-bold text-white transition-opacity hover:opacity-90"
        style="background-color: #ff6d00"
      >
        <Mail class="w-4 h-4" />
        eason@wavekat.com
      </a>
    </section>

  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
</Base>
