---
// Simplified-Chinese homepage. Mirrors src/pages/index.astro; body copy is
// translated, repo names/colors/links are shared. Locale, hreflang, the
// language switcher and localised header/footer are all derived from the /zh/
// URL by Base/Header — this page just passes its Chinese title/description.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VoiceDownload from '../../components/VoiceDownload.astro';
import { ArrowRight } from '@lucide/astro';

const voicePipeline = [
  {
    name: 'wavekat-vad',
    description: '语音活动检测——支持 WebRTC、Silero、TEN-VAD、FireRedVAD。',
    color: '#00bcd4',
    href: 'https://github.com/wavekat/wavekat-vad',
  },
  {
    name: 'wavekat-turn',
    description: '话轮检测——判断说话者何时讲完。',
    color: '#7c4dff',
    href: 'https://github.com/wavekat/wavekat-turn',
  },
  {
    name: 'wavekat-asr',
    description: '流式语音转文字——用统一的 Rust 接口对接多种 ASR 后端。',
    color: '#f44336',
    href: 'https://github.com/wavekat/wavekat-asr',
  },
  {
    name: 'wavekat-tts',
    description: '文字转语音合成——用统一的 Rust 接口对接多种 TTS 后端。',
    color: '#ff4081',
    href: 'https://github.com/wavekat/wavekat-tts',
  },
  {
    name: 'wavekat-core',
    description: '共享音频基元——AudioFrame、采样格式转换。',
    color: '#00e676',
    href: 'https://github.com/wavekat/wavekat-core',
  },
  {
    name: 'wavekat-sip',
    description: 'SIP 信令与 RTP 传输——REGISTER、INVITE、SDP、会话跟踪。',
    color: '#3f51b5',
    href: 'https://github.com/wavekat/wavekat-sip',
  },
];

const toolsAndClients = [
  {
    name: 'wavekat-lab',
    description: '用于测试和对比各种音频后端的交互式面板。',
    color: '#ffd740',
    href: 'https://github.com/wavekat/wavekat-lab',
  },
  {
    name: 'wavekat-cli',
    description: 'WaveKat 平台的命令行客户端（wk）。',
    color: '#2196f3',
    href: 'https://github.com/wavekat/wavekat-cli',
  },
];
---

<Base
  title="WaveKat — 面向小企业的开源 AI 语音工具"
  description="WaveKat 打造开源、AI 驱动的工具，让小企业也能拥有过去只有大公司才负担得起的能力——从语音开始：一款把电脑变成办公电话、自动录音并转写每通通话的桌面应用。"
>
  <Header />

  <div class="max-w-6xl mx-auto px-6">

    <!-- Hero -->
    <section class="mx-auto max-w-3xl pt-14 pb-20 text-center sm:pt-20 sm:pb-24">
      <a
        href="/zh/voice/"
        class="animate-rise group inline-flex items-center gap-2 rounded-full border border-wk-orange/30 bg-wk-orange/5 py-1.5 pl-4 pr-3 text-xs font-medium text-wk-orange transition-colors hover:border-wk-orange/60 hover:bg-wk-orange/10"
      >
        <span class="font-semibold">WaveKat Voice</span>
        <span class="h-3 w-px bg-wk-orange/30" aria-hidden="true"></span>
        免费公测
        <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
      <h1 class="animate-rise mt-7 text-4xl font-extrabold leading-[1.1] tracking-tight text-gray-900 dark:text-white sm:text-5xl md:text-6xl">
        让每一家小企业，<br />
        <span class="text-gradient-brand">都拥有大公司的声音。</span>
      </h1>
      <p class="animate-rise-late mx-auto mt-7 max-w-2xl text-base leading-relaxed text-gray-500 dark:text-gray-400 sm:text-lg">
        WaveKat 打造 AI 驱动的工具，让小企业也能拥有过去只有大公司才负担得起的能力。我们从语音开始——
        一款把你的电脑变成办公电话的桌面应用，自动录音并写下每一通通话。
      </p>
      <div class="animate-rise-late mt-10 flex flex-wrap items-center justify-center gap-4">
        <VoiceDownload />
        <a
          href="https://github.com/wavekat"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-7 py-3 text-sm font-semibold text-gray-700 transition-all hover:-translate-y-0.5 hover:border-gray-400 hover:bg-gray-900/5 dark:border-white/15 dark:text-gray-200 dark:hover:border-white/30 dark:hover:bg-white/5"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
          在 GitHub 上查看
        </a>
      </div>
    </section>

    <!-- Featured product: WaveKat Voice -->
    <section class="mb-24">
      <h2 class="mb-6 font-mono text-xs font-bold uppercase tracking-widest text-gray-400">我们的应用</h2>
      <div
        class="relative overflow-hidden rounded-3xl border border-wk-orange/25 bg-gray-50/50 dark:bg-wk-surface"
      >
        <div
          class="pointer-events-none absolute -top-32 -right-24 h-96 w-96 rounded-full opacity-20 blur-3xl"
          style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
          aria-hidden="true"
        >
        </div>
        <div class="relative grid items-center gap-10 p-8 sm:p-10 md:grid-cols-2">
          <div>
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <span class="text-2xl font-bold tracking-tight text-wk-orange">WaveKat Voice</span>
              <span class="inline-flex items-center rounded-full border border-wk-orange/30 bg-wk-orange/5 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-wk-orange">
                免费公测
              </span>
            </div>
            <p class="mb-7 text-[15px] leading-relaxed text-gray-600 dark:text-gray-300">
              一款运行在你电脑上的电话应用。用你已经在用的电话运营商，直接在桌面上接听和拨打电话——
            每通对话都自动为你录音并写成文字。你甚至可以让 AI 助手替你拨打电话。
            </p>
            <a
              href="/zh/voice/"
              class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/35"
            >
              了解更多并下载
              <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
          <img
            src="/screenshots/in-call/zh-Hans.webp"
            alt="WaveKat Voice 通话进行中，实时转写通话内容"
            width="1200"
            height="872"
            loading="lazy"
            decoding="async"
            class="w-full rounded-xl shadow-2xl shadow-black/20"
          />
        </div>
      </div>
    </section>

    <!-- Libraries -->
    <section>
      <h2 class="mb-8 font-mono text-xs font-bold uppercase tracking-widest text-gray-400">开源库</h2>

      <h3 class="mb-4 text-lg font-bold tracking-tight text-gray-900 dark:text-white">语音流水线</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {voicePipeline.map((lib) => (
          <a
            href={lib.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-2xl border border-[color:var(--lib-soft)] bg-gray-50/50 p-6 transition-all hover:-translate-y-0.5 hover:border-[color:var(--lib)] hover:shadow-[0_12px_32px_-16px_var(--lib)] dark:bg-wk-surface"
            style={`--lib: ${lib.color}; --lib-soft: ${lib.color}30;`}
          >
            <span class="mb-2 block font-mono text-sm font-bold" style={`color: ${lib.color}`}>{lib.name}</span>
            <p class="mb-5 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{lib.description}</p>
            <span class="font-mono text-xs text-gray-400 transition-colors group-hover:text-gray-700 dark:text-gray-600 dark:group-hover:text-gray-300">
              github.com/wavekat/{lib.name} →
            </span>
          </a>
        ))}
      </div>

      <h3 class="mb-4 mt-10 text-lg font-bold tracking-tight text-gray-900 dark:text-white">工具与客户端</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {toolsAndClients.map((lib) => (
          <a
            href={lib.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded-2xl border border-[color:var(--lib-soft)] bg-gray-50/50 p-6 transition-all hover:-translate-y-0.5 hover:border-[color:var(--lib)] hover:shadow-[0_12px_32px_-16px_var(--lib)] dark:bg-wk-surface"
            style={`--lib: ${lib.color}; --lib-soft: ${lib.color}30;`}
          >
            <span class="mb-2 block font-mono text-sm font-bold" style={`color: ${lib.color}`}>{lib.name}</span>
            <p class="mb-5 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{lib.description}</p>
            <span class="font-mono text-xs text-gray-400 transition-colors group-hover:text-gray-700 dark:text-gray-600 dark:group-hover:text-gray-300">
              github.com/wavekat/{lib.name} →
            </span>
          </a>
        ))}
      </div>
    </section>


  </div>

  <Footer />
</Base>
