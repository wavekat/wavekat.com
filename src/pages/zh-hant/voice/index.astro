---
// Traditional-Chinese version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully Chinese. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import VoiceOverview from '../../../components/VoiceOverview.astro';
import {
  PhoneCall,
  PhoneForwarded,
  PhoneIncoming,
  MousePointerClick,
  AudioLines,
  Mic,
  FileText,
  Terminal,
  Server,
  Cloud,
  Languages,
  Lock,
} from '@lucide/astro';
import { getDownload, MAC_APP_STORE_URL, MS_STORE_URL } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const macDownload = await getDownload('mac');
const linuxDownload = await getDownload('linux-x64');
const windowsDownload = await getDownload('windows-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

// Locale code for the per-language app screenshots (/screenshots/<scene>/<code>.webp).
const imgCode = 'zh-Hant';

// The three headline capabilities, each shown next to the screenshot that
// proves it. The rest of the features render as a grid below.
const spotlights = [
  {
    icon: PhoneIncoming,
    title: '你忙不過來時它來接',
    body: '把一個通話流程指給你的線路，WaveKat Voice 就會替你接聽——問候語、營業時間、按鍵選單、留言或轉接。這正是自動總機做的事，只不過跑在你自己的電腦上；每一步你都看得到，還能在留言途中把電話接過來。',
    scene: 'flow-answering',
    alt: 'Ubuntu 上的 WaveKat Voice —— 一通由流程接聽的電話：「櫃檯接待 正在接聽」，下方顯示「正在錄製留言…」和來電者的名字。',
    link: { href: '/zh-hant/blog/answer-calls-with-a-call-flow/', label: '了解運作方式' },
  },
  {
    icon: PhoneForwarded,
    title: '保留、切換與轉接',
    body: '把一通來電轉為保留，接起第二條線路，並在兩者之間切換——接著可以直接轉接，或先低聲交代幾句再轉。保留期間發生的一切都不會進入錄音和文字稿。',
    scene: 'in-call-transfer',
    alt: '桌面上的 WaveKat Voice，正在進行詢問轉接——來電者處於保留狀態，旁邊是完成轉接按鈕。',
    link: { href: '/zh-hant/blog/hold-switch-and-transfer-calls/', label: '了解運作方式' },
  },
  {
    icon: Terminal,
    title: '讓 AI 助理替你撥號',
    body: '開啟自動化，命令列工具——或像 Claude 這樣的 AI 助理——就能替你撥號、等待接聽並結束通話。助理負責操作撥號盤；說話的依然是你。在你主動開啟之前一直關閉。',
    scene: 'settings-automation-agents',
    alt: 'WaveKat Voice 的 設定 → 自動化——透過一鍵連接按鈕接入 Claude、Cursor 等 AI 助理。',
    link: { href: '/zh-hant/blog/place-calls-from-the-command-line/', label: '了解運作方式' },
  },
];

const features = [
  {
    icon: PhoneCall,
    title: '在電腦上打電話',
    body: '直接在電腦上接聽和撥打電話——不需要話機、不需要額外硬體，也不用盯著瀏覽器分頁。它安靜地待在一旁，電話響起時才出現。',
  },
  {
    icon: Mic,
    title: '每通電話自動錄音',
    body: '每一通對話都會自動錄音，掛斷的那一刻就儲存好。隨時可以回放——無需設定，也不用記得去打開開關。',
  },
  {
    icon: FileText,
    title: '即時轉寫',
    body: '邊說邊看到文字。通話旁邊滾動顯示即時文字稿，讓你專注於重要內容，而不是埋頭記筆記。',
  },
  {
    icon: AudioLines,
    title: 'HD 高清通話',
    body: '在你的電信業者支援時，WaveKat Voice 會協商採用 Opus 編解碼器，帶來寬頻、HD 清晰的語音——無法支援時則會自動退回標準音質。無須手動開啟。',
  },
  {
    icon: MousePointerClick,
    title: '點一下號碼就能撥',
    body: '打開電話連結，網頁上任何 tel: 或 sip: 連結都會在 WaveKat Voice 裡開啟，號碼已填好，只等你按下撥號。預設關閉——網頁只能請求通話，不能替你撥出。',
  },
  {
    icon: Server,
    title: '相容你的電信業者',
    body: '沿用你已經在用的電話電信業者——Twilio、Telnyx、2talk 等等。從清單中選擇，設定就為你填好了。',
  },
  {
    icon: Cloud,
    title: '需要時才同步',
    body: '登入你的 WaveKat 帳號，錄音和文字稿會同步上來，方便你在網頁端查看——連接之後，每通電話還能自動記錄到你的 HubSpot CRM。不登入，一切就只留在你自己的電腦上。',
  },
  {
    icon: Languages,
    title: '會說你的語言',
    body: '應用程式會跟隨你電腦的語言，共支援九種——英文、西班牙文、法文、德文、義大利文、日文、韓文，以及簡體與繁體中文。隨時可在設定中切換。',
  },
  {
    icon: Lock,
    title: '資料預設歸你',
    body: '你的通話、錄音和文字稿首先儲存在你自己的電腦上。除非你主動選擇，否則不會上傳——你和客戶之間沒有任何神秘的第三方。',
  },
];

const steps = [
  {
    n: '1',
    title: '連接你的號碼',
    body: '第一次打開應用程式時登入你的電話電信業者。從清單中選擇，設定就為你填好了。',
  },
  {
    n: '2',
    title: '接聽電話',
    body: '綠點代表你在線、可被呼入。接聽、撥出、靜音、使用撥號鍵盤——全都在你的電腦上完成。',
  },
  {
    n: '3',
    title: '隨後回顧',
    body: '每通電話連同錄音和文字稿一起進入你的通話記錄，隨時可以重溫或同步到網頁端。',
  },
];

const faqs = [
  {
    q: 'WaveKat Voice 到底是什麼？',
    a: '一款把你的電腦變成辦公電話的桌面應用程式。用你的電話電信業者帳號登入，從此就能直接在電腦上接聽和撥打電話——每通電話都為你錄音並轉寫成文字。',
  },
  {
    q: '需要什麼特殊硬體嗎？',
    a: '不需要。只要有一台電腦和一個電話電信業者帳號，你就萬事俱備了。不需要話機、不需要額外裝置——有副耳機更好，但不是必須的。',
  },
  {
    q: '我可以把來電轉為保留或轉接通話嗎？',
    a: '可以。WaveKat Voice 能把來電轉為保留、在第一通等待時接起第二通、在通話之間切換，並把來電轉接給其他人——可以直接轉接（盲轉），也可以先與對方確認再轉（諮詢轉接）。通話處於保留時，它的錄音和即時文字稿會自動暫停。',
    link: { href: '/zh-hant/blog/hold-switch-and-transfer-calls/', label: '了解運作方式' },
  },
  {
    q: 'WaveKat Voice 可以自動接聽來電嗎？',
    a: '可以。通話流程會用問候語、營業時間判斷、按鍵選單、留言或轉接來接聽你的來電——也就是別的電話系統所說的自動總機。你在網頁上建好流程，把它指給某條線路，應用程式就用它來接聽。每一步都能即時看到，來電者留言時你還能把電話接過來。',
    link: { href: '/zh-hant/blog/answer-calls-with-a-call-flow/', label: '了解運作方式' },
  },
  {
    q: '我可以點按網頁上的電話號碼直接撥打嗎？',
    a: '可以。在設定 → 一般裡打開電話連結，之後點按 tel: 或 sip: 連結，WaveKat Voice 就會開啟，號碼已經填在撥號欄裡，只等你按下撥號。這項設定預設關閉；網頁只能把號碼填進來，永遠不能自己把電話撥出去。',
    link: { href: '/zh-hant/blog/click-to-call-phone-links/', label: '了解運作方式' },
  },
  {
    q: 'WaveKat Voice 支援 HD 高清通話嗎？',
    a: '支援。在你的電話電信業者支援時，WaveKat Voice 會採用 Opus 編解碼器帶來寬頻——「HD」——語音，比一般電話線路更飽滿、更清晰；不支援時則自動退回標準音質（G.711）。完全無須設定。',
  },
  {
    q: '它相容哪些電話電信業者？',
    a: '大多數常見的電信業者——Twilio、Telnyx、2talk 等等。我們認識的電信業者，設定會自動為你填好；其他的也可以自己填寫詳情。如果你已經在透過網路撥打商務電話，你的電信業者幾乎一定可用。',
  },
  {
    q: '我的錄音和文字稿儲存在哪裡？',
    a: '在你自己的電腦上。除非你決定上傳，否則什麼都不會上傳。如果你登入 WaveKat 帳號，錄音和文字稿可以同步，方便你在網頁端查看——否則它們永遠不會離開你的電腦。',
  },
  {
    q: 'WaveKat Voice 能把通話自動記錄到 HubSpot 嗎？',
    a: '可以。連接一次你的 HubSpot 帳號，之後你接聽或撥出的每一通電話都會自動記錄到那裡——按號碼落在相符的聯絡人名下，帶著結果、時長和轉寫，錄音還能在 HubSpot 自帶的播放器裡播放。這是一項 Pro 功能；其他系統可以透過 Webhook 對接。',
    link: { href: '/zh-hant/blog/log-calls-in-hubspot/', label: '了解運作方式' },
  },
  {
    q: 'AI 助理能替我打電話嗎？',
    a: '可以。在 設定 → 自動化 中開啟自動化，命令列工具——或像 Claude、Cursor、Windsurf 這樣已連接的 AI 助理——就能透過應用程式撥打、跟進和結束通話。助理負責操作撥號盤；說話的依然是你。它預設關閉，而助理只需一鍵即可連接。',
    link: { href: '/zh-hant/blog/place-calls-from-the-command-line/', label: '了解運作方式' },
  },
  {
    q: '這款應用支援哪些語言？',
    a: '九種：英文、西班牙文、法文、德文、義大利文、日文、韓文，以及簡體與繁體中文。它會自動跟隨你電腦的語言，你也可以隨時在設定中改選其他語言。',
  },
  {
    q: '它免費嗎？',
    a: '在公測期間免費使用，我們正與真實的企業一起打磨它。WaveKat Voice 之後會成為付費產品——在此之前，公測使用者會提前收到充分的通知。',
  },
  {
    q: '它能在什麼系統上執行？',
    a: `Mac、Windows 和 Linux。在 macOS 上支援 12 及以上版本，需要${ui.dlArchMac}；Windows 支援 10 和 11；在 Linux 上是面向 ${ui.dlArchLinux} 的 .deb 安裝包。`,
  },
  {
    q: 'WaveKat Voice 在 Mac App Store 上嗎？',
    a: '在。WaveKat Voice 已上架 Mac App Store，免費下載，這也是在 Mac 上安裝它最簡單的方式——安裝和之後的每次更新都由 Apple 處理。它和從 wavekat.com 直接下載的是同一個應用程式，直接下載依然保留。需要 macOS 12 或更新版本，以及搭載 Apple 晶片的 Mac。',
  },
  {
    q: 'WaveKat Voice 在 Microsoft Store 上嗎？',
    a: '在。WaveKat Voice 已上架 Microsoft Store，免費下載，這也是在 Windows 上安裝它最簡單的方式——安裝套件由 Microsoft 簽章，不會跳出「未知發行者」提示，同一個商店頁面同時涵蓋 Intel、AMD 電腦與 ARM 電腦。它和從 wavekat.com 直接下載的 .exe 是同一個應用程式，直接下載依然保留。需要 Windows 10 或 11。',
  },
  {
    q: 'WaveKat Voice 能在 Windows 上執行嗎？',
    a: '可以。WaveKat Voice 支援 Windows 10 和 11，已在 Microsoft Store 上架，同一個商店頁面同時包含 Intel/AMD 與 ARM64 兩個安裝套件。兩種架構也各有直接下載的安裝套件，但它們尚未進行程式碼簽章，首次啟動時 Windows 會提示「未知發行者」；商店版本由 Microsoft 簽章。WaveKat Voice 是桌面應用程式，沒有手機或平板版本——如果你需要，請告訴我們。',
    link: { href: '/zh-hant/voice/talk/', label: '告訴我們你的需求' },
  },
  {
    q: '它會拖慢或干擾我的電腦嗎？',
    a: '它是一款輕量的桌面應用程式，在來電之前一直待在一旁，並在背景安靜地自我更新。裝一次就好，幾乎感覺不到它的存在。',
  },
];

// Localised structured data: same shape as the English page, but with the
// Chinese URL and inLanguage so engines bind this variant to zh-Hant.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Windows, Linux',
  image: 'https://wavekat.com/og.png',
  url: 'https://wavekat.com/zh-hant/voice/',
  inLanguage: 'zh-Hant',
  softwareVersion: macDownload?.version,
  downloadUrl: 'https://wavekat.com/zh-hant/voice/download/',
  installUrl: MAC_APP_STORE_URL,
  sameAs: [MAC_APP_STORE_URL, MS_STORE_URL],
  description:
    '一款把你的電腦變成辦公電話的桌面應用程式——接聽和撥打電話，每通電話都自動錄音並轉寫。相容你已經在用的電話電信業者。',
  featureList: [
    '在電腦上透過 SIP 接聽和撥打電話',
    '通話流程：用問候語、營業時間、按鍵選單、留言或轉接自動接聽的自動總機',
    '保留、話中插接，以及盲轉或詢問轉接',
    '自動錄音與即時轉寫',
    '點按網頁上的 tel: 與 sip: 連結直接撥號',
    '電信業者支援時使用 Opus 編解碼的高清語音',
    '面向 AI 助理的命令列與 MCP 自動化',
    '自動將通話記錄到 HubSpot，支援轉寫同步與 CRM 內錄音播放',
    '九種應用語言，支援 macOS、Windows 與 Linux',
  ],
  // One Offer per storefront, because that is the property that carries
  // "you can get it here" — `sameAs` only says the listing is us. Both are
  // free, so the pair differs by `url` and `seller` alone. `installUrl`
  // above stays single-valued and stays on Apple: Google has only ever
  // documented it against one URL, and an untested array there would trade
  // a property that works for one that might not.
  offers: [
    {
      '@type': 'Offer',
      url: MAC_APP_STORE_URL,
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'Apple App Store' },
    },
    {
      '@type': 'Offer',
      url: MS_STORE_URL,
      price: '0',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      seller: { '@type': 'Organization', name: 'Microsoft Store' },
    },
  ],
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'zh-Hant',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — 把電腦變成你的辦公電話"
  description="WaveKat Voice 是適用於 Mac、Windows 和 Linux 的桌面辦公電話：接聽和撥打電話，每通對話自動錄音並寫成文字。公測免費。"
>
  <VoiceOverview
    imgCode={imgCode}
    badge="免費公測"
    h1Lines={['你的辦公電話，', '就在桌面上。']}
    h1Accent="自動錄音，自動轉寫。"
    intro="WaveKat Voice 是一款執行在你電腦上的電話應用程式。連接你已經在用的電話電信業者，就能直接在桌面上接聽和撥打電話——每通對話都自動為你錄音並寫成文字，除非你願意，否則資料不會離開你的電腦。"
    installHref="/zh-hant/voice/download/"
    installLabel="安裝詳情"
    changelogHref="/zh-hant/voice/changelog/"
    changelogTitle="查看此版本的更新內容"
    freeLabel="公測期間免費"
    headingFeatures="功能一覽"
    headingHow="如何運作"
    headingWho="適合誰用"
    headingFaq="問答"
    spotlights={spotlights}
    features={features}
    steps={steps}
    whoTitle="靠電話運轉的生意"
    whoBody="診所、美容院、各類工匠、律師事務所、餐廳、物業管理——凡是把每通來電都當作一位客戶的人。看看 WaveKat Voice 適合你的哪些情境。"
    whoHref="/zh-hant/voice/use-cases/"
    ctaTitle="想試試看？"
    ctaBody="公測期間免費。一分鐘裝好，連接你的號碼，下一通電話就從桌面接起。"
    faqs={faqs}
    macDownload={macDownload}
    linuxDownload={linuxDownload}
    windowsDownload={windowsDownload}
  />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
