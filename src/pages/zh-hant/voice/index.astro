---
// Traditional-Chinese version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully Chinese. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import TalkCTA from '../../../components/TalkCTA.astro';
import {
  PhoneCall,
  Mic,
  FileText,
  Server,
  Cloud,
  Lock,
  ArrowRight,
} from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getMacDownload, getLinuxDownload } from '../../../lib/voice-download';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

const features = [
  {
    icon: PhoneCall,
    title: '在電腦上打電話',
    body: '直接在電腦上接聽和撥打電話——不需要話機、不需要額外硬體，也不用盯著瀏覽器分頁。它安靜地待在一旁，電話響起時才出現。',
  },
  {
    icon: Mic,
    title: '每通電話自動錄音',
    body: '每一通對話都會自動錄音，掛斷的那一刻就儲存好。隨時可以回放——無需設定，也不用記得去打開開關。',
  },
  {
    icon: FileText,
    title: '即時轉寫',
    body: '邊說邊看到文字。通話旁邊滾動顯示即時文字稿，讓你專注於重要內容，而不是埋頭記筆記。',
  },
  {
    icon: Server,
    title: '相容你的電信業者',
    body: '沿用你已經在用的電話電信業者——Twilio、Telnyx、2talk 等等。從清單中選擇，設定就為你填好了。',
  },
  {
    icon: Cloud,
    title: '需要時才同步',
    body: '登入你的 WaveKat 帳號，錄音和文字稿會同步上來，方便你在網頁端查看。不登入，一切就只留在你自己的電腦上。',
  },
  {
    icon: Lock,
    title: '資料預設歸你',
    body: '你的通話、錄音和文字稿首先儲存在你自己的電腦上。除非你主動選擇，否則不會上傳——你和客戶之間沒有任何神秘的第三方。',
  },
];

const steps = [
  {
    n: '1',
    title: '連接你的號碼',
    body: '第一次打開應用程式時登入你的電話電信業者。從清單中選擇，設定就為你填好了。',
  },
  {
    n: '2',
    title: '接聽電話',
    body: '綠點代表你在線、可被呼入。接聽、撥出、靜音、使用撥號鍵盤——全都在你的電腦上完成。',
  },
  {
    n: '3',
    title: '隨後回顧',
    body: '每通電話連同錄音和文字稿一起進入你的通話記錄，隨時可以重溫或同步到網頁端。',
  },
];

const faqs = [
  {
    q: 'WaveKat Voice 到底是什麼？',
    a: '一款把你的電腦變成辦公電話的桌面應用程式。用你的電話電信業者帳號登入，從此就能直接在電腦上接聽和撥打電話——每通電話都為你錄音並轉寫成文字。',
  },
  {
    q: '需要什麼特殊硬體嗎？',
    a: '不需要。只要有一台電腦和一個電話電信業者帳號，你就萬事俱備了。不需要話機、不需要額外裝置——有副耳機更好，但不是必須的。',
  },
  {
    q: '它相容哪些電話電信業者？',
    a: '大多數常見的電信業者——Twilio、Telnyx、2talk 等等。我們認識的電信業者，設定會自動為你填好；其他的也可以自己填寫詳情。如果你已經在透過網路撥打商務電話，你的電信業者幾乎一定可用。',
  },
  {
    q: '我的錄音和文字稿儲存在哪裡？',
    a: '在你自己的電腦上。除非你決定上傳，否則什麼都不會上傳。如果你登入 WaveKat 帳號，錄音和文字稿可以同步，方便你在網頁端查看——否則它們永遠不會離開你的電腦。',
  },
  {
    q: '它免費嗎？',
    a: '在公測期間免費使用，我們正與真實的企業一起打磨它。WaveKat Voice 之後會成為付費產品——在此之前，公測使用者會提前收到充分的通知。',
  },
  {
    q: '它能在什麼系統上執行？',
    a: `Mac 和 Linux。在 macOS 上支援 12 及以上版本（${macDownload.arch}）；在 Linux 上是面向 ${linuxDownload.arch} 的 .deb 安裝包。`,
  },
  {
    q: '會支援 Windows 或其他裝置嗎？',
    a: 'WaveKat Voice 目前在 Mac 和 Linux 上執行。Windows 和其他平台完全在考慮之內——我們只是會在有真實需求時才去做。所以如果你願意在 Windows 或其他地方使用 WaveKat Voice，請告訴我們。呼聲越高，它來得越快。',
    link: { href: '/zh-hant/voice/talk/', label: '告訴我們你的需求' },
  },
  {
    q: '它會拖慢或干擾我的電腦嗎？',
    a: '它是一款輕量的桌面應用程式，在來電之前一直待在一旁，並在背景安靜地自我更新。裝一次就好，幾乎感覺不到它的存在。',
  },
];

// Localised structured data: same shape as the English page, but with the
// Chinese URL and inLanguage so engines bind this variant to zh-Hant.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Linux',
  url: 'https://wavekat.com/zh-hant/voice/',
  inLanguage: 'zh-Hant',
  softwareVersion: macDownload.version,
  downloadUrl: 'https://wavekat.com/zh-hant/voice/download/',
  description:
    '一款把你的電腦變成辦公電話的桌面應用程式——接聽和撥打電話，每通電話都自動錄音並轉寫。相容你已經在用的電話電信業者。',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'zh-Hant',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — 把電腦變成你的辦公電話"
  description="WaveKat Voice 是一款適用於 Mac 和 Linux 的桌面應用程式，把你的電腦變成辦公電話——接聽和撥打電話，每通對話都為你自動錄音並寫成文字。公測免費。"
>
  <!-- Hero -->
  <section class="relative mb-20 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        免費公測
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      你的辦公電話，<br />就在桌面上。<br />
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">自動錄音，自動轉寫。</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      WaveKat Voice 是一款執行在你電腦上的電話應用程式。連接你已經在用的電話電信業者，就能直接在桌面上
      接聽和撥打電話——每通對話都自動為你錄音並寫成文字，除非你願意，否則資料不會離開你的電腦。
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <VoiceDownload />
      <a
        href="/zh-hant/voice/download/"
        class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        安裝詳情
        <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {macDownload.arch} · <a href="/zh-hant/voice/changelog/" title="查看此版本的更新內容" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{macDownload.version}</a> · 公測期間免費</p>
      <p data-dl-meta="linux" class="hidden">Linux · {linuxDownload.arch} · <a href="/zh-hant/voice/changelog/" title="查看此版本的更新內容" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v{linuxDownload.version}</a> · 公測期間免費</p>
    </div>
  </section>

  <!-- Features -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">功能一覽</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((f) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors" style="background-color: #ff6d0014;">
            <f.icon class="w-4 h-4" style="color: #ff6d00" />
          </span>
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">如何運作</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">適合誰用</h2>
    <a
      href="/zh-hant/voice/use-cases/"
      class="group block rounded border border-gray-200 dark:border-white/10 p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
    >
      <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">靠電話運轉的生意</span>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
        診所、美容院、各類工匠、律師事務所、餐廳、物業管理——凡是把每通來電都當作一位客戶的人。
        看看 WaveKat Voice 適合你的哪些情境。
      </p>
      <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
        wavekat.com/voice/use-cases →
      </span>
    </a>
  </section>

  <!-- Download CTA -->
  <section class="mb-16">
    <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
      <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">想試試看？</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
        公測期間免費。一分鐘裝好，連接你的號碼，下一通電話就從桌面接起。
      </p>
      <div class="flex justify-center">
        <VoiceDownload variant="cta" />
      </div>
    </div>
  </section>

  <!-- Q&A -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">問答</h2>
    <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
      {faqs.map((f) => (
        <details class="group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
            {f.q}
            <span class="shrink-0 text-gray-400 transition-transform group-open:rotate-45" style="color: #ff6d00" aria-hidden="true">+</span>
          </summary>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
            {f.a}
            {f.link && (
              <a
                href={f.link.href}
                class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity"
                style="color: #ff6d00"
              >
                {f.link.label}
                <ArrowRight class="w-3 h-3" />
              </a>
            )}
          </p>
        </details>
      ))}
    </div>
  </section>

  <TalkCTA />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
