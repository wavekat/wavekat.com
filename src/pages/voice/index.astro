---
import Voice from '../../layouts/Voice.astro';
import VoiceOverview from '../../components/VoiceOverview.astro';
import {
  PhoneCall,
  PhoneForwarded,
  PhoneIncoming,
  MousePointerClick,
  AudioLines,
  Mic,
  FileText,
  Terminal,
  Server,
  Cloud,
  Languages,
  Lock,
} from '@lucide/astro';
import { getDownload, MAC_APP_STORE_URL } from '../../lib/voice-download';
import { resolveLocale, t } from '../../lib/i18n';

const macDownload = await getDownload('mac');
const linuxDownload = await getDownload('linux');
const windowsDownload = await getDownload('windows-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

// Locale code for the per-language app screenshots (/screenshots/<scene>/<code>.webp).
const imgCode = 'en';

// The three headline capabilities, each shown next to the screenshot that
// proves it. The rest of the features render as a grid below.
const spotlights = [
  {
    icon: PhoneIncoming,
    title: 'Answers when you can\'t',
    body: 'Point a call flow at your line and WaveKat Voice answers for you — a greeting, your opening hours, a phone menu, voicemail, or a transfer. It\'s the job an auto attendant does, running on your own computer, and you watch each step live and can pick the call up mid-message.',
    scene: 'flow-answering',
    alt: 'WaveKat Voice on the desktop — a call being answered by a flow: "Reception is answering", with "Taking a message…" and the caller\'s name.',
    link: { href: '/blog/answer-calls-with-a-call-flow/', label: 'How it works' },
  },
  {
    icon: PhoneForwarded,
    title: 'Hold, switch, and transfer',
    body: 'Put a caller on hold, pick up a second line, and switch between them — then transfer either straight through or after a quiet word first. Whatever happens on hold stays out of the recording and the transcript.',
    scene: 'in-call-transfer',
    alt: 'WaveKat Voice on the desktop mid attended transfer — the caller on hold and a Complete transfer button to connect them.',
    link: { href: '/blog/hold-switch-and-transfer-calls/', label: 'How it works' },
  },
  {
    icon: Terminal,
    title: 'Let an AI assistant dial',
    body: 'Switch on automation and a command-line tool — or an AI assistant like Claude — can place, wait on, and end calls for you. It works the dialpad; you do the talking. Off until you turn it on.',
    scene: 'settings-automation-agents',
    alt: 'WaveKat Voice Settings → Automation, connecting AI assistants like Claude and Cursor with a one-click Connect button.',
    link: { href: '/blog/place-calls-from-the-command-line/', label: 'How it works' },
  },
];

const features = [
  {
    icon: PhoneCall,
    title: 'Calls from your desktop',
    body: 'Answer and place calls right from your computer — no desk phone, no extra hardware, no browser tab to babysit. It waits quietly out of the way until the phone rings.',
  },
  {
    icon: Mic,
    title: 'Every call recorded',
    body: 'Each conversation is recorded automatically and saved the moment you hang up. Play it back whenever you need it — no setup, nothing to remember to switch on.',
  },
  {
    icon: FileText,
    title: 'Live transcription',
    body: 'See the words as they\'re spoken. A running transcript sits alongside the call, so you can take in what matters instead of scribbling notes.',
  },
  {
    icon: AudioLines,
    title: 'Calls in HD',
    body: 'When your provider supports it, WaveKat Voice negotiates the Opus codec for wideband, HD-clear voice — and falls back to standard quality on its own when it can\'t. Nothing to switch on.',
  },
  {
    icon: MousePointerClick,
    title: 'Click a number to call it',
    body: 'Switch on phone links and any tel: or sip: link on a web page opens WaveKat Voice with the number filled in, ready for you to press Call. Off until you turn it on — a page can ask for a call, never place one.',
  },
  {
    icon: Server,
    title: 'Works with your provider',
    body: 'Bring the phone provider you already use — Twilio, Telnyx, 2talk, and more. Pick it from the list and the setup is filled in for you.',
  },
  {
    icon: Cloud,
    title: 'Sync if you want',
    body: 'Sign in to your WaveKat account and your recordings and transcripts sync up so you can review them on the web — and, if you connect it, every call is logged in your HubSpot CRM. Don\'t sign in, and everything simply stays on your computer.',
  },
  {
    icon: Languages,
    title: 'Speaks your language',
    body: 'The app follows your computer\'s language and speaks nine — English, Spanish, French, German, Italian, Japanese, Korean, and Chinese in both Simplified and Traditional. Switch any time in Settings.',
  },
  {
    icon: Lock,
    title: 'Yours by default',
    body: 'Your calls, recordings, and transcripts live on your own computer first. Nothing is uploaded unless you choose to — no mystery company sitting between you and your customers.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Connect your number',
    body: 'Sign in to your phone provider when you first open the app. Choose it from the list and the settings are filled in for you.',
  },
  {
    n: '2',
    title: 'Take the call',
    body: 'A green dot means you\'re online and reachable. Answer, dial out, mute, use the keypad — all from your desktop.',
  },
  {
    n: '3',
    title: 'Review it later',
    body: 'Every call lands in your history with its recording and transcript, ready to revisit or sync to the web.',
  },
];

const faqs = [
  {
    q: 'What exactly is WaveKat Voice?',
    a: 'A desktop app that turns your computer into your business phone. You sign in with your phone provider, and from then on you can answer and place calls right from your computer — with each call recorded and written down for you.',
  },
  {
    q: 'Do I need any special hardware?',
    a: 'No. If you have a computer and an account with a phone provider, you have everything you need. No desk phone, no extra equipment — a headset is nice but not required.',
  },
  {
    q: 'Can WaveKat Voice answer calls automatically?',
    a: 'Yes. A call flow answers your incoming calls with a greeting, a check of your opening hours, a phone menu, voicemail, or a transfer — the job other phone systems call an auto attendant. You build the flow on the web, point it at one of your lines, and the app answers with it. You see each step as it happens and can take the call over while a caller is leaving a message.',
    link: { href: '/blog/answer-calls-with-a-call-flow/', label: 'How it works' },
  },
  {
    q: 'Can I click a phone number on a website to dial it?',
    a: 'Yes. Turn on phone links in Settings → General and clicking a tel: or sip: link opens WaveKat Voice with the number already in the dial field, ready for you to press Call. It stays off until you turn it on, and a web page can only fill in a number — it can never place the call by itself.',
    link: { href: '/blog/click-to-call-phone-links/', label: 'How it works' },
  },
  {
    q: 'Can I put a caller on hold or transfer a call?',
    a: 'Yes. WaveKat Voice can put a caller on hold, answer a second call while the first one waits, switch between calls, and transfer a caller to someone else — either straight through (blind) or after checking with them first (attended). While a call is on hold, its recording and live transcript pause on their own.',
    link: { href: '/blog/hold-switch-and-transfer-calls/', label: 'How it works' },
  },
  {
    q: 'Does WaveKat Voice support HD audio?',
    a: 'Yes. When your phone provider supports it, WaveKat Voice uses the Opus codec for wideband — "HD" — voice, fuller and clearer than an ordinary phone line, and falls back to standard quality (G.711) automatically when it doesn\'t. There\'s nothing to configure.',
  },
  {
    q: 'Which phone providers does it work with?',
    a: 'Most of the common ones — Twilio, Telnyx, 2talk, and more. We fill in the setup for the providers we know; for anything else you can enter the details yourself. If you already make business calls over the internet, your provider almost certainly works.',
  },
  {
    q: 'Where are my recordings and transcripts kept?',
    a: 'On your computer. Nothing is uploaded unless you decide to. If you sign in to a WaveKat account, your recordings and transcripts can sync so you can review them on the web — otherwise they never leave your computer.',
  },
  {
    q: 'Can WaveKat Voice log calls in HubSpot automatically?',
    a: 'Yes. Connect your HubSpot account once and every call you take or place is logged there automatically — filed on the matching contact with its outcome, duration, and transcript, and with the recording playable in HubSpot\'s own player. It\'s a Pro feature; webhooks cover everything else.',
    link: { href: '/blog/log-calls-in-hubspot/', label: 'How it works' },
  },
  {
    q: 'Can an AI assistant place calls for me?',
    a: 'Yes. Turn on automation in Settings → Automation and a command-line tool — or a connected AI assistant like Claude, Cursor, or Windsurf — can place, follow, and end calls through the app. The assistant works the dialpad; you still do the talking. It\'s off by default, and assistants connect in one click.',
    link: { href: '/blog/place-calls-from-the-command-line/', label: 'How it works' },
  },
  {
    q: 'What languages does the app come in?',
    a: 'Nine: English, Spanish, French, German, Italian, Japanese, Korean, and Chinese in both Simplified and Traditional. It follows your computer\'s language automatically, and you can pick another any time in Settings.',
  },
  {
    q: 'Is it free?',
    a: 'It\'s free to use during the beta while we polish it with real businesses. WaveKat Voice will become a paid product later — beta users will get plenty of notice before that changes.',
  },
  {
    q: 'What does it run on?',
    a: `Mac, Windows and Linux. On macOS it runs on version 12 and later — ${ui.dlArchMac}; on Windows it's Windows 10 and 11; on Linux it's a .deb package for ${ui.dlArchLinux}.`,
  },
  {
    q: 'Is WaveKat Voice on the Mac App Store?',
    a: 'Yes. WaveKat Voice is on the Mac App Store, free to download, and it is the easiest way to install it on a Mac — Apple handles the install and every update after it. It is the same app as the direct download from wavekat.com, which stays available if you prefer it. It needs macOS 12 or later and a Mac with an Apple chip.',
  },
  {
    q: 'Does WaveKat Voice run on Windows?',
    a: 'Yes — Windows 10 and 11, with separate installers for Intel or AMD and for Windows on ARM. The Windows build is younger than the Mac and Linux ones and isn\'t code-signed yet, so Windows shows an "unknown publisher" warning the first time you open it. WaveKat Voice is a desktop app, so there is no phone or tablet version — tell us if that is what you need.',
    link: { href: '/voice/talk/', label: 'Tell us what you need' },
  },
  {
    q: 'Will it slow down or interfere with my computer?',
    a: 'It\'s a lightweight desktop app that stays out of your way until a call comes in, and it updates itself quietly in the background. You install it once and forget it\'s there.',
  },
];

// Structured data: the app itself (eligible for software rich results) and the
// on-page FAQ, built from the same arrays the page renders.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Windows, Linux',
  image: 'https://wavekat.com/og.png',
  url: 'https://wavekat.com/voice/',
  softwareVersion: macDownload?.version,
  downloadUrl: 'https://wavekat.com/voice/download/',
  installUrl: MAC_APP_STORE_URL,
  sameAs: [MAC_APP_STORE_URL],
  description:
    'A desktop app that turns your computer into your business phone — answer and place calls, with every call recorded and transcribed. Works with the phone provider you already have.',
  featureList: [
    'Answer and place calls from your desktop over SIP',
    'Call flows: an auto attendant that answers with a greeting, business hours, phone menu, voicemail, or transfer',
    'Hold, call waiting, and blind or attended transfer',
    'Automatic call recording and live transcription',
    'Click-to-call from tel: and sip: links on any website',
    'HD voice with the Opus codec when the provider supports it',
    'Command line and MCP automation for AI assistants',
    'Automatic call logging to HubSpot, with transcript sync and in-CRM recording playback',
    'Nine app languages, on macOS, Windows and Linux',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — your desktop business phone"
  description="WaveKat Voice is a desktop app for Mac, Windows and Linux that turns your computer into your business phone — every call answered, recorded, and written down."
>
  <VoiceOverview
    imgCode={imgCode}
    badge="free public beta"
    h1Lines={['Your business line,', 'on your desktop.']}
    h1Accent="Recorded and transcribed."
    intro="WaveKat Voice is a phone app for your computer. Connect the phone provider you already use, and answer and place calls right from your desktop — with every conversation recorded and written down for you automatically, and nothing leaving your computer unless you want it to."
    installHref="/voice/download/"
    installLabel="Install details"
    changelogHref="/voice/changelog/"
    changelogTitle="See what's new in this version"
    freeLabel="free during beta"
    headingFeatures="What it does"
    headingHow="How it works"
    headingWho="Who it's for"
    headingFaq="Questions & answers"
    spotlights={spotlights}
    features={features}
    steps={steps}
    whoTitle="Businesses that run on the phone"
    whoBody="Clinics, salons, trades, law firms, restaurants, property managers — anyone for whom a call is a customer. See where WaveKat Voice fits."
    whoHref="/voice/use-cases/"
    ctaTitle="Ready to try it?"
    ctaBody="Free during the public beta. Install in a minute, connect your number, and take your next call from your desktop."
    faqs={faqs}
    macDownload={macDownload}
    linuxDownload={linuxDownload}
    windowsDownload={windowsDownload}
  />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
