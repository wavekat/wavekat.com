---
import Voice from '../../layouts/Voice.astro';
import TalkCTA from '../../components/TalkCTA.astro';
import {
  PhoneCall,
  Mic,
  FileText,
  Server,
  Cloud,
  Lock,
  ArrowRight,
} from '@lucide/astro';
import VoiceDownload from '../../components/VoiceDownload.astro';
import { getMacDownload, getLinuxDownload } from '../../lib/voice-download';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

const features = [
  {
    icon: PhoneCall,
    title: 'Calls from your Mac',
    body: 'Answer and place calls right from your laptop — no desk phone, no extra hardware, no browser tab to babysit. It waits quietly in your menu bar until the phone rings.',
  },
  {
    icon: Mic,
    title: 'Every call recorded',
    body: 'Each conversation is recorded automatically and saved the moment you hang up. Play it back whenever you need it — no setup, nothing to remember to switch on.',
  },
  {
    icon: FileText,
    title: 'Live transcription',
    body: 'See the words as they\'re spoken. A running transcript sits alongside the call, so you can take in what matters instead of scribbling notes.',
  },
  {
    icon: Server,
    title: 'Works with your provider',
    body: 'Bring the phone provider you already use — Twilio, Telnyx, 2talk, and more. Pick it from the list and the setup is filled in for you.',
  },
  {
    icon: Cloud,
    title: 'Sync if you want',
    body: 'Sign in to your WaveKat account and your recordings and transcripts sync up so you can review them on the web. Don\'t sign in, and everything simply stays on your Mac.',
  },
  {
    icon: Lock,
    title: 'Yours by default',
    body: 'Your calls, recordings, and transcripts live on your own computer first. Nothing is uploaded unless you choose to — no mystery company sitting between you and your customers.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Connect your number',
    body: 'Sign in to your phone provider when you first open the app. Choose it from the list and the settings are filled in for you.',
  },
  {
    n: '2',
    title: 'Take the call',
    body: 'A green dot means you\'re online and reachable. Answer, dial out, mute, use the keypad — all from your Mac.',
  },
  {
    n: '3',
    title: 'Review it later',
    body: 'Every call lands in your history with its recording and transcript, ready to revisit or sync to the web.',
  },
];

const faqs = [
  {
    q: 'What exactly is WaveKat Voice?',
    a: 'A Mac app that turns your computer into your business phone. You sign in with your phone provider, and from then on you can answer and place calls right from your laptop — with each call recorded and written down for you.',
  },
  {
    q: 'Do I need any special hardware?',
    a: 'No. If you have a Mac and an account with a phone provider, you have everything you need. No desk phone, no extra equipment — a headset is nice but not required.',
  },
  {
    q: 'Which phone providers does it work with?',
    a: 'Most of the common ones — Twilio, Telnyx, 2talk, and more. We fill in the setup for the providers we know; for anything else you can enter the details yourself. If you already make business calls over the internet, your provider almost certainly works.',
  },
  {
    q: 'Where are my recordings and transcripts kept?',
    a: 'On your Mac. Nothing is uploaded unless you decide to. If you sign in to a WaveKat account, your recordings and transcripts can sync so you can review them on the web — otherwise they never leave your computer.',
  },
  {
    q: 'Is it free?',
    a: 'It\'s free to use during the beta while we polish it with real businesses. WaveKat Voice will become a paid product later — beta users will get plenty of notice before that changes.',
  },
  {
    q: 'What does it run on?',
    a: `Mac and Linux. On macOS it runs on version 12 and later (${macDownload.arch}); on Linux it's a .deb package for ${linuxDownload.arch}.`,
  },
  {
    q: 'Will you support Windows or other devices?',
    a: 'WaveKat Voice runs on Mac and Linux today. Windows and other platforms are absolutely on the table — we just build them when there\'s real demand. So if you\'d use WaveKat Voice on Windows or somewhere else, please tell us. The more people who ask, the sooner it happens.',
    link: { href: '/voice/talk/', label: 'Tell us what you need' },
  },
  {
    q: 'Will it slow down or interfere with my computer?',
    a: 'It\'s a lightweight menu-bar app that stays out of your way until a call comes in, and it updates itself quietly in the background. You install it once and forget it\'s there.',
  },
];
---

<Voice
  title="WaveKat Voice — your business phone, on your Mac"
  description="WaveKat Voice is a Mac app that turns your computer into your business phone — answer and place calls, with every call recorded and written down for you. Free public beta."
>
  <!-- Hero -->
  <section class="relative mb-20 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        free public beta
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      Your business line,<br />on your Mac.<br />
      <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">Recorded and transcribed.</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      WaveKat Voice is a phone app for your Mac. Connect the phone provider you already use, and
      answer and place calls right from your laptop — with every conversation recorded and written
      down for you automatically, and nothing leaving your Mac unless you want it to.
    </p>

    <div class="flex flex-wrap items-center gap-4">
      <VoiceDownload />
      <a
        href="/voice/download/"
        class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        Install details
        <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
    <div class="mt-4 space-y-1.5 text-xs text-gray-400 dark:text-gray-600" data-dl-meta-group>
      <p data-dl-meta="mac">macOS 12+ · {macDownload.arch} · v{macDownload.version} · free during beta</p>
      <p data-dl-meta="linux">Linux · {linuxDownload.arch} · v{linuxDownload.version} · free during beta</p>
    </div>
  </section>

  <!-- Features -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">What it does</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {features.map((f) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors" style="background-color: #ff6d0014;">
            <f.icon class="w-4 h-4" style="color: #ff6d00" />
          </span>
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">How it works</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Who it's for</h2>
    <a
      href="/voice/use-cases/"
      class="group block rounded border border-gray-200 dark:border-white/10 p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
    >
      <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">Businesses that run on the phone</span>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">
        Clinics, salons, trades, law firms, restaurants, property managers — anyone for whom a call
        is a customer. See where WaveKat Voice fits.
      </p>
      <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
        wavekat.com/voice/use-cases →
      </span>
    </a>
  </section>

  <!-- Download CTA -->
  <section class="mb-16">
    <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
      <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">Ready to try it?</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
        Free during the public beta. Install in a minute, connect your number, and take your next call from your Mac.
      </p>
      <div class="flex justify-center">
        <VoiceDownload variant="cta" />
      </div>
    </div>
  </section>

  <!-- Q&A -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Questions &amp; answers</h2>
    <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
      {faqs.map((f) => (
        <details class="group">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
            {f.q}
            <span class="shrink-0 text-gray-400 transition-transform group-open:rotate-45" style="color: #ff6d00" aria-hidden="true">+</span>
          </summary>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
            {f.a}
            {f.link && (
              <a
                href={f.link.href}
                class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity"
                style="color: #ff6d00"
              >
                {f.link.label}
                <ArrowRight class="w-3 h-3" />
              </a>
            )}
          </p>
        </details>
      ))}
    </div>
  </section>

  <TalkCTA />
</Voice>
