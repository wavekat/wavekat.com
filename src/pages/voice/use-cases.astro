---
import Voice from '../../layouts/Voice.astro';
import TalkCTA from '../../components/TalkCTA.astro';
import AppScreenshot from '../../components/AppScreenshot.astro';

const cases = [
  {
    title: 'Clinics & dental offices',
    pain: 'Take booking calls from the front desk laptop, and keep a recorded, transcribed record of what each patient asked for.',
  },
  {
    title: 'Salons & spas',
    pain: 'Answer between clients without a desk phone, and never lose the details of a booking to a missed note.',
  },
  {
    title: 'Trades — plumbers, electricians, HVAC',
    pain: 'Pick up from your laptop on site, and have the address and the job described, captured in the transcript.',
  },
  {
    title: 'Law firms (intake)',
    pain: 'Run intake calls with a verbatim transcript alongside, so nothing said in those high-stakes first minutes slips away.',
  },
  {
    title: 'Restaurants & takeout',
    pain: 'Handle reservations and orders from one screen during the rush — the recording is there if a detail is in question.',
  },
  {
    title: 'Property management',
    pain: 'Field tenant and maintenance calls from anywhere, with a searchable history of who called and what they needed.',
  },
];
---

<Voice
  title="Use cases"
  description="Who WaveKat Voice fits best — small businesses that live on the phone and need calls, recordings, and transcripts in one place."
>
  <section class="mb-12">
    <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
      Who it's for
    </h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      WaveKat Voice fits any small business that runs on the phone. It turns your computer into your
      business line, records and transcribes every call, and keeps it all in one searchable history.
      Here's where that helps most.
    </p>
  </section>

  <AppScreenshot scene="call-details" class="mb-12 mx-auto max-w-xl" />

  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Examples</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {cases.map((c) => (
        <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-[#ff6d00]/40 hover:shadow-lg hover:shadow-[#ff6d00]/5">
          <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{c.title}</span>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{c.pain}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Don't see yours?</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
      This list is where we're starting — not who we're limited to. If your business runs on the
      phone, WaveKat Voice will likely feel right at home. Download it and see, or tell us about your setup.
    </p>
  </section>

  <TalkCTA />
</Voice>
