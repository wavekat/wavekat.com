---
import Voice from '../../layouts/Voice.astro';
import { PhoneCall, Mic, FileText } from '@lucide/astro';
import VoiceDownload from '../../components/VoiceDownload.astro';
import { getDownload } from '../../lib/voice-download';
import { resolveLocale, t } from '../../lib/i18n';

const macDownload = await getDownload('mac');
const linuxDownload = await getDownload('linux');
const windowsDownload = await getDownload('windows-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

const steps = [
  {
    n: '1',
    title: 'Open the download',
    body: 'On a Mac, double-click the .dmg and drag WaveKat Voice into Applications. On Windows, run the .exe and follow the installer. On Linux, open the .deb in your software installer, or install it from a terminal with apt or dpkg.',
  },
  {
    n: '2',
    title: 'Launch it',
    body: 'Open WaveKat Voice once it\'s installed. It sits quietly out of the way, ready whenever the phone rings.',
  },
  {
    n: '3',
    title: 'Connect your number',
    body: 'A short setup walks you through signing in with your phone provider — pick it from the list and we fill in the rest.',
  },
];

// Windows needs one extra beat the other two don't: the build isn't
// code-signed, so SmartScreen stops the first launch. The download menu's
// "how to get past it" link points at #windows below — deliberately here
// and not at /docs/**, which is English-only.
const windowsSteps = [
  'Click "More info" in the SmartScreen box.',
  'Click "Run anyway", then follow the installer.',
  "That's it — Windows won't ask again, and updates install quietly from then on.",
];

const highlights = [
  { icon: PhoneCall, text: 'Place and answer calls from your desktop' },
  { icon: Mic, text: 'Every call recorded to your machine' },
  { icon: FileText, text: 'Live transcripts as you talk' },
];
---

<Voice
  title="Download WaveKat Voice"
  description="Download WaveKat Voice for Mac, Windows or Linux — a phone app that answers, records and writes down every call. Free to try during the beta."
>
  <!-- Hero / download -->
  <section class="relative mb-16 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        free public beta
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      Download <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">WaveKat Voice</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      Your business line on your desktop — answer and place calls, with every conversation recorded
      and written down for you. Connect your phone provider and you're live in a couple of minutes.
    </p>

    <VoiceDownload />

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {ui.dlArchMac} · <a href="/voice/changelog/" title="See what's new in this version" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="mac">{macDownload?.version}</span></a> · <span data-dl-size="mac">{macDownload?.size}</span></p>
      <p data-dl-meta="linux" class="hidden">Linux · {ui.dlArchLinux} · <a href="/voice/changelog/" title="See what's new in this version" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="linux">{linuxDownload?.version}</span></a> · <span data-dl-size="linux">{linuxDownload?.size}</span></p>
      <p data-dl-meta="windows" class="hidden">Windows 10 &amp; 11 · <a href="/voice/changelog/" title="See what's new in this version" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="windows-x64">{windowsDownload?.version}</span></a></p>
    </div>
  </section>

  <!-- What you get -->
  <section class="mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {highlights.map((h) => (
        <div class="rounded p-4 bg-gray-50 dark:bg-wk-surface flex items-start gap-3">
          <h.icon class="w-4 h-4 mt-0.5 shrink-0" style="color: #ff6d00" />
          <span class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">{h.text}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Getting set up -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Getting set up</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Installing on Windows -->
  <section id="windows" class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Installing on Windows</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-5">
      WaveKat Voice for Windows isn't code-signed yet, so the first time you run the installer
      Windows SmartScreen shows a blue "Windows protected your PC" box. The warning is about a
      certificate we haven't bought yet, not about the file — here's how to get past it.
    </p>
    <ol class="space-y-3 mb-5 max-w-xl">
      {windowsSteps.map((s, i) => (
        <li class="flex gap-3">
          <span
            class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold text-white"
            style="background-color: #ff6d00"
          >
            {i + 1}
          </span>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed pt-0.5">{s}</p>
        </li>
      ))}
    </ol>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Two installers, one choice: pick Intel or AMD unless your PC runs on a Snapdragon or another
      ARM chip. Windows tells you which you have under Settings → System → About → System type.
    </p>
  </section>

  <!-- What you'll need -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">What you'll need</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-3">
      An account with a phone provider — Twilio, Telnyx, 2talk, and more. It's the same login
      you'd use for any internet phone, and if you already make business calls online, your
      provider almost certainly works.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Not sure where to start? Our
      <a href="/docs/voice/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">setup guides</a>
      walk you through choosing a provider and getting your first call connected.
    </p>
  </section>

  <!-- Updates -->
  <section class="mb-4">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Staying up to date</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3">
      WaveKat Voice keeps itself up to date. Once installed, it quietly checks for new versions and
      updates in the background — you'll never have to come back here to download a newer one.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      <a href="/voice/changelog/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">See what's new in each release →</a>
    </p>
  </section>
</Voice>

<script is:inline>
  // Fire the Google Ads download conversion (label shares the AW account in
  // Base.astro). No-op if gtag isn't loaded.
  document.querySelectorAll('[data-conversion^="download_"]').forEach((el) => {
    el.addEventListener('click', () => {
      if (typeof gtag === 'function') {
        gtag('event', 'conversion', { send_to: 'AW-18128547216' });
      }
    });
  });
</script>
