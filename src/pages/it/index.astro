---
// Italian homepage. Mirrors src/pages/index.astro; body copy is
// translated, repo names/colors/links are shared. Locale, hreflang, the
// language switcher and localised header/footer are all derived from the /it/
// URL by Base/Header — this page just passes its Italian title/description.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AppScreenshot from '../../components/AppScreenshot.astro';
import { ArrowRight } from '@lucide/astro';

const voicePipeline = [
  {
    name: 'wavekat-vad',
    description: 'Rilevamento dell’attività vocale — WebRTC, Silero, TEN-VAD, FireRedVAD.',
    color: '#00bcd4',
    href: 'https://github.com/wavekat/wavekat-vad',
  },
  {
    name: 'wavekat-turn',
    description: 'Rilevamento del turno — capisce quando chi parla ha finito.',
    color: '#7c4dff',
    href: 'https://github.com/wavekat/wavekat-turn',
  },
  {
    name: 'wavekat-asr',
    description: 'Speech-to-text in streaming — interfaccia Rust unificata su più backend ASR.',
    color: '#f44336',
    href: 'https://github.com/wavekat/wavekat-asr',
  },
  {
    name: 'wavekat-tts',
    description: 'Sintesi text-to-speech — interfaccia Rust unificata per più backend TTS.',
    color: '#ff4081',
    href: 'https://github.com/wavekat/wavekat-tts',
  },
  {
    name: 'wavekat-core',
    description: 'Primitive audio condivise — AudioFrame, conversione del formato dei campioni.',
    color: '#00e676',
    href: 'https://github.com/wavekat/wavekat-core',
  },
  {
    name: 'wavekat-sip',
    description: 'Segnalazione SIP e trasporto RTP — REGISTER, INVITE, SDP, tracciamento dei dialoghi.',
    color: '#3f51b5',
    href: 'https://github.com/wavekat/wavekat-sip',
  },
];

const toolsAndClients = [
  {
    name: 'wavekat-lab',
    description: 'Dashboard interattiva per testare e confrontare i backend audio.',
    color: '#ffd740',
    href: 'https://github.com/wavekat/wavekat-lab',
  },
  {
    name: 'wavekat-cli',
    description: 'Client da riga di comando (wk) per la piattaforma WaveKat.',
    color: '#2196f3',
    href: 'https://github.com/wavekat/wavekat-cli',
  },
];
---

<Base
  title="WaveKat — strumenti vocali AI open source per le piccole imprese"
  description="WaveKat crea strumenti open source basati su AI che danno alle piccole imprese capacità un tempo riservate solo alle grandi aziende — a partire dalla voce: un’app desktop che trasforma il tuo computer in un telefono aziendale, registrando e trascrivendo ogni chiamata."
>
  <div class="max-w-3xl mx-auto px-6 py-12">

    <Header />

    <!-- Hero -->
    <section class="mb-20">
      <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
        Dai a ogni piccola impresa<br />la voce di una grande.
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-lg">
        WaveKat crea strumenti basati su AI che danno alle piccole imprese le capacità un tempo
        riservate solo alle grandi aziende. Iniziamo dalla voce — un’app desktop che trasforma il
        tuo computer nella tua linea aziendale, registrando e trascrivendo ogni chiamata.
      </p>
    </section>

    <!-- Featured product: WaveKat Voice -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">La nostra app</h2>
      <div
        class="relative overflow-hidden rounded-lg border p-6 dark:bg-wk-surface bg-gray-50"
        style="border-color: #ff6d0040"
      >
        <div
          class="pointer-events-none absolute -top-20 -right-16 w-72 h-72 rounded-full opacity-20 blur-3xl"
          style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
          aria-hidden="true"
        >
        </div>
        <div class="relative">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-sm font-bold" style="color: #ff6d00">WaveKat Voice</span>
            <span class="inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[9px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
              beta pubblica gratuita
            </span>
          </div>
          <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-lg">
            Un’app telefonica per il tuo computer. Rispondi ed effettua chiamate dal desktop, con ogni
            conversazione registrata e trascritta per te — usando l’operatore telefonico che hai già.
          </p>
          <a
            href="/it/voice/"
            class="group inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-xs font-bold text-white shadow-lg shadow-[#ff6d00]/20 transition-all hover:shadow-xl hover:shadow-[#ff6d00]/30 hover:-translate-y-0.5"
            style="background-color: #ff6d00"
          >
            Scopri di più e scarica
            <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>
      </div>
    </section>

    <!-- The app at rest: connected lines and recent calls -->
    <AppScreenshot scene="home" class="mb-16" />

    <!-- Libraries -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Librerie</h2>

      <h3 class="text-[11px] font-semibold tracking-wider text-gray-500 dark:text-gray-500 uppercase mb-3">Pipeline vocale</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {voicePipeline.map((lib) => (
          <a
            href={lib.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded border p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
            style={`border-color: ${lib.color}40`}
          >
            <span class="text-sm font-bold block mb-1.5" style={`color: ${lib.color}`}>{lib.name}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">{lib.description}</p>
            <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
              github.com/wavekat/{lib.name} →
            </span>
          </a>
        ))}
      </div>

      <h3 class="text-[11px] font-semibold tracking-wider text-gray-500 dark:text-gray-500 uppercase mb-3 mt-8">Strumenti e client</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {toolsAndClients.map((lib) => (
          <a
            href={lib.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block rounded border p-5 dark:bg-wk-surface bg-gray-50 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
            style={`border-color: ${lib.color}40`}
          >
            <span class="text-sm font-bold block mb-1.5" style={`color: ${lib.color}`}>{lib.name}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-4">{lib.description}</p>
            <span class="text-xs text-gray-400 dark:text-gray-600 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors">
              github.com/wavekat/{lib.name} →
            </span>
          </a>
        ))}
      </div>
    </section>

    <Footer />

  </div>
</Base>
