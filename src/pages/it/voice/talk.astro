---
import Voice from '../../../layouts/Voice.astro';
import { Mail } from '@lucide/astro';

const emailHref =
  "mailto:eason@wavekat.com?subject=wavekat-voice&body=Hi%20%E2%80%94%20a%20bit%20about%20my%20business%3A%0A%0A-%20What%20we%20do%3A%0A-%20How%20the%20phone%20works%20today%3A%0A-%20What's%20missing%20for%20you%3A%0A%0AThanks!";
---

<Voice
  title="Contattaci"
  description="Il modo migliore per raggiungere il team WaveKat è l’email — domande, suggerimenti o un dispositivo che vorresti vedere supportato."
>
  <section class="mb-12">
    <h1 class="text-2xl font-bold leading-snug mb-5 text-gray-900 dark:text-white">
      Contattaci
    </h1>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Ci piacerebbe sentirti — domande su WaveKat Voice, come funziona il telefono nella tua
      attività, cosa manca, o un dispositivo che vorresti vedere supportato.
    </p>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mt-3">
      L’email è il modo migliore per raggiungerci. Leggiamo ogni messaggio e rispondiamo il prima possibile.
    </p>
  </section>

  <section>
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Scrivici un’email</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-xl">
      C’è un breve modello già precompilato per aiutarti a iniziare — sentiti libero di ignorarlo e
      scrivere semplicemente qualche frase sulla tua attività.
    </p>
    <a
      href={emailHref}
      data-conversion="mailto_click"
      class="inline-flex items-center gap-2 rounded px-4 py-2.5 text-xs font-bold text-white transition-opacity hover:opacity-90"
      style="background-color: #ff6d00"
    >
      <Mail class="w-4 h-4" />
      Scrivici un’email
    </a>
    <p class="text-xs text-gray-400 dark:text-gray-600 mt-4 leading-relaxed">
      Oppure scrivi direttamente a{' '}
      <a
        href={emailHref}
        data-conversion="mailto_click"
        class="text-gray-600 dark:text-gray-300 underline underline-offset-2 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        eason@wavekat.com
      </a>{' '}
      .
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Non ancora pronto?</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-xl">
      Lasciaci la tua email e ti terremo aggiornato mentre WaveKat Voice prende forma — nuove
      funzionalità e quando arriverà su altri dispositivi.
    </p>
    <form
      action="https://buttondown.com/api/emails/embed-subscribe/wavekat"
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.com/wavekat', 'popupwindow')"
      class="flex flex-col sm:flex-row gap-2 max-w-xl"
    >
      <input type="hidden" name="tag" value="voice-interest" />
      <label for="talk-email" class="sr-only">Indirizzo email</label>
      <input
        type="email"
        name="email"
        id="talk-email"
        required
        placeholder="you@example.com"
        class="flex-1 min-w-0 rounded border border-gray-200 dark:border-white/10 bg-white dark:bg-black px-3 py-2 text-xs text-gray-900 dark:text-white placeholder:text-gray-400 dark:placeholder:text-gray-600 focus:outline-none focus:border-gray-400 dark:focus:border-white/30 transition-colors"
      />
      <button
        type="submit"
        class="rounded border border-gray-300 dark:border-white/20 bg-white dark:bg-black px-4 py-2 text-xs font-bold text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-[#0d1520] transition-colors"
      >
        Tienimi aggiornato
      </button>
    </form>
  </section>
</Voice>

<script is:inline>
  // Google Ads conversion label for an email click (matches TalkCTA.astro).
  const CONVERSIONS = {
    mailto_click: 'AW-18128547216/wIcbCOfc66QcEJDbrsRD',
  };

  function fireConversion(name) {
    const sendTo = CONVERSIONS[name];
    if (!sendTo || sendTo.includes('REPLACE_WITH_') || typeof gtag !== 'function') return;
    gtag('event', 'conversion', { send_to: sendTo });
  }

  document.querySelectorAll('a[data-conversion]').forEach((el) => {
    el.addEventListener('click', () => fireConversion(el.dataset.conversion));
  });
</script>
