---
// Italian version of the WaveKat Voice landing page. Mirrors
// src/pages/voice/index.astro section-for-section so the two never drift
// structurally. Body copy is translated here; the surrounding chrome (header
// nav, sub-nav, download control, talk CTA) is localised by the shared
// components via the URL-derived locale, so the page is fully Italian. hreflang
// and the language switcher are wired automatically in Base/Header from the
// route registry in src/lib/i18n.ts — this page declares no i18n props.
import Voice from '../../../layouts/Voice.astro';
import VoiceOverview from '../../../components/VoiceOverview.astro';
import {
  PhoneCall,
  PhoneForwarded,
  PhoneIncoming,
  MousePointerClick,
  AudioLines,
  Mic,
  FileText,
  Terminal,
  Server,
  Cloud,
  Languages,
  Lock,
} from '@lucide/astro';
import { getMacDownload, getLinuxDownload } from '../../../lib/voice-download';

const macDownload = await getMacDownload();
const linuxDownload = await getLinuxDownload();

// Locale code for the per-language app screenshots (/screenshots/<scene>/<code>.webp).
const imgCode = 'it';

// The three headline capabilities, each shown next to the screenshot that
// proves it. The rest of the features render as a grid below.
const spotlights = [
  {
    icon: PhoneIncoming,
    title: 'Risponde quando non puoi tu',
    body: 'Assegna un flusso di chiamata alla tua linea e WaveKat Voice risponde al posto tuo: saluto, orari, menu telefonico, segreteria o trasferimento. Il lavoro di un centralino automatico, sul tuo computer. Vedi ogni passo in diretta e puoi prendere la chiamata mentre lasciano il messaggio.',
    scene: 'flow-answering',
    alt: 'WaveKat Voice su Ubuntu — una chiamata a cui risponde un flusso: «Reception sta rispondendo», con «Sta registrando un messaggio…» e il nome di chi chiama.',
    link: { href: '/it/blog/answer-calls-with-a-call-flow/', label: 'Come funziona' },
  },
  {
    icon: PhoneForwarded,
    title: 'Metti in attesa, alterna e trasferisci',
    body: 'Metti un interlocutore in attesa, rispondi a una seconda linea e passa dall’una all’altra — poi trasferisci la chiamata subito oppure dopo esserti confrontato prima con un breve scambio. Ciò che accade durante l’attesa resta fuori dalla registrazione e dalla trascrizione.',
    scene: 'in-call-transfer',
    alt: 'WaveKat Voice sul desktop durante un trasferimento assistito — chi chiama è in attesa, accanto al pulsante Completa trasferimento.',
    link: { href: '/it/blog/hold-switch-and-transfer-calls/', label: 'Come funziona' },
  },
  {
    icon: Terminal,
    title: 'Lascia comporre a un assistente AI',
    body: 'Attiva l’automazione e uno strumento da riga di comando — o un assistente AI come Claude — può effettuare, attendere e terminare le chiamate per te. Lui guida il tastierino; a parlare sei tu. Disattivato finché non lo attivi.',
    scene: 'settings-automation-agents',
    alt: 'WaveKat Voice, Impostazioni → Automazione — collegamento di assistenti AI come Claude e Cursor con un pulsante Connetti con un clic.',
    link: { href: '/it/blog/place-calls-from-the-command-line/', label: 'Come funziona' },
  },
];

const features = [
  {
    icon: PhoneCall,
    title: 'Chiamate dal tuo desktop',
    body: 'Rispondi ed effettua chiamate direttamente dal computer — niente telefono da scrivania, niente hardware aggiuntivo, nessuna scheda del browser da tenere d’occhio. Resta tranquillo in disparte finché il telefono non squilla.',
  },
  {
    icon: Mic,
    title: 'Ogni chiamata registrata',
    body: 'Ogni conversazione viene registrata automaticamente e salvata nel momento in cui riagganci. Riascoltala quando ti serve — nessuna configurazione, niente da ricordarsi di attivare.',
  },
  {
    icon: FileText,
    title: 'Trascrizione in tempo reale',
    body: 'Vedi le parole mentre vengono pronunciate. Una trascrizione scorre accanto alla chiamata, così puoi cogliere ciò che conta invece di prendere appunti di fretta.',
  },
  {
    icon: AudioLines,
    title: 'Chiamate in HD',
    body: 'Quando il tuo operatore lo supporta, WaveKat Voice negozia il codec Opus per una voce a banda larga, nitida in HD — e torna da solo alla qualità standard quando non è possibile. Niente da attivare.',
  },
  {
    icon: MousePointerClick,
    title: 'Clicca un numero e chiama',
    body: 'Attiva i link telefonici e qualsiasi link tel: o sip: sul web apre WaveKat Voice con il numero già inserito, pronto perché tu prema Chiama. Disattivato di default: una pagina può chiedere una chiamata, mai farla.',
  },
  {
    icon: Server,
    title: 'Funziona con il tuo operatore',
    body: 'Porta l’operatore telefonico che già usi — Twilio, Telnyx, 2talk e altri. Scegli dall’elenco e la configurazione viene compilata per te.',
  },
  {
    icon: Cloud,
    title: 'Sincronizza se vuoi',
    body: 'Accedi al tuo account WaveKat e le tue registrazioni e trascrizioni si sincronizzano, così puoi rivederle sul web. Non accedere, e tutto resta semplicemente sul tuo computer.',
  },
  {
    icon: Languages,
    title: 'Parla la tua lingua',
    body: 'L’app segue la lingua del tuo computer e ne parla nove — inglese, spagnolo, francese, tedesco, italiano, giapponese, coreano e cinese sia semplificato che tradizionale. Cambiala quando vuoi nelle Impostazioni.',
  },
  {
    icon: Lock,
    title: 'Tuo per impostazione predefinita',
    body: 'Le tue chiamate, registrazioni e trascrizioni vivono prima di tutto sul tuo computer. Nulla viene caricato a meno che tu non lo scelga — nessuna azienda misteriosa tra te e i tuoi clienti.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Collega il tuo numero',
    body: 'Accedi al tuo operatore telefonico la prima volta che apri l’app. Scegli dall’elenco e le impostazioni vengono compilate per te.',
  },
  {
    n: '2',
    title: 'Rispondi alla chiamata',
    body: 'Un pallino verde significa che sei online e raggiungibile. Rispondi, componi, disattiva il microfono, usa il tastierino — tutto dal tuo desktop.',
  },
  {
    n: '3',
    title: 'Rivedila più tardi',
    body: 'Ogni chiamata finisce nella tua cronologia con la sua registrazione e trascrizione, pronta da rivedere o sincronizzare sul web.',
  },
];

const faqs = [
  {
    q: 'Che cos’è esattamente WaveKat Voice?',
    a: 'Un’app desktop che trasforma il tuo computer nel tuo telefono aziendale. Accedi con il tuo operatore telefonico e da quel momento puoi rispondere ed effettuare chiamate direttamente dal computer — con ogni chiamata registrata e trascritta per te.',
  },
  {
    q: 'Serve qualche hardware speciale?',
    a: 'No. Se hai un computer e un account con un operatore telefonico, hai tutto ciò che ti serve. Niente telefono da scrivania, nessuna attrezzatura extra — una cuffia è comoda ma non obbligatoria.',
  },
  {
    q: 'Posso mettere in attesa un interlocutore o trasferire una chiamata?',
    a: 'Sì. WaveKat Voice può mettere un interlocutore in attesa, rispondere a una seconda chiamata mentre la prima aspetta, alternare le chiamate e trasferire un interlocutore a qualcun altro — subito (trasferimento cieco) oppure dopo esserti confrontato prima con lui (trasferimento assistito). Mentre una chiamata è in attesa, la sua registrazione e la trascrizione in tempo reale si mettono in pausa da sole.',
    link: { href: '/it/blog/hold-switch-and-transfer-calls/', label: 'Come funziona' },
  },
  {
    q: 'WaveKat Voice può rispondere alle chiamate automaticamente?',
    a: 'Sì. Un flusso di chiamata risponde alle chiamate in arrivo con un saluto, un controllo dei tuoi orari, un menu telefonico, la segreteria o un trasferimento: il lavoro che gli altri sistemi telefonici chiamano centralino automatico. Costruisci il flusso sul web, lo assegni a una delle tue linee e l’app risponde con quello. Vedi ogni passo mentre accade e puoi prendere la chiamata mentre qualcuno lascia un messaggio.',
    link: { href: '/it/blog/answer-calls-with-a-call-flow/', label: 'Come funziona' },
  },
  {
    q: 'Posso cliccare un numero di telefono su un sito per chiamarlo?',
    a: 'Sì. Attiva i link telefonici in Impostazioni → Generali: da lì, cliccare un link tel: o sip: apre WaveKat Voice con il numero già nel campo di chiamata, pronto perché tu prema Chiama. Resta disattivato finché non lo attivi, e una pagina web può soltanto inserire il numero — non può mai effettuare la chiamata da sola.',
    link: { href: '/it/blog/click-to-call-phone-links/', label: 'Come funziona' },
  },
  {
    q: 'WaveKat Voice supporta l’audio in HD?',
    a: 'Sì. Quando il tuo operatore telefonico lo supporta, WaveKat Voice usa il codec Opus per una voce a banda larga — «HD» — più piena e nitida di una normale linea telefonica, e torna automaticamente alla qualità standard (G.711) quando non è possibile. Non c’è nulla da configurare.',
  },
  {
    q: 'Con quali operatori telefonici funziona?',
    a: 'Con la maggior parte di quelli comuni — Twilio, Telnyx, 2talk e altri. Compiliamo la configurazione per gli operatori che conosciamo; per gli altri puoi inserire i dettagli tu stesso. Se già effettui chiamate aziendali via internet, il tuo operatore quasi certamente funziona.',
  },
  {
    q: 'Dove vengono conservate le mie registrazioni e trascrizioni?',
    a: 'Sul tuo computer. Nulla viene caricato a meno che tu non lo decida. Se accedi a un account WaveKat, le tue registrazioni e trascrizioni possono sincronizzarsi, così puoi rivederle sul web — altrimenti non lasciano mai il tuo computer.',
  },
  {
    q: 'Un assistente AI può effettuare chiamate per me?',
    a: 'Sì. Attiva l’automazione in Impostazioni → Automazione e uno strumento da riga di comando — o un assistente AI collegato come Claude, Cursor o Windsurf — può effettuare, seguire e terminare le chiamate tramite l’app. L’assistente guida il tastierino; a parlare sei sempre tu. È disattivato per impostazione predefinita, e gli assistenti si collegano in un clic.',
    link: { href: '/it/blog/place-calls-from-the-command-line/', label: 'Come funziona' },
  },
  {
    q: 'In quali lingue è disponibile l’app?',
    a: 'Nove: inglese, spagnolo, francese, tedesco, italiano, giapponese, coreano e cinese sia semplificato che tradizionale. Segue automaticamente la lingua del tuo computer e puoi sceglierne un’altra quando vuoi nelle Impostazioni.',
  },
  {
    q: 'È gratuito?',
    a: 'È gratuito da usare durante la beta, mentre lo perfezioniamo insieme ad aziende reali. WaveKat Voice diventerà un prodotto a pagamento più avanti — gli utenti della beta riceveranno ampio preavviso prima che ciò cambi.',
  },
  {
    q: 'Su cosa gira?',
    a: `Mac e Linux. Su macOS gira sulla versione 12 e successive (${macDownload.arch}); su Linux è un pacchetto .deb per ${linuxDownload.arch}.`,
  },
  {
    q: 'Supporterete Windows o altri dispositivi?',
    a: 'WaveKat Voice oggi gira su Mac e Linux. Windows e altre piattaforme sono assolutamente sul tavolo — semplicemente le realizziamo quando c’è una richiesta reale. Quindi se useresti WaveKat Voice su Windows o altrove, faccelo sapere. Più persone lo chiedono, prima accade.',
    link: { href: '/it/voice/talk/', label: 'Dicci di cosa hai bisogno' },
  },
  {
    q: 'Rallenterà o interferirà con il mio computer?',
    a: 'È un’app desktop leggera che resta in disparte finché non arriva una chiamata e si aggiorna da sola, in silenzio, in background. La installi una volta e ti dimentichi che c’è.',
  },
];

// Localised structured data: same shape as the English page, but with the
// Italian URL and inLanguage so engines bind this variant to it.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WaveKat Voice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS, Linux',
  image: 'https://wavekat.com/og.png',
  url: 'https://wavekat.com/it/voice/',
  inLanguage: 'it',
  softwareVersion: macDownload.version,
  downloadUrl: 'https://wavekat.com/it/voice/download/',
  description:
    'Un’app desktop che trasforma il tuo computer nel tuo telefono aziendale — rispondi ed effettua chiamate, con ogni chiamata registrata e trascritta. Funziona con l’operatore telefonico che hai già.',
  featureList: [
    'Rispondere ed effettuare chiamate via SIP dal computer',
    'Flussi di chiamata: un centralino automatico con saluto, orari, menu telefonico, segreteria e trasferimento',
    'Attesa, avviso di chiamata e trasferimento cieco o assistito',
    'Registrazione automatica delle chiamate e trascrizione in diretta',
    'Click-to-call dai link tel: e sip: sul web',
    'Voce HD con il codec Opus quando l’operatore la supporta',
    'Riga di comando e automazione MCP per gli assistenti AI',
    'Nove lingue dell’app, su macOS e Linux',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'it',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Voice
  title="WaveKat Voice — il tuo telefono aziendale, sul tuo desktop"
  description="WaveKat Voice è un’app desktop per Mac e Linux che trasforma il tuo computer nel tuo telefono aziendale — rispondi ed effettua chiamate, con ogni chiamata registrata e trascritta per te. Beta pubblica gratuita."
>
  <VoiceOverview
    imgCode={imgCode}
    badge="beta pubblica gratuita"
    h1Lines={['La tua linea aziendale,', 'sul tuo desktop.']}
    h1Accent="Registrata e trascritta."
    intro="WaveKat Voice è un’app telefonica per il tuo computer. Collega l’operatore telefonico che già usi e rispondi ed effettua chiamate direttamente dal desktop — con ogni conversazione registrata e trascritta automaticamente per te, e nulla che lascia il tuo computer a meno che tu non lo voglia."
    installHref="/it/voice/download/"
    installLabel="Dettagli di installazione"
    changelogHref="/it/voice/changelog/"
    changelogTitle="Scopri le novità di questa versione"
    freeLabel="gratis durante la beta"
    heroAlt="WaveKat Voice sul desktop durante una chiamata dal vivo — il tastierino e i comandi di chiamata, con la trascrizione in tempo reale che scorre accanto."
    heroCaption="Una chiamata dal vivo — i comandi a sinistra, la trascrizione che si scrive da sola a destra."
    headingFeatures="Cosa fa"
    headingHow="Come funziona"
    headingWho="Per chi è"
    headingFaq="Domande e risposte"
    spotlights={spotlights}
    features={features}
    steps={steps}
    whoTitle="Attività che vivono al telefono"
    whoBody="Cliniche, saloni, artigiani, studi legali, ristoranti, amministratori di immobili — chiunque per cui una chiamata sia un cliente. Scopri dove si inserisce WaveKat Voice."
    whoHref="/it/voice/use-cases/"
    ctaTitle="Pronto a provarlo?"
    ctaBody="Gratis durante la beta pubblica. Installa in un minuto, collega il tuo numero e rispondi alla prossima chiamata dal tuo desktop."
    faqs={faqs}
    macDownload={macDownload}
    linuxDownload={linuxDownload}
  />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Voice>
