---
import Voice from '../../../layouts/Voice.astro';
import { PhoneCall, Mic, FileText } from '@lucide/astro';
import VoiceDownload from '../../../components/VoiceDownload.astro';
import { getDownload } from '../../../lib/voice-download';
import { resolveLocale, t } from '../../../lib/i18n';

const linuxDownload = await getDownload('linux-x64');

// Hardware requirements are localised chrome, not release data.
const ui = t(resolveLocale(Astro.url.pathname).code);

const steps = [
  {
    n: '1',
    title: 'Installalo',
    body: 'Su Mac, l’App Store installa WaveKat Voice al posto tuo e lo trovi nella cartella Applicazioni; su Windows fa lo stesso il Microsoft Store. Se hai scelto un download diretto, su Mac fai doppio clic sul .dmg e trascina WaveKat Voice nella cartella Applicazioni, oppure su Windows avvia il .exe. Su Linux, apri il .deb nel tuo gestore di software, oppure installalo da terminale con apt o dpkg.',
  },
  {
    n: '2',
    title: 'Avvialo',
    body: 'Apri WaveKat Voice una volta installato. Resta tranquillo in disparte, pronto ogni volta che il telefono squilla.',
  },
  {
    n: '3',
    title: 'Collega il tuo numero',
    body: 'Una breve configurazione ti guida nell’accesso al tuo operatore telefonico — scegli dall’elenco e al resto pensiamo noi.',
  },
];

// These steps are about the DIRECT .exe only. The Microsoft Store package
// is signed by Microsoft and installs without a warning, so a visitor who
// takes the button never sees any of this — it is here for the one who
// opens Other Platforms and takes the file instead. The download menu's
// "how to get past it" link points at #windows below, deliberately here
// and not at /docs/**, which is English-only.
const windowsSteps = [
  'Fai clic su «Ulteriori informazioni» nel riquadro di SmartScreen.',
  'Fai clic su «Esegui comunque», poi segui il programma di installazione.',
  'Fatto: Windows non lo chiederà più e da lì in poi gli aggiornamenti si installano da soli.',
];

const highlights = [
  { icon: PhoneCall, text: 'Effettua e rispondi alle chiamate dal tuo desktop' },
  { icon: Mic, text: 'Ogni chiamata registrata sul tuo computer' },
  { icon: FileText, text: 'Trascrizioni in tempo reale mentre parli' },
];
---

<Voice
  title="Scarica WaveKat Voice"
  description="Scarica WaveKat Voice per Mac, Windows o Linux — un’app telefonica che registra e trascrive ogni chiamata. Gratis durante la beta pubblica."
>
  <!-- Hero / download -->
  <section class="relative mb-16 pt-4">
    <!-- brand-orange glow -->
    <div
      class="pointer-events-none absolute -top-24 -left-24 w-[28rem] h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
      style="background: radial-gradient(circle, #ff6d00 0%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="flex items-center gap-2 mb-5">
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase" style="color: #ff6d00; border-color: #ff6d0040;">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background-color: #ff6d00"></span>
        beta pubblica gratuita
      </span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
      Scarica <span class="bg-gradient-to-r from-[#ff6d00] to-[#ffa14d] bg-clip-text text-transparent">WaveKat Voice</span>
    </h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
      La tua linea aziendale sul desktop — rispondi ed effettua chiamate, con ogni conversazione
      registrata e trascritta per te. Collega il tuo operatore telefonico e sei operativo in un paio di minuti.
    </p>

    <VoiceDownload />

    <div class="mt-4 text-xs text-gray-400 dark:text-gray-600">
      <p data-dl-meta="mac">macOS 12+ · {ui.dlArchMac} · Gratis su Mac App Store · <a href="/it/voice/changelog/" title="Scopri le novità di questa versione" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
      <p data-dl-meta="linux" class="hidden">Linux · <a href="/it/voice/changelog/" title="Scopri le novità di questa versione" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">v<span data-dl-version="linux">{linuxDownload?.version}</span></a> · <span data-dl-size="linux">{linuxDownload?.size}</span></p>
      <p data-dl-meta="windows" class="hidden">{ui.dlArchMsStore} · Gratis su Microsoft Store · <a href="/it/voice/changelog/" title="Scopri le novità di questa versione" class="underline underline-offset-2 hover:text-gray-600 dark:hover:text-gray-400 transition-colors">{ui.subChangelog}</a></p>
    </div>
  </section>

  <!-- What you get -->
  <section class="mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {highlights.map((h) => (
        <div class="rounded p-4 bg-gray-50 dark:bg-wk-surface flex items-start gap-3">
          <h.icon class="w-4 h-4 mt-0.5 shrink-0" style="color: #ff6d00" />
          <span class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">{h.text}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Getting set up -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Configurazione</h2>
    <ol class="space-y-4">
      {steps.map((s) => (
        <li class="flex gap-4">
          <span
            class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background-color: #ff6d00"
          >
            {s.n}
          </span>
          <div>
            <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Installing on Windows -->
  <section id="windows" class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Installazione su Windows</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-4">
      WaveKat Voice è su Microsoft Store per Windows 10 e 11, ed è il modo più semplice per installarlo: una sola scheda che copre sia i PC Intel e AMD sia i PC ARM, così è lo Store a consegnare al tuo computer la versione giusta e a tenerla aggiornata. Microsoft firma il pacchetto, quindi al primo avvio non compare alcun avviso di sicurezza.
    </p>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-5">
      I download diretti del .exe, in «Altre piattaforme», non sono ancora firmati, quindi al primo avvio di uno dei due Windows SmartScreen mostra il riquadro blu «PC protetto da Windows». L’avviso riguarda un certificato che non abbiamo ancora acquistato, non il file — ecco come procedere.
    </p>
    <ol class="space-y-3 mb-5 max-w-xl">
      {windowsSteps.map((s, i) => (
        <li class="flex gap-3">
          <span
            class="shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-[11px] font-bold text-white"
            style="background-color: #ff6d00"
          >
            {i + 1}
          </span>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed pt-0.5">{s}</p>
        </li>
      ))}
    </ol>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Entrambi i download diretti sono in «Altre piattaforme» e scegli tu: «Scarica per Windows» è la versione a 64 bit per i PC Intel e AMD, «Scarica per Windows su ARM» è la versione nativa per Snapdragon e altri processori ARM.
    </p>
  </section>

  <!-- What you'll need -->
  <section class="mb-16">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Cosa ti serve</h2>
    <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed max-w-xl mb-3">
      Un account con un operatore telefonico — Twilio, Telnyx, 2talk e altri. È lo stesso accesso
      che useresti per qualsiasi telefono via internet e, se già effettui chiamate aziendali online,
      il tuo operatore quasi certamente funziona.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      Non sai da dove iniziare? Le nostre
      <a href="/docs/voice/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">guide alla configurazione</a>
      ti accompagnano nella scelta di un operatore e nel collegare la tua prima chiamata.
    </p>
  </section>

  <!-- Updates -->
  <section class="mb-4">
    <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Restare aggiornato</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-3">
      WaveKat Voice si mantiene aggiornato da solo. Una copia dal Mac App Store o dal Microsoft Store si aggiorna
      come qualsiasi altra app di store; un download diretto controlla in silenzio la presenza di nuove versioni e si
      aggiorna in background. In entrambi i casi, non dovrai mai tornare qui per scaricarne una più recente.
    </p>
    <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl">
      <a href="/it/voice/changelog/" class="text-gray-900 dark:text-white underline underline-offset-2 hover:opacity-70 transition-opacity">Scopri le novità di ogni versione →</a>
    </p>
  </section>
</Voice>
