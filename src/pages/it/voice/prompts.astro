---
// Versione italiana della landing page SEO/GEO per il generatore gratuito di
// prompt vocali della piattaforma (lo strumento vero e proprio vive su
// platform.wavekat.com/voice/prompts, vedi wavekat-platform PR #161). È la
// porta d'ingresso marketing/answer-engine: spiega lo strumento, intercetta le
// ricerche del tipo «generatore vocale gratuito per IVR / menu telefonico» e
// rimanda all'app dal vivo. Volutamente NON usa il layout Voice — quella
// sezione è l'app desktop WaveKat Voice, un prodotto separato — quindi rende
// con la sola cornice Base, come la homepage.
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import {
  PhoneCall,
  ListOrdered,
  Voicemail,
  Clock,
  Music2,
  Sparkles,
  AudioLines,
  Languages,
  Download,
  Zap,
  ArrowRight,
  ArrowUpRight,
} from '@lucide/astro';

// Lo strumento dal vivo. Nessuno slash finale — combacia con il canonical e la
// sitemap della piattaforma (apps/web/public/sitemap.xml).
const APP_URL = 'https://platform.wavekat.com/voice/prompts';

const title = 'Voci per centralino e menu IVR gratis';
const description =
  'Crea gratis le voci del tuo centralino: messaggi di benvenuto, menu IVR, segreteria e annunci di attesa, nel formato che il tuo sistema telefonico richiede.';

// Ciò che le persone cercano davvero e vengono a creare. Ognuno è un compito
// concreto e citabile che il generatore svolge sull'audio telefonico.
const uses = [
  {
    icon: PhoneCall,
    title: 'Messaggi di benvenuto',
    body: '«Grazie per aver chiamato Acme Idraulica — come possiamo aiutarti?» Un saluto caloroso e coerente a ogni chiamata.',
  },
  {
    icon: ListOrdered,
    title: 'Menu IVR e centralino automatico',
    body: '«Per le vendite, premi 1. Per l\'assistenza, premi 2.» Registra ogni ramo del tuo menu telefonico con un\'unica voce.',
  },
  {
    icon: Voicemail,
    title: 'Messaggi di segreteria',
    body: 'Un messaggio professionale dopo il segnale acustico, per quando nessuno può rispondere.',
  },
  {
    icon: Clock,
    title: 'Messaggi fuori orario e festivi',
    body: '«I nostri uffici sono chiusi per le festività e riaprono lunedì alle 9.» Impostalo una volta, riproducilo quando ti serve.',
  },
  {
    icon: Music2,
    title: 'Annunci di attesa',
    body: 'Brevi avvisi parlati tra un brano e l\'altro della musica di attesa — orari di apertura, una promozione, un invito a farsi richiamare.',
  },
];

const features = [
  {
    icon: Sparkles,
    title: 'Voci AI di qualità da studio',
    body: 'Una selezione curata di voci text-to-speech commerciali, autorizzate per l\'uso telefonico. Scegline una e tutto il tuo sistema suonerà come registrato in studio.',
  },
  {
    icon: AudioLines,
    title: 'Audio pronto per la telefonia',
    body: 'Ogni clip esce nei formati attesi dai centralini — µ-law 8 kHz, WAV o MP3 — così si inserisce direttamente in Asterisk, FreePBX, 3CX, Twilio e simili, senza ricodifica.',
  },
  {
    icon: Zap,
    title: 'Gratis da provare, senza registrazione',
    body: 'Genera le tue prime clip direttamente nel browser — niente account, niente carta. Accedi con GitHub o Google quando vuoi continuare e salvare una libreria.',
  },
  {
    icon: Languages,
    title: 'Molte voci e lingue',
    body: 'Scegli tra una gamma di voci in più lingue, così il messaggio accoglie chi chiama nel modo in cui si aspetta di essere accolto.',
  },
  {
    icon: Download,
    title: 'Scarica e vai',
    body: 'I file si scaricano con un nome chiaro e descrittivo — pronti da caricare sul tuo centralino o da consegnare a chi lo gestisce.',
  },
  {
    icon: AudioLines,
    title: 'Coerente su ogni messaggio',
    body: 'Un\'unica voce per benvenuto, menu, segreteria e attesa fa sì che chi chiama percepisca un marchio unico e coerente — non un mosaico di registrazioni.',
  },
];

const steps = [
  {
    n: '1',
    title: 'Scrivi il tuo copione',
    body: 'Componi il messaggio di benvenuto, il menu o l\'annuncio — oppure parti da uno degli esempi integrati e modificalo.',
  },
  {
    n: '2',
    title: 'Scegli una voce',
    body: 'Scegli tra le voci curate e ascolta un\'anteprima di come suona il tuo testo. Cambiala quando vuoi.',
  },
  {
    n: '3',
    title: 'Scarica il file',
    body: 'Ottieni una clip pronta per la telefonia nel formato richiesto dal tuo centralino e caricala. Fatto.',
  },
];

const faqs = [
  {
    q: 'Che cos\'è il generatore di prompt vocali WaveKat?',
    a: 'È uno strumento web gratuito che trasforma il testo in audio pronto per la telefonia — messaggi di benvenuto, menu IVR e centralino automatico, messaggi di segreteria e annunci di attesa — pronunciati da voci AI di qualità da studio. Scrivi il copione, scegli una voce e scarichi un file che il tuo centralino può riprodurre.',
  },
  {
    q: 'È gratuito?',
    a: 'Sì. Puoi generare le tue prime clip nel browser gratuitamente, senza account. Accedendo con GitHub o Google si alza il limite e puoi salvare una libreria dei tuoi prompt; un uso più intenso viene conteggiato sugli stessi piani free e pro del resto della piattaforma WaveKat.',
  },
  {
    q: 'Quale formato audio ottengo e funzionerà con il mio centralino?',
    a: 'Le clip escono nei formati attesi dai centralini — µ-law 8 kHz, WAV e MP3 — così si inseriscono direttamente in sistemi come Asterisk, FreePBX, 3CX e Twilio senza alcuna ricodifica. Scegli il formato richiesto dal tuo sistema e carica il file.',
  },
  {
    q: 'Serve un account per provarlo?',
    a: 'No. Chiunque può generare un paio di clip senza registrarsi. Accedi solo quando vuoi continuare a generare oltre la soglia gratuita e salvare i tuoi prompt in una libreria a cui tornare.',
  },
  {
    q: 'Come creo le voci per il mio centralino?',
    a: 'Scrivi il testo di ogni messaggio che serve al tuo centralino — il benvenuto, il menu IVR, la segreteria, l\'annuncio di attesa. Scegli una voce e scarica ogni clip nel formato che il tuo sistema richiede. Carica i file sul centralino e li riprodurrà a chi chiama. Non c\'è nulla da installare e per iniziare non serve un account.',
  },
  {
    q: 'Serve un centralino per usare le clip?',
    a: 'No. Se ne hai già uno — Asterisk, FreePBX, 3CX, Twilio o una linea VoIP in cloud — scarica la clip e caricala lì. E se non ce l’hai, può riprodurle WaveKat Voice: un flusso di chiamata risponde alle chiamate in arrivo con un saluto, un menu telefonico e la segreteria, e questo stesso generatore dà voce a ogni passo in una volta sola.',
    link: { href: '/it/blog/answer-calls-with-a-call-flow/', label: 'Come funzionano i flussi' },
  },
  {
    q: 'In che cosa differisce da WaveKat Voice, l\'app?',
    a: 'WaveKat Voice è un\'app desktop che trasforma il tuo computer nel tuo telefono aziendale — rispondendo ed effettuando chiamate, registrate e trascritte. Il generatore di prompt vocali è uno strumento web gratuito separato che crea i messaggi e i menu registrati che il tuo centralino riproduce. Si completano a vicenda, ma puoi usare l\'uno o l\'altro anche da solo.',
    link: { href: '/it/voice/', label: 'Scopri WaveKat Voice' },
  },
];

// L'app stessa, per i rich result software e gli answer engine AI. `url` punta
// allo strumento dal vivo (in linea con la dichiarazione WebApplication della
// piattaforma), così gli engine legano un'unica entità a un unico URL canonico
// dell'app; questa pagina ne è la porta d'ingresso marketing, referenziata
// dall'Organization a livello di sito.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'WaveKat Voice Prompt Generator',
  url: APP_URL,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires a modern web browser',
  isAccessibleForFree: true,
  image: 'https://wavekat.com/og.png',
  inLanguage: 'it',
  description:
    'Uno strumento web gratuito che trasforma il testo in audio telefonico pronto all\'uso — messaggi di benvenuto, menu IVR e messaggi di segreteria — con voci AI di qualità da studio.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  publisher: { '@id': 'https://wavekat.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'it',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description}>
  <Header />

  <div class="max-w-4xl mx-auto px-6 pt-12 pb-12">
    <!-- Hero -->
    <section class="relative mb-20 pt-4">
      <!-- brand-orange glow -->
      <div
        class="pointer-events-none absolute -top-24 -left-24 w-72 h-72 sm:w-[28rem] sm:h-[28rem] rounded-full opacity-20 blur-3xl -z-10"
        style="background: radial-gradient(circle, var(--color-wk-orange) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <div class="flex items-center gap-2 mb-5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-wk-orange/25 px-2.5 py-1 text-[10px] font-bold tracking-wider uppercase text-wk-orange">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse bg-wk-orange"></span>
          gratis · nessuna registrazione per provare
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold leading-[1.15] tracking-tight mb-6 text-gray-900 dark:text-white">
        Voci gratis per il tuo<br />
        <span class="bg-gradient-to-r from-wk-orange to-[#ffa14d] bg-clip-text text-transparent">centralino telefonico.</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 leading-relaxed max-w-xl mb-8">
        Il generatore di prompt vocali WaveKat trasforma qualsiasi testo in audio pronto per la
        telefonia — messaggi di benvenuto, menu IVR, segreteria e annunci di attesa — pronunciati da
        voci AI di qualità da studio, esattamente nel formato richiesto dal tuo centralino. Provalo
        gratis nel browser; accedi per salvare una libreria.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href={APP_URL}
          class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
        >
          Provalo gratis
          <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
        <a
          href="#how"
          class="group inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
        >
          Scopri come funziona
          <ArrowRight class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <p class="mt-4 text-xs text-gray-400 dark:text-gray-600">
        Funziona su <span class="font-mono">platform.wavekat.com/voice/prompts</span> · nessun download, nessuna carta
      </p>
    </section>

    <!-- What you can make -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Cosa puoi creare</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {uses.map((u) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <u.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{u.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Features -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Perché usarlo</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <div class="group rounded-lg border border-gray-200 dark:border-white/10 p-5 bg-gray-50 dark:bg-wk-surface transition-all hover:-translate-y-0.5 hover:border-wk-orange/40 hover:shadow-lg hover:shadow-wk-orange/5">
            <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg mb-3 transition-colors bg-wk-orange/[0.08]">
              <f.icon class="w-4 h-4 text-wk-orange" />
            </span>
            <span class="text-sm font-bold block mb-1.5 text-gray-900 dark:text-white">{f.title}</span>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="mb-16 scroll-mt-24">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Come funziona</h2>
      <ol class="space-y-4">
        {steps.map((s) => (
          <li class="flex gap-4">
            <span
              class="shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold text-white bg-wk-orange"
            >
              {s.n}
            </span>
            <div>
              <span class="text-sm font-bold block mb-1 text-gray-900 dark:text-white">{s.title}</span>
              <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Try CTA -->
    <section class="mb-16">
      <div class="rounded p-6 bg-gray-50 dark:bg-wk-surface text-center">
        <h2 class="text-base font-bold mb-2 text-gray-900 dark:text-white">Crea subito il tuo primo prompt</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-5 max-w-md mx-auto">
          Gratis da provare nel browser — nessun download, nessun account. Scrivi una frase, scegli una
          voce e scarica una clip pronta per il telefono in meno di un minuto.
        </p>
        <div class="flex justify-center">
          <a
            href={APP_URL}
            class="group inline-flex items-center gap-2 rounded-full bg-wk-orange px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-wk-orange/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-wk-orange/40"
          >
            Apri il generatore di prompt vocali
            <ArrowUpRight class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>
      </div>
    </section>

    <!-- Q&A -->
    <section class="mb-16">
      <h2 class="text-xs font-bold tracking-widest text-gray-400 uppercase mb-5">Domande e risposte</h2>
      <div class="divide-y divide-gray-200 dark:divide-white/10 border-t border-b border-gray-200 dark:border-white/10">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 text-sm font-bold text-gray-900 dark:text-white hover:opacity-80 transition-opacity">
              {f.q}
              <span class="shrink-0 text-wk-orange transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed pb-4 -mt-1 max-w-xl">
              {f.a}
              {f.link && (
                <a
                  href={f.link.href}
                  class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
                >
                  {f.link.label}
                  <ArrowRight class="w-3 h-3" />
                </a>
              )}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- From the blog: the announcement post (the post links back here) -->
    <p class="text-xs text-gray-500 dark:text-gray-400">
      Vuoi saperne di più sullo strumento?
      <a
        href="/it/blog/phone-menu-ivr-voice-generator/"
        class="inline-flex items-center gap-1 font-bold whitespace-nowrap hover:opacity-70 transition-opacity text-wk-orange"
      >
        Leggi l’annuncio sul blog
        <ArrowRight class="w-3 h-3" />
      </a>
    </p>
  </div>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>
