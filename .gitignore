# Dependencies
node_modules/

# Build output
dist/
.astro/

# Generated from vendor/wavekat-brand submodule (run `make sync`)
/public/logos/
/public/og.png
/public/favicon.ico
/public/favicon-16x16.png
/public/favicon-32x32.png
/public/apple-touch-icon.png
/public/icon-192.png
/public/icon-512.png

# Typefaces the OG card renderer sets text in (run `make sync`) — ~16 MB of
# Inter + Noto Sans SC/TC/JP/KR, fetched rather than committed.
/vendor/fonts/

# Official Mac App Store / Microsoft Store badges (run `make sync`) — 36 SVGs,
# two variants × nine locales × two stores, fetched from Apple's and
# Microsoft's own endpoints. Not committed because the artwork is theirs and
# we may not alter it, so a checked-in copy is only a stale fork.
/public/badges/

# Synced from product repos by scripts/sync-docs.js
/src/content/docs/*
!/src/content/docs/.gitkeep
!/src/content/docs/README.md
/.sync-docs-tmp/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local state — session worktrees are git repos of their own, and
# settings.local.json is per-machine. Scoped, not the whole `.claude/`: shared
# project config (settings.json, agents/, skills/) is meant to be committed.
.claude/worktrees/
.claude/settings.local.json
